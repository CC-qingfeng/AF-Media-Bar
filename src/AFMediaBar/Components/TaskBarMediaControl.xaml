<UserControl x:Class="AFMediaBar.Components.TaskBarMediaControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:AFMediaBar.Components"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             FontFamily="{DynamicResource AppTextFontFamily}"
             FontWeight="{DynamicResource AppTextFontWeight}"
             TextOptions.TextRenderingMode="ClearType" TextOptions.TextFormattingMode="Ideal">

    <UserControl.Resources>
        <Style x:Key="TaskbarHoverButton" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Tag" Value="MediaAction" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                RenderTransformOrigin="0.5,0.5"
                                SnapsToDevicePixels="True">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#20FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#38FFFFFF" />
                                <Setter TargetName="ButtonSurface" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="Transparent" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.32" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TaskbarSpectrumBar" TargetType="Border">
            <Setter Property="Width" Value="2" />
            <Setter Property="Height" Value="21" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="CornerRadius" Value="1" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Background" Value="#DFFFFFFF" />
            <Setter Property="RenderTransformOrigin" Value="0.5,1" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleY="0.15" />
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Name="MainBorder" CornerRadius="6"
            ClipToBounds="True">
        <Grid Name="InteractionSurface" Background="#01000000"
              PreviewMouseWheel="InteractionSurface_PreviewMouseWheel">
            <Image x:Name="BackgroundImage" Stretch="UniformToFill" HorizontalAlignment="Center"
                   VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" Opacity="0.4">
                <Image.Effect>
                    <BlurEffect Radius="80" />
                </Image.Effect>
            </Image>
            <Border Name="TopBorder" BorderThickness="0,1.25,0,0" CornerRadius="5" Margin="0,0,0,1.25">
                <!-- 使用 Canvas 支持绝对定位，便于布局系统动态调整组件位置 -->
                <!-- Use Canvas for absolute positioning, allowing layout system to dynamically adjust component positions -->
                <Canvas Name="MainCanvas">

                    <!-- 封面组件 Artwork component -->
                    <Border Name="SongImageBorder" CornerRadius="5" ClipToBounds="True" Width="36" Height="36"
                            Panel.ZIndex="2" Cursor="Hand" Tag="MediaAction"
                            MouseEnter="SongImageBorder_MouseEnter"
                            MouseLeave="SongImageBorder_MouseLeave"
                            MouseLeftButtonUp="SongImageBorder_MouseLeftButtonUp">
                        <Grid>
                            <ui:SymbolIcon Name="SongImagePlaceholder" Symbol="MusicNote220" FontSize="24"
                                           Filled="True"
                                           Foreground="{DynamicResource MicaWPF.Brushes.SystemAccentColorTertiary}" />
                            <Border x:Name="SongImageHoverOverlay"
                                    CornerRadius="5"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0,1.25,0,0"
                                    IsHitTestVisible="False" />
                        </Grid>
                        <Border.Background>
                            <ImageBrush x:Name="SongImage" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>

                    <!-- 歌曲信息组件 Song info component -->
                    <StackPanel Name="SongInfoStackPanel" Orientation="Vertical"
                                Width="Auto"
                                Panel.ZIndex="3"
                                Background="Transparent"
                                MouseEnter="SongInfoStackPanel_MouseEnter"
                                MouseLeave="SongInfoStackPanel_MouseLeave"
                                ToolTipService.InitialShowDelay="800"
                                ToolTipService.Placement="RelativePoint"
                                ToolTipService.VerticalOffset="-16">
                        <Grid x:Name="SongInfoSurface"
                              Width="{Binding ElementName=SongInfoStackPanel, Path=Width}"
                              Height="{Binding ElementName=SongInfoStackPanel, Path=Height}">
                            <StackPanel x:Name="SongMetadataPanel">
                                <Canvas x:Name="SongTitleContainer" Height="19" ClipToBounds="True" Cursor="Hand" Tag="MediaAction"
                                        MouseLeftButtonUp="SongTitleContainer_MouseLeftButtonUp">
                                    <TextBlock x:Name="SongTitle" Text=""
                                               TextTrimming="CharacterEllipsis"
                                               FontFamily="{DynamicResource AppTextFontFamily}"
                                               FontWeight="{DynamicResource AppTextFontWeight}">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform />
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                </Canvas>
                                <Canvas x:Name="SongArtistContainer" Margin="0,-1.5,0,0" Height="19" ClipToBounds="True">
                                    <TextBlock x:Name="SongArtist" Text="" Opacity="0.5"
                                               TextTrimming="CharacterEllipsis"
                                               FontFamily="{DynamicResource AppTextFontFamily}"
                                               FontWeight="{DynamicResource AppTextFontWeight}">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform />
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                </Canvas>
                            </StackPanel>

                            <Grid x:Name="SongLyricsPanel" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border x:Name="SongLyricsContainer"
                                        Grid.Row="0"
                                        Grid.RowSpan="2"
                                        Height="19"
                                        ClipToBounds="True"
                                        VerticalAlignment="Center"
                                        Cursor="Hand"
                                        Tag="MediaAction"
                                        MouseLeftButtonUp="SongTitleContainer_MouseLeftButtonUp">
                                    <TextBlock x:Name="SongLyrics"
                                               Text=""
                                               HorizontalAlignment="Stretch"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               FontFamily="{DynamicResource AppTextFontFamily}"
                                               FontWeight="{DynamicResource AppTextFontWeight}">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform />
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                </Border>
                                <Border x:Name="SongLyricsSecondaryContainer"
                                        Grid.Row="1"
                                        Height="{Binding ElementName=SongLyricsContainer, Path=Height}"
                                        ClipToBounds="True"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed"
                                        Cursor="Hand"
                                        Tag="MediaAction"
                                        MouseLeftButtonUp="SongTitleContainer_MouseLeftButtonUp">
                                    <TextBlock x:Name="SongLyricsSecondary"
                                               Text=""
                                               HorizontalAlignment="Stretch"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               FontFamily="{DynamicResource AppTextFontFamily}"
                                               FontWeight="{DynamicResource AppTextFontWeight}"
                                               FontSize="{Binding ElementName=SongLyrics, Path=FontSize}"
                                               Opacity="0.68">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform />
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </Grid>
                    </StackPanel>

                    <Border x:Name="SongInfoHoverOverlay"
                            Panel.ZIndex="2"
                            CornerRadius="5"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0,1.25,0,0"
                            IsHitTestVisible="False" />

                </Canvas>
            </Border>

            <!-- 仅用于横向任务栏静置层；原始 Canvas 仍是唯一的封面和文字布局。 -->
            <!-- Horizontal-taskbar rest adorners; the original Canvas remains the sole artwork/text layout. -->
            <ProgressBar x:Name="TaskbarRestProgress"
                         Panel.ZIndex="3"
                         Height="2"
                         Margin="52,0,46,1"
                         VerticalAlignment="Bottom"
                         Minimum="0"
                         Maximum="1"
                         Visibility="Collapsed"
                         IsHitTestVisible="False"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="#FF75B9" />
            <Border x:Name="TaskbarSpectrumHoverSurface"
                    Panel.ZIndex="4"
                    Width="38"
                    Height="32"
                    Margin="0,0,4,0"
                    Padding="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    CornerRadius="5"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0,1.25,0,0"
                    Visibility="Collapsed"
                    MouseEnter="TaskbarSpectrumHoverSurface_MouseEnter"
                    MouseLeave="TaskbarSpectrumHoverSurface_MouseLeave">
                <StackPanel x:Name="TaskbarSpectrum"
                            Width="36"
                            Height="22"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            IsHitTestVisible="False">
                    <Border Style="{StaticResource TaskbarSpectrumBar}" />
                    <Border Style="{StaticResource TaskbarSpectrumBar}" />
                    <Border Style="{StaticResource TaskbarSpectrumBar}" />
                    <Border Style="{StaticResource TaskbarSpectrumBar}" />
                    <Border Style="{StaticResource TaskbarSpectrumBar}" />
                    <Border Style="{StaticResource TaskbarSpectrumBar}" />
                    <Border Style="{StaticResource TaskbarSpectrumBar}" />
                    <Border Style="{StaticResource TaskbarSpectrumBar}" />
                    <Border Style="{StaticResource TaskbarSpectrumBar}" />
                </StackPanel>
            </Border>
            <Border x:Name="TaskbarPerformanceSurface"
                    Panel.ZIndex="4" Width="74" Height="24" Margin="0,0,4,0"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    CornerRadius="12" Background="#16000000"
                    Cursor="Arrow" Visibility="Collapsed"
                    MouseLeftButtonUp="TaskbarPerformanceSurface_MouseLeftButtonUp">
                <TextBlock x:Name="TaskbarPerformanceText" Text="MEM —" FontSize="11"
                           FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" IsHitTestVisible="False"/>
            </Border>

            <!-- 悬停层只覆盖中间文字区域，不替换或重新排列下方静置层。 -->
            <!-- The hover layer covers only the middle text region without replacing the rest layer below it. -->
            <Grid x:Name="HoverRevealHost"
                  Panel.ZIndex="6"
                  Width="0"
                  Height="42"
                  Margin="52,1,0,1"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Center"
                  ClipToBounds="True"
                  Visibility="Collapsed"
                  IsHitTestVisible="False"
                  MouseEnter="TaskbarHoverLayer_MouseEnter"
                  MouseLeave="TaskbarHoverLayer_MouseLeave">
                <Grid.Clip>
                    <RectangleGeometry x:Name="HoverRevealClip" Rect="0,0,0,42" />
                </Grid.Clip>
                <Border x:Name="TaskbarHoverLayer"
                        Width="276"
                        Height="40"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        CornerRadius="5"
                        ClipToBounds="True">
                    <Grid>
                        <Grid Margin="5,5,6,3">
                            <StackPanel x:Name="TaskbarHoverActions"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                <StackPanel x:Name="TaskbarTransportButtons" Orientation="Horizontal">
                                    <Button x:Name="TaskbarPreviousButton"
                                            Style="{StaticResource TaskbarHoverButton}"
                                            ToolTip="上一首"
                                            Click="TaskbarPreviousButton_Click">
                                        <ui:SymbolIcon Symbol="Previous24" FontSize="14" />
                                    </Button>
                                    <Button x:Name="TaskbarPlayPauseButton"
                                            Style="{StaticResource TaskbarHoverButton}"
                                            ToolTip="播放 / 暂停"
                                            Click="TaskbarPlayPauseButton_Click">
                                        <ui:SymbolIcon x:Name="TaskbarPlayPauseIcon" Symbol="Play24" FontSize="14" />
                                    </Button>
                                    <Button x:Name="TaskbarNextButton"
                                            Style="{StaticResource TaskbarHoverButton}"
                                            ToolTip="下一首"
                                            Click="TaskbarNextButton_Click">
                                        <ui:SymbolIcon Symbol="Next24" FontSize="14" />
                                    </Button>
                                </StackPanel>
                                <Button x:Name="TaskbarDeviceButton"
                                        Style="{StaticResource TaskbarHoverButton}"
                                        Margin="4,0,1,0"
                                        ToolTip="切换输出设备"
                                        Click="TaskbarDeviceButton_Click"
                                        PreviewMouseWheel="TaskbarDeviceButton_PreviewMouseWheel">
                                    <TextBlock Text="&#xE7F5;" FontFamily="{DynamicResource AppIconFontFamily}" FontSize="14" />
                                </Button>
                                <Button x:Name="TaskbarVolumeButton"
                                        Style="{StaticResource TaskbarHoverButton}"
                                        ToolTip="当前应用音量 / 音量合成器"
                                        Click="TaskbarVolumeButton_Click"
                                        PreviewMouseWheel="TaskbarVolumeButton_PreviewMouseWheel">
                                    <TextBlock Text="&#xE767;" FontFamily="{DynamicResource AppIconFontFamily}" FontSize="14" />
                                </Button>
                                <Slider x:Name="TaskbarHoverProgress"
                                        Width="96"
                                        Height="20"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Minimum="0"
                                        Maximum="1"
                                        Tag="MediaAction"
                                        FocusVisualStyle="{DynamicResource AfFocusVisualStyle}"
                                        IsMoveToPointEnabled="True"
                                        PreviewMouseLeftButtonDown="TaskbarHoverProgress_PreviewMouseLeftButtonDown"
                                        PreviewMouseLeftButtonUp="TaskbarHoverProgress_PreviewMouseLeftButtonUp"
                                        LostMouseCapture="TaskbarHoverProgress_LostMouseCapture" />
                            </StackPanel>
                            <Button x:Name="TaskbarFullPanelHandle"
                                    Width="44"
                                    Height="8"
                                    Padding="0"
                                    Margin="0,-5,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Tag="MediaAction"
                                    ToolTip="打开完整面板"
                                    Click="TaskbarFullPanelHandle_Click">
                                <Border Width="28" Height="4" CornerRadius="2" Background="#B8FFFFFF" />
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- 关闭悬停层但保留完整层时，在文字区顶部提供同款拉杆入口。 -->
            <!-- When Hover is disabled but Full remains enabled, expose the same pull handle over the text region. -->
            <Button x:Name="TaskbarDirectFullPanelHandle"
                    Panel.ZIndex="7"
                    Width="0"
                    Height="8"
                    Padding="0"
                    Margin="52,1,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    BorderThickness="0"
                    Opacity="0"
                    Visibility="Collapsed"
                    Tag="MediaAction"
                    ToolTip="打开完整面板"
                    MouseEnter="TaskbarDirectFullPanelHandle_MouseEnter"
                    MouseLeave="TaskbarDirectFullPanelHandle_MouseLeave"
                    Click="TaskbarFullPanelHandle_Click">
                <Border Width="28" Height="4" CornerRadius="2" Background="#B8FFFFFF" />
            </Button>

            <Popup x:Name="QuickLaunchPopup" PlacementTarget="{Binding ElementName=SongImageBorder}"
                   Placement="Top" VerticalOffset="-7" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
                <Border MinWidth="220" MaxWidth="320" MaxHeight="330" Margin="4" Padding="10" CornerRadius="10"
                        Background="{DynamicResource AppMenuBackgroundBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                        Effect="{DynamicResource AfFlyoutShadowEffect}">
                    <StackPanel><TextBlock Text="快速启动" Margin="4,2,4,6" FontWeight="SemiBold"/>
                        <TextBlock x:Name="QuickLaunchStatusText" Margin="4,0,4,4" FontSize="12" Opacity="0.72" TextWrapping="Wrap" Visibility="Collapsed"/>
                        <TextBlock x:Name="QuickLaunchEmptyText" Text="尚未添加应用，请在额外功能中添加。" Margin="4,6" FontSize="12" Opacity="0.62" TextWrapping="Wrap"/>
                        <ItemsControl x:Name="QuickLaunchList"><ItemsControl.ItemTemplate><DataTemplate><Button HorizontalContentAlignment="Stretch" Padding="8,6" Margin="0,1" BorderThickness="0" Background="Transparent" Click="QuickLaunchItem_Click"><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <ui:Button x:Name="OpenExtraFeaturesButton" Content="打开额外功能设置" Margin="0,6,0,0" Click="OpenExtraFeaturesButton_Click"/>
                    </StackPanel>
                </Border>
            </Popup>

            <Popup x:Name="OutputDevicePopup" PlacementTarget="{Binding ElementName=TaskbarDeviceButton}"
                   Placement="Top" VerticalOffset="-7" AllowsTransparency="True" StaysOpen="True" PopupAnimation="Fade"
                   PreviewMouseWheel="OutputDevicePopup_PreviewMouseWheel" Closed="TransientPopup_Closed">
                <Border Width="268" MaxHeight="360" Margin="4" Padding="10" CornerRadius="10"
                        Background="{DynamicResource AppMenuBackgroundBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                        Effect="{DynamicResource AfFlyoutShadowEffect}">
                    <StackPanel><TextBlock Text="输出设备" Margin="4,2,4,7" FontWeight="SemiBold"/>
                        <ListBox x:Name="OutputDeviceList" MaxHeight="300" DisplayMemberPath="DisplayName" SelectionChanged="OutputDeviceList_SelectionChanged"/>
                    </StackPanel>
                </Border>
            </Popup>

            <Popup x:Name="VolumePopup" PlacementTarget="{Binding ElementName=TaskbarVolumeButton}"
                   Placement="Top" VerticalOffset="-7" AllowsTransparency="True" StaysOpen="True" PopupAnimation="Fade"
                   PreviewMouseWheel="VolumePopup_PreviewMouseWheel" Closed="TransientPopup_Closed">
                <Border Width="110" Height="230" Margin="4" Padding="10" CornerRadius="10"
                        Background="{DynamicResource AppMenuBackgroundBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                        Effect="{DynamicResource AfFlyoutShadowEffect}">
                    <StackPanel HorizontalAlignment="Center"><TextBlock x:Name="VolumeSourceText" Width="88" Text="当前媒体" TextAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="11"/>
                        <TextBlock x:Name="VolumePercentText" Text="不可用" Margin="0,4,0,6" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                        <Slider x:Name="TaskbarVolumeSlider" Orientation="Vertical" Height="155" Minimum="0" Maximum="100" SmallChange="2" LargeChange="10" IsDirectionReversed="False" ValueChanged="TaskbarVolumeSlider_ValueChanged"/>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Border>
</UserControl>
