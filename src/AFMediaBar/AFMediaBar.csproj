<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      目标框架只决定编译期可用的 API 面与 SupportedOSPlatform 元数据，不决定程序能在哪些系统上启动：
      运行下限是 Windows 10 1809（17763，由 app.manifest 与安装程序的 MinVersion 声明），本项目用到的每个系统接口
      在该版本上都已经可用。这里取 19041 是为了拿到较新的 SDK 投影（任务栏与 DWM 相关声明）。
      另见 README「系统要求」：.NET 10 官方只支持 Windows 10 的长期服务版与企业版（1809 E、21H2 E）。
      The target framework decides which APIs are available at compile time and what SupportedOSPlatform metadata says; it does not
      decide where the app can start. The runtime floor is Windows 10 1809 (17763, declared by app.manifest and the installer's
      MinVersion), where every system interface used here already exists. 19041 is chosen for the newer SDK projections used by the
      taskbar and DWM declarations. See the README's requirements section: .NET 10 officially supports only the Windows 10 LTSC and
      Enterprise editions (1809 E, 21H2 E).
    -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>wpfui-icon.ico</ApplicationIcon>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!--
      Version 是版本号的唯一来源：运行期从程序集版本读取并显示，安装程序与发布工作流用
      `dotnet msbuild -getProperty:Version` 读取同一个值，发布标签必须与它一致。
      Version is the single source of the version number: the running app reads and displays it from
      the assembly version, while the installer script and the release workflow read the same value
      through `dotnet msbuild -getProperty:Version`, and the release tag must match it.
    -->
    <AssemblyName>AFMediaBar</AssemblyName>
    <RootNamespace>AFMediaBar</RootNamespace>
    <AssemblyTitle>AF Media Bar</AssemblyTitle>
    <Product>AF Media Bar</Product>
    <Description>Media control and minor beautification software for Windows 10/11 desktops.</Description>
    <Version>1.2.0</Version>
    <Authors>AmorFate</Authors>
    <Copyright>Copyright (c) 2026 AmorFate</Copyright>
    <RepositoryUrl>https://github.com/Fervent-Tempo/AF-Media-Bar</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

<PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(RuntimeIdentifier)' == 'win-x64'">
  <PublishSingleFile>true</PublishSingleFile>
  <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  <DebugType>None</DebugType>
  <DebugSymbols>false</DebugSymbols>
</PropertyGroup>

  <ItemGroup>
    <Content Include="wpfui-icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dubya.WindowsMediaController" Version="2.5.6" />
    <PackageReference Include="Lyricify.Lyrics.Helper" Version="0.2.0" />
    <PackageReference Include="MicaWPF" Version="7.1.0" />
    <PackageReference Include="WPF-UI" Version="4.2.0" />
    <PackageReference Include="WPF-UI.DependencyInjection" Version="4.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0 " />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\wpfui-icon-256.png" />
    <None Remove="Assets\wpfui-icon-1024.png" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\wpfui-icon-256.png" />
    <Resource Include="Assets\wpfui-icon-1024.png" />
  </ItemGroup>

</Project>
