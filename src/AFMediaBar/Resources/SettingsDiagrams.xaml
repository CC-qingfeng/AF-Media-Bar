<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!--
        设置页矢量说明图 / Settings vector diagrams

        这些模板只解释既有设置的作用，不引入新的选项或状态。所有颜色都取自主题画刷，
        因此浅色、深色、高对比度和系统主色变化都不需要额外处理，也没有硬编码色值。
        用法 / Usage:
            <ContentControl ContentTemplate="{StaticResource AfDiagramTaskbarLayers}" />

        These templates only explain existing settings; they add no options and hold no state.
        Every colour comes from a theme brush, so light, dark, high contrast, and accent changes
        need no extra handling and no colour value is hardcoded.
    -->

    <!--  共享画笔 / Shared strokes  -->
    <Style x:Key="AfDiagramLabelStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="AfDiagramSurfaceStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!--  1. 应用生命周期 / Application lifecycle  -->
    <DataTemplate x:Key="AfDiagramLifecycle">
        <StackPanel Margin="0,2,0,2">
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource AfDiagramSurfaceStyle}" Padding="9,6">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon FontSize="14" Symbol="Globe24" />
                        <TextBlock Margin="6,0,0,0" Style="{StaticResource AfDiagramLabelStyle}" Text="登录 Windows" />
                    </StackPanel>
                </Border>
                <ui:SymbolIcon Margin="8,0" FontSize="12" Symbol="ChevronRight24" />
                <Border Style="{StaticResource AfDiagramSurfaceStyle}" Padding="9,6">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon FontSize="14" Symbol="ShareScreenStart24" />
                        <TextBlock Margin="6,0,0,0" Style="{StaticResource AfDiagramLabelStyle}" Text="自动启动（预留）" />
                    </StackPanel>
                </Border>
                <ui:SymbolIcon Margin="8,0" FontSize="12" Symbol="ChevronRight24" />
                <Border Style="{StaticResource AfDiagramSurfaceStyle}" Padding="9,6">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon FontSize="14" Symbol="Apps24" />
                        <TextBlock Margin="6,0,0,0" Style="{StaticResource AfDiagramLabelStyle}" Text="托盘常驻" />
                    </StackPanel>
                </Border>
                <ui:SymbolIcon Margin="8,0" FontSize="12" Symbol="ChevronRight24" />
                <Border
                    Padding="9,6"
                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon FontSize="14" Symbol="Dismiss24" />
                        <TextBlock Margin="6,0,0,0" Style="{StaticResource AfDiagramLabelStyle}" Text="退出并释放资源" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!--  2. 任务栏三层体验 / Taskbar three layers  -->
    <DataTemplate x:Key="AfDiagramTaskbarLayers">
        <StackPanel>
            <Border
                Style="{StaticResource AfDiagramSurfaceStyle}"
                Margin="0,0,0,6"
                Padding="10,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource AfDiagramLabelStyle}" Text="静置" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Border
                            Width="18"
                            Height="18"
                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                            CornerRadius="4"
                            Opacity="0.75" />
                        <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                            <Border
                                Width="86"
                                Height="5"
                                Background="{DynamicResource TextFillColorSecondaryBrush}"
                                CornerRadius="2"
                                Opacity="0.75" />
                            <Border
                                Width="56"
                                Height="4"
                                Margin="0,4,0,0"
                                Background="{DynamicResource TextFillColorTertiaryBrush}"
                                CornerRadius="2" />
                        </StackPanel>
                        <StackPanel
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Border Width="3" Height="8" Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="1" />
                            <Border Width="3" Height="14" Margin="3,0,0,0" Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="1" />
                            <Border Width="3" Height="11" Margin="3,0,0,0" Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="1" />
                            <Border Width="3" Height="6" Margin="3,0,0,0" Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="1" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
            <Border
                Style="{StaticResource AfDiagramSurfaceStyle}"
                Margin="0,0,0,6"
                Padding="10,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource AfDiagramLabelStyle}" Text="悬停" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Border Width="18" Height="18" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="9" />
                        <Border
                            Width="18"
                            Height="18"
                            Margin="6,0,0,0"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="9" />
                        <Border
                            Width="18"
                            Height="18"
                            Margin="6,0,0,0"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="9" />
                        <Border
                            Width="64"
                            Height="18"
                            Margin="8,0,0,0"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="9" />
                        <Border
                            Width="10"
                            Height="10"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                            CornerRadius="5" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource AfDiagramSurfaceStyle}" Padding="10,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource AfDiagramLabelStyle}" Text="完整" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Border Width="46" Height="26" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" />
                        <Border
                            Width="46"
                            Height="26"
                            Margin="6,0,0,0"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="4" />
                        <Border
                            Width="46"
                            Height="26"
                            Margin="6,0,0,0"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="4" />
                        <Border
                            Width="46"
                            Height="26"
                            Margin="6,0,0,0"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="4" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </DataTemplate>

    <!--  3. 任务栏位置与避让 / Taskbar placement and avoidance  -->
    <DataTemplate x:Key="AfDiagramTaskbarPlacement">
        <Border
            Style="{StaticResource AfDiagramSurfaceStyle}"
            Padding="10,8">
            <StackPanel>
                <Grid Height="44">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!--  任务栏图标避让区 / Reserved taskbar icon strip  -->
                    <StackPanel VerticalAlignment="Bottom" Orientation="Horizontal">
                        <Border Width="10" Height="10" Background="{DynamicResource TextFillColorTertiaryBrush}" CornerRadius="2" />
                        <Border Width="10" Height="10" Margin="5,0,0,0" Background="{DynamicResource TextFillColorTertiaryBrush}" CornerRadius="2" />
                        <Border Width="10" Height="10" Margin="5,0,0,0" Background="{DynamicResource TextFillColorTertiaryBrush}" CornerRadius="2" />
                    </StackPanel>
                    <!--  媒体栏 / Media bar segment  -->
                    <Border
                        Grid.Column="1"
                        Width="150"
                        Height="20"
                        Margin="26,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                        CornerRadius="4"
                        Opacity="0.8" />
                </Grid>
                <!--  任务栏底线与边缘偏移刻度 / Taskbar baseline and cross-axis offset scale  -->
                <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <Grid Margin="0,6,0,0">
                    <TextBlock Style="{StaticResource AfDiagramLabelStyle}" Text="图标避让区" />
                    <TextBlock
                        HorizontalAlignment="Right"
                        Style="{StaticResource AfDiagramLabelStyle}"
                        Text="边缘偏移 ±20 DIP" />
                </Grid>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!--  4. 固定长度安全区间 / Fixed length safe range  -->
    <DataTemplate x:Key="AfDiagramTaskbarLength">
        <Border
            Style="{StaticResource AfDiagramSurfaceStyle}"
            Padding="10,8">
            <StackPanel>
                <Grid Height="22">
                    <Border
                        Height="8"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="4" />
                    <Border
                        Height="8"
                        Margin="60,0,60,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                        CornerRadius="4"
                        Opacity="0.8" />
                    <Border
                        Width="3"
                        Height="22"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource TextFillColorTertiaryBrush}"
                        CornerRadius="2" />
                    <Border
                        Width="3"
                        Height="22"
                        HorizontalAlignment="Right"
                        Background="{DynamicResource TextFillColorTertiaryBrush}"
                        CornerRadius="2" />
                </Grid>
                <Grid Margin="0,6,0,0">
                    <TextBlock Style="{StaticResource AfDiagramLabelStyle}" Text="悬停层最小长度" />
                    <TextBlock
                        HorizontalAlignment="Right"
                        Style="{StaticResource AfDiagramLabelStyle}"
                        Text="任务栏安全上限" />
                </Grid>
                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                    <ui:SymbolIcon FontSize="12" Symbol="TextAlignJustify24" />
                    <TextBlock Margin="6,0,0,0" Style="{StaticResource AfDiagramLabelStyle}" Text="跟随媒体文字长度时不写入设置文件" />
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!--  5. 鼠标点击区域与共享修饰键 / Mouse click zones and shared modifier  -->
    <DataTemplate x:Key="AfDiagramInputGestures">
        <Border
            Style="{StaticResource AfDiagramSurfaceStyle}"
            Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!--  鼠标正面示意 / Mouse front view  -->
                <Grid Width="26" Height="40">
                    <Border
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12" />
                    <Border
                        Width="10"
                        Height="12"
                        Margin="0,4,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                        CornerRadius="5"
                        Opacity="0.85" />
                    <Border
                        Width="1"
                        Height="12"
                        Margin="0,4,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
                </Grid>
                <StackPanel
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource AfDiagramLabelStyle}" Text="左键 / 右键 / Shift" />
                    <TextBlock
                        Margin="0,3,0,0"
                        Style="{StaticResource AfDiagramLabelStyle}"
                        Text="组合滚轮共用" />
                </StackPanel>
                <StackPanel
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
                    <Border
                        Padding="8,4"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="4">
                        <TextBlock Style="{StaticResource AfDiagramLabelStyle}" Text="点击封面" />
                    </Border>
                    <Border
                        Margin="0,6,0,0"
                        Padding="8,4"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="4">
                        <TextBlock Style="{StaticResource AfDiagramLabelStyle}" Text="点击标题或歌词" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!--  6. 滚轮手势 / Wheel gestures  -->
    <DataTemplate x:Key="AfDiagramWheelGestures">
        <Border
            Style="{StaticResource AfDiagramSurfaceStyle}"
            Padding="12,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource AfDiagramLabelStyle}" Text="向上" />
                <ui:SymbolIcon
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    FontSize="14"
                    Symbol="ArrowUp24" />
                <Border
                    Grid.Column="2"
                    Margin="14,0,0,0"
                    Padding="8,4"
                    HorizontalAlignment="Right"
                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="4">
                    <TextBlock Style="{StaticResource AfDiagramLabelStyle}" Text="上一项 / 增大" />
                </Border>
                <TextBlock
                    Grid.Row="1"
                    Margin="0,8,0,0"
                    Style="{StaticResource AfDiagramLabelStyle}"
                    Text="向下" />
                <ui:SymbolIcon
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="8,8,0,0"
                    FontSize="14"
                    Symbol="ArrowDown24" />
                <Border
                    Grid.Row="1"
                    Grid.Column="2"
                    Margin="14,8,0,0"
                    Padding="8,4"
                    HorizontalAlignment="Right"
                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="4">
                    <TextBlock Style="{StaticResource AfDiagramLabelStyle}" Text="下一项 / 减小" />
                </Border>
            </Grid>
        </Border>
    </DataTemplate>

    <!--  7. 托盘溢出区 / Tray overflow  -->
    <DataTemplate x:Key="AfDiagramTrayOverflow">
        <Border
            Style="{StaticResource AfDiagramSurfaceStyle}"
            Padding="12,10">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource AfDiagramLabelStyle}" Text="任务栏托盘区" />
                    <TextBlock
                        Grid.Column="1"
                        Style="{StaticResource AfDiagramLabelStyle}"
                        Text="溢出区" />
                </Grid>
                <Grid Margin="0,8,0,0">
                    <Border
                        Height="26"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="4" />
                    <StackPanel
                        Margin="8,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <ui:SymbolIcon FontSize="12" Symbol="ChevronUp24" />
                        <Border
                            Width="12"
                            Height="12"
                            Margin="10,0,0,0"
                            Background="{DynamicResource TextFillColorTertiaryBrush}"
                            CornerRadius="3" />
                        <Border
                            Width="12"
                            Height="12"
                            Margin="6,0,0,0"
                            Background="{DynamicResource TextFillColorTertiaryBrush}"
                            CornerRadius="3" />
                        <Border
                            Width="12"
                            Height="12"
                            Margin="6,0,0,0"
                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                            CornerRadius="3" />
                    </StackPanel>
                </Grid>
                <TextBlock
                    Margin="0,8,0,0"
                    Style="{StaticResource AfDiagramLabelStyle}"
                    Text="把应用图标拖到任务栏后，点击和滚轮才会直接生效" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <!--  8. 双行歌词与对齐 / Two-line lyrics and alignment  -->
    <DataTemplate x:Key="AfDiagramLyricsLines">
        <Border
            Style="{StaticResource AfDiagramSurfaceStyle}"
            Padding="12,10">
            <StackPanel>
                <Border
                    Width="150"
                    Height="7"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource TextFillColorSecondaryBrush}"
                    CornerRadius="3" />
                <Border
                    Width="96"
                    Height="5"
                    Margin="0,6,0,0"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource TextFillColorTertiaryBrush}"
                    CornerRadius="3" />
                <Border
                    Height="1"
                    Margin="0,10,0,0"
                    Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel HorizontalAlignment="Left">
                        <Border Width="2" Height="12" Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="1" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource AfDiagramLabelStyle}" Text="左" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <Border Width="2" Height="12" Background="{DynamicResource TextFillColorTertiaryBrush}" CornerRadius="1" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource AfDiagramLabelStyle}" Text="中" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                        <Border Width="2" Height="12" Background="{DynamicResource TextFillColorTertiaryBrush}" CornerRadius="1" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource AfDiagramLabelStyle}" Text="右" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!--  9. 通知锚点 / Notification anchors  -->
    <DataTemplate x:Key="AfDiagramNotificationPlacement">
        <Border
            Style="{StaticResource AfDiagramSurfaceStyle}"
            Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="96" Height="54">
                    <Border
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4" />
                    <Border
                        Width="14"
                        Height="14"
                        Margin="0,6,6,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                        CornerRadius="2"
                        Opacity="0.9" />
                    <Ellipse
                        Width="5"
                        Height="5"
                        Margin="0,7,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Fill="{DynamicResource TextFillColorTertiaryBrush}" />
                    <Ellipse
                        Width="5"
                        Height="5"
                        Margin="0,7,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Fill="{DynamicResource TextFillColorTertiaryBrush}" />
                    <Ellipse
                        Width="5"
                        Height="5"
                        Margin="7,0,0,7"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Fill="{DynamicResource TextFillColorTertiaryBrush}" />
                    <Ellipse
                        Width="5"
                        Height="5"
                        Margin="0,0,0,7"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Fill="{DynamicResource TextFillColorTertiaryBrush}" />
                </Grid>
                <StackPanel
                    Grid.Column="1"
                    Margin="14,0,0,0"
                    VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource AfDiagramLabelStyle}" Text="六个锚点位于目标显示器工作区内" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Style="{StaticResource AfDiagramLabelStyle}"
                        Text="默认避开任务栏；鼠标移入通知立即隐藏" />
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!--  10. 频谱参数 / Spectrum parameters  -->
    <DataTemplate x:Key="AfDiagramSpectrum">
        <Border
            Style="{StaticResource AfDiagramSurfaceStyle}"
            Padding="12,10">
            <StackPanel>
                <StackPanel
                    Height="34"
                    VerticalAlignment="Bottom"
                    Orientation="Horizontal">
                    <Border Width="4" Height="12" VerticalAlignment="Bottom" Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="1" />
                    <Border Width="4" Height="22" Margin="4,0,0,0" VerticalAlignment="Bottom" Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="1" />
                    <Border Width="4" Height="32" Margin="4,0,0,0" VerticalAlignment="Bottom" Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="1" />
                    <Border Width="4" Height="20" Margin="4,0,0,0" VerticalAlignment="Bottom" Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="1" />
                    <Border Width="4" Height="26" Margin="4,0,0,0" VerticalAlignment="Bottom" Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="1" />
                    <Border Width="4" Height="14" Margin="4,0,0,0" VerticalAlignment="Bottom" Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="1" />
                    <Border Width="4" Height="24" Margin="4,0,0,0" VerticalAlignment="Bottom" Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="1" />
                    <Border Width="4" Height="10" Margin="4,0,0,0" VerticalAlignment="Bottom" Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="1" />
                    <Border Width="4" Height="18" Margin="4,0,0,0" VerticalAlignment="Bottom" Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="1" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Bottom">
                        <TextBlock Style="{StaticResource AfDiagramLabelStyle}" Text="柱数决定柱宽" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Style="{StaticResource AfDiagramLabelStyle}"
                            Text="暂停时保留槽位并清零柱高" />
                    </StackPanel>
                </StackPanel>
                <Border
                    Height="1"
                    Margin="0,6,0,0"
                    Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource AfDiagramLabelStyle}" Text="刷新率" />
                    <TextBlock
                        Margin="14,0,0,0"
                        Style="{StaticResource AfDiagramLabelStyle}"
                        Text="灵敏度" />
                    <TextBlock
                        Margin="14,0,0,0"
                        Style="{StaticResource AfDiagramLabelStyle}"
                        Text="仅播放时采样" />
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!--  11. 表面预设 / Surface presets  -->
    <DataTemplate x:Key="AfDiagramSurfacePresets">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border
                Style="{StaticResource AfDiagramSurfaceStyle}"
                Margin="0,0,8,0"
                Padding="8">
                <StackPanel>
                    <Border
                        Height="10"
                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                        CornerRadius="3"
                        Opacity="0.75" />
                    <TextBlock
                        Margin="0,8,0,0"
                        Style="{StaticResource AfDiagramLabelStyle}"
                        Text="任务栏" />
                </StackPanel>
            </Border>
            <Border
                Grid.Column="1"
                Style="{StaticResource AfDiagramSurfaceStyle}"
                Margin="0,0,8,0"
                Padding="8">
                <StackPanel>
                    <Border
                        Width="34"
                        Height="14"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="7" />
                    <TextBlock
                        Margin="0,8,0,0"
                        Style="{StaticResource AfDiagramLabelStyle}"
                        Text="灵动岛" />
                </StackPanel>
            </Border>
            <Border
                Grid.Column="2"
                Style="{StaticResource AfDiagramSurfaceStyle}"
                Margin="0,0,8,0"
                Padding="8">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
