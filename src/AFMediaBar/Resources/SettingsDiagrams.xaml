                    Height="1"
                    Margin="0,10,0,0"
                    Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <TextBlock
                    Margin="0,8,0,0"
                    Style="{StaticResource AfDiagramCaptionStyle}"
                    Text="上下两排共六个锚点，高亮方块是当前位置。换显示器只改变落点，不改变通知内容。" />
            </StackPanel>
        </Border>
    </ControlTemplate>

