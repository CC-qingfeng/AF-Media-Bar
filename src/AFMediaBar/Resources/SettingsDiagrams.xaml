<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!--
        设置页矢量说明图 / Settings vector diagrams

        每张图都紧挨着它所解释的控件，并且自带唯一一句说明；页面不再需要另写一条说明来解释同一件事。
        所有颜色都取自主题画刷，因此浅色、深色、高对比度和系统主色变化都不需要额外处理。

        Every diagram sits next to the control it explains and carries exactly one caption, so a page never has
        to repeat the same explanation elsewhere. Every colour comes from a theme brush, so light, dark, high
        contrast, and accent changes need no extra handling.

        带 Tag="demo-pulse" 或 Tag="demo-nudge-y" 的元素由 SettingsDiagram 驱动循环演示，
        且只在图可见、窗口处于前台时运行。
        Elements tagged demo-pulse or demo-nudge-y are animated by SettingsDiagram, and only while the diagram
        is visible and its window is in the foreground.
    -->

    <Style x:Key="AfDiagramLabelStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--  图的唯一一句说明，统一放在分隔线下方。  -->
    <!--  The diagram's single caption, always below the divider.  -->
    <Style x:Key="AfDiagramCaptionStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="LineHeight" Value="17" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    </Style>

    <Style x:Key="AfDiagramSurfaceStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!--  1. 静置层 / Rest layer  -->
    <ControlTemplate x:Key="AfDiagramLayerRest">
        <Border
            Padding="12,10"
            Style="{StaticResource AfDiagramSurfaceStyle}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Width="22"
                        Height="22"
                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                        CornerRadius="5"
                        Opacity="0.8" />

                    <StackPanel
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center">
                        <Border
                            Width="88"
                            Height="6"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource TextFillColorSecondaryBrush}"
                            CornerRadius="3"
                            Opacity="0.8" />
                        <Border
                            Width="58"
                            Height="4"
                            Margin="0,5,0,0"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource TextFillColorTertiaryBrush}"
                            CornerRadius="2" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Border
                            Width="3"
                            Height="10"
                            Tag="demo-pulse"
                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                            CornerRadius="1" />
                        <Border
                            Width="3"
                            Height="18"
                            Margin="3,0,0,0"
                            Tag="demo-pulse"
                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                            CornerRadius="1" />
                        <Border
                            Width="3"
                            Height="13"
                            Margin="3,0,0,0"
                            Tag="demo-pulse"
                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                            CornerRadius="1" />
                        <Border
                            Width="3"
                            Height="7"
                            Margin="3,0,0,0"
                            Tag="demo-pulse"
                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                            CornerRadius="1" />
                        <Border
                            Width="26"
                            Height="12"
                            Margin="10,0,0,0"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="3" />
                    </StackPanel>
                </Grid>
                <Border
                    Height="1"
                    Margin="0,10,0,0"
                    Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <TextBlock
                    Margin="0,8,0,0"
                    Style="{StaticResource AfDiagramCaptionStyle}"
                    Text="常驻显示封面与标题歌手；频谱和性能组件叠加在右侧。两个组件的开关与参数在「媒体与通知 → 静置层组件」。" />
            </StackPanel>
        </Border>
    </ControlTemplate>

    <!--  2. 悬停层 / Hover layer  -->
    <ControlTemplate x:Key="AfDiagramLayerHover">
        <Border
            Padding="12,10"
            Style="{StaticResource AfDiagramSurfaceStyle}">
            <StackPanel>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Border
                        Width="22"
                        Height="22"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="11" />
                    <Border
                        Width="22"
                        Height="22"
                        Margin="6,0,0,0"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="11" />
                    <Border
                        Width="22"
                        Height="22"
                        Margin="6,0,0,0"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="11" />
                    <Border
                        Width="22"
                        Height="22"
                        Margin="6,0,0,0"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="11" />
                    <Border
                        Width="22"
                        Height="22"
                        Margin="6,0,0,0"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="11" />
                    <Border
                        Width="74"
                        Height="22"
                        Margin="12,0,0,0"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="11" />
                    <Border
                        Width="12"
                        Height="12"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                        CornerRadius="6" />
                </StackPanel>
                <Border
                    Height="1"
                    Margin="0,10,0,0"
                    Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <TextBlock
                    Margin="0,8,0,0"
                    Style="{StaticResource AfDiagramCaptionStyle}"
                    Text="鼠标移入媒体栏时展开。五个圆形按钮依次是播放暂停、上下首、输出设备、音频控制和进度；设备、音量与进度默认显示。" />
            </StackPanel>
        </Border>
    </ControlTemplate>

    <!--  3. 完整层 / Full layer  -->
    <ControlTemplate x:Key="AfDiagramLayerFull">
        <Border
            Padding="12,10"
            Style="{StaticResource AfDiagramSurfaceStyle}">
            <StackPanel>
                <UniformGrid Columns="4">
                    <Border
                        Margin="0,0,6,0"
                        Padding="0,9"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="4">
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource AfDiagramLabelStyle}"
                            Text="媒体信息" />
                    </Border>
                    <Border
                        Margin="0,0,6,0"
                        Padding="0,9"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="4">
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource AfDiagramLabelStyle}"
                            Text="播放控制" />
                    </Border>
                    <Border
                        Margin="0,0,6,0"
                        Padding="0,9"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="4">
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource AfDiagramLabelStyle}"
                            Text="音频控制" />
                    </Border>
                    <Border
                        Padding="0,9"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="4">
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource AfDiagramLabelStyle}"
                            Text="性能" />
                    </Border>
                </UniformGrid>
                <Border
                    Height="1"
                    Margin="0,10,0,0"
                    Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <TextBlock
                    Margin="0,8,0,0"
                    Style="{StaticResource AfDiagramCaptionStyle}"
                    Text="点击媒体栏展开的完整面板。四个分区可以分别关闭，但至少保留一个：只剩一个时它的开关会被禁用。" />
            </StackPanel>
        </Border>
    </ControlTemplate>

    <!--  4. 任务栏位置与避让 / Taskbar placement and avoidance  -->
    <ControlTemplate x:Key="AfDiagramTaskbarPlacement">
        <Border
            Padding="12,10"
            Style="{StaticResource AfDiagramSurfaceStyle}">
            <StackPanel>
                <Grid Height="44">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Grid.Column="0"
                        VerticalAlignment="Bottom"
                        Orientation="Horizontal">
                        <Border
                            Width="11"
                            Height="11"
                            Background="{DynamicResource TextFillColorTertiaryBrush}"
                            CornerRadius="2" />
                        <Border
                            Width="11"
                            Height="11"
                            Margin="6,0,0,0"
                            Background="{DynamicResource TextFillColorTertiaryBrush}"
                            CornerRadius="2" />
                        <Border
                            Width="11"
                            Height="11"
                            Margin="6,0,0,0"
                            Background="{DynamicResource TextFillColorTertiaryBrush}"
                            CornerRadius="2" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Margin="16,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Orientation="Horizontal">
                        <ui:SymbolIcon
                            Margin="0,0,4,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            Symbol="ArrowLeft24" />
                        <Border
                            Width="150"
                            Height="22"
                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                            CornerRadius="4"
                            Opacity="0.8" />
                        <ui:SymbolIcon
                            Margin="4,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            Symbol="ArrowRight24" />
                    </StackPanel>
                </Grid>

                <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                <Grid Margin="0,8,0,0">
                    <TextBlock Style="{StaticResource AfDiagramLabelStyle}" Text="任务栏图标区" />
                    <TextBlock
                        HorizontalAlignment="Right"
                        Style="{StaticResource AfDiagramLabelStyle}"
                        Text="边缘偏移 −20 ~ +20 DIP" />
                </Grid>

                <TextBlock
                    Margin="0,8,0,0"
                    Style="{StaticResource AfDiagramCaptionStyle}"
                    Text="「避开任务栏图标」保证媒体栏不会盖住图标；边缘偏移微调它与图标区之间的间距，箭头方向随偏移正负变化。" />
            </StackPanel>
        </Border>
    </ControlTemplate>

    <!--  5. 媒体栏长度 / Media bar length  -->
    <ControlTemplate x:Key="AfDiagramTaskbarLength">
        <Border
            Padding="12,10"
            Style="{StaticResource AfDiagramSurfaceStyle}">
            <StackPanel>
                <Grid Height="26">
                    <Border
                        Height="10"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="5" />
                    <Border
                        Height="10"
                        Margin="72,0,64,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                        CornerRadius="5"
                        Opacity="0.85" />
                    <Border
                        Width="2"
                        Height="26"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource TextFillColorTertiaryBrush}"
                        CornerRadius="1" />
                    <Border
                        Width="2"
                        Height="26"
                        HorizontalAlignment="Right"
                        Background="{DynamicResource TextFillColorTertiaryBrush}"
                        CornerRadius="1" />
                </Grid>
                <Grid Margin="0,8,0,0">
                    <TextBlock Style="{StaticResource AfDiagramLabelStyle}" Text="悬停层所需最小长度" />
                    <TextBlock
                        HorizontalAlignment="Right"
                        Style="{StaticResource AfDiagramLabelStyle}"
                        Text="任务栏安全上限" />
                </Grid>
                <Border
                    Height="1"
                    Margin="0,10,0,0"
                    Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <TextBlock
                    Margin="0,8,0,0"
                    Style="{StaticResource AfDiagramCaptionStyle}"
                    Text="跟随媒体文字长度时宽度随内容变化；取消跟随才启用固定长度滑杆，滑杆范围被夹取在两端标记之间。" />
            </StackPanel>
        </Border>
    </ControlTemplate>

    <!--  6. 静置层点击区域 / Click zones on the rest layer  -->
    <ControlTemplate x:Key="AfDiagramInputGestures">
        <Border
            Padding="12,10"
            Style="{StaticResource AfDiagramSurfaceStyle}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="22"
                        Height="22"
                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                        CornerRadius="5"
                        Opacity="0.8" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Style="{StaticResource AfDiagramLabelStyle}"
                        Text="点击封面" />
                </Grid>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <Border
                            Width="88"
                            Height="6"
                            Background="{DynamicResource TextFillColorSecondaryBrush}"
                            CornerRadius="3"
                            Opacity="0.8" />
                        <Border
                            Width="56"
                            Height="4"
                            Margin="0,5,0,0"
                            Background="{DynamicResource TextFillColorTertiaryBrush}"
                            CornerRadius="2" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Style="{StaticResource AfDiagramLabelStyle}"
                        Text="点击标题或歌词" />
                </Grid>
                <Border
                    Height="1"
                    Margin="0,10,0,0"
                    Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <TextBlock
                    Margin="0,8,0,0"
                    Style="{StaticResource AfDiagramCaptionStyle}"
                    Text="静置层只有这两个可绑定区域，可以分别指向不同结果；完整层里的按钮不读取这两个绑定。" />
            </StackPanel>
        </Border>
    </ControlTemplate>

    <!--  7. 滚轮方向 / Wheel direction per surface  -->
    <ControlTemplate x:Key="AfDiagramWheelGestures">
        <Border
            Padding="12,10"
            Style="{StaticResource AfDiagramSurfaceStyle}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource AfDiagramLabelStyle}" Text="程序内" />
                    <StackPanel
                        Grid.Column="1"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <ui:SymbolIcon
                            Tag="demo-nudge-y"
                            FontSize="13"
                            Symbol="ArrowUp24" />
                        <ui:SymbolIcon
                            Margin="6,0,0,0"
                            FontSize="13"
                            Symbol="ArrowDown24" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="2"
                        Margin="12,0,0,0"
                        Style="{StaticResource AfDiagramLabelStyle}"
                        Text="含义由绑定决定：上下首、切换设备或媒体源、调节音量" />
                </Grid>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource AfDiagramLabelStyle}" Text="托盘图标" />
                    <StackPanel
                        Grid.Column="1"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <ui:SymbolIcon
                            Tag="demo-nudge-y"
                            FontSize="13"
                            Symbol="ArrowUp24" />
                        <ui:SymbolIcon
                            Margin="6,0,0,0"
                            FontSize="13"
                            Symbol="ArrowDown24" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="2"
                        Margin="12,0,0,0"
                        Style="{StaticResource AfDiagramLabelStyle}"
                        Text="只有切换输出设备与调节当前媒体音量两种结果" />
                </Grid>
                <Border
                    Height="1"
                    Margin="0,10,0,0"
                    Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <TextBlock
                    Margin="0,8,0,0"
                    Style="{StaticResource AfDiagramCaptionStyle}"
                    Text="向上与向下没有固定含义，取决于绑定的动作。切换输出设备时先显示候选，停止滚动约 1.2 秒后才应用。" />
            </StackPanel>
        </Border>
    </ControlTemplate>

    <!--  8. 托盘溢出区 / Tray overflow  -->
    <ControlTemplate x:Key="AfDiagramTrayOverflow">
        <Border
            Padding="12,10"
            Style="{StaticResource AfDiagramSurfaceStyle}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource AfDiagramLabelStyle}" Text="任务栏托盘区" />
                    <TextBlock
                        Grid.Column="1"
                        Style="{StaticResource AfDiagramLabelStyle}"
                        Text="隐藏图标溢出区" />
                </Grid>
                <Grid Margin="0,8,0,0">
                    <Border
                        Height="28"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="4" />
                    <StackPanel
                        Margin="10,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <ui:SymbolIcon FontSize="12" Symbol="ChevronUp24" />
                        <Border
                            Width="13"
                            Height="13"
                            Margin="12,0,0,0"
                            Background="{DynamicResource TextFillColorTertiaryBrush}"
                            CornerRadius="3" />
                        <Border
                            Width="13"
                            Height="13"
                            Margin="6,0,0,0"
                            Background="{DynamicResource TextFillColorTertiaryBrush}"
                            CornerRadius="3" />
                        <Border
                            Width="13"
                            Height="13"
                            Margin="6,0,0,0"
                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                            CornerRadius="3" />
                    </StackPanel>
                </Grid>
                <Border
                    Height="1"
                    Margin="0,10,0,0"
                    Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <TextBlock
                    Margin="0,8,0,0"
                    Style="{StaticResource AfDiagramCaptionStyle}"
                    Text="高亮方块是本程序，默认被收在溢出区。只有在 Windows 任务栏设置里把它拖到任务栏上，下面两张卡片的点击与滚轮才会直接生效。" />
            </StackPanel>
        </Border>
    </ControlTemplate>

    <!--  9. 双行歌词 / Two lyric lines  -->
    <ControlTemplate x:Key="AfDiagramLyricsTwoLine">
        <Border
            Padding="12,10"
            Style="{StaticResource AfDiagramSurfaceStyle}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        MinWidth="42"
                        Style="{StaticResource AfDiagramLabelStyle}"
                        Text="第一行" />
                    <Border
                        Grid.Column="1"
                        Width="150"
                        Height="7"
                        Margin="10,0,0,0"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource TextFillColorSecondaryBrush}"
                        CornerRadius="3" />
                </Grid>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        MinWidth="42"
                        Style="{StaticResource AfDiagramLabelStyle}"
                        Text="第二行" />
                    <Border
                        Grid.Column="1"
                        Width="104"
                        Height="5"
                        Margin="10,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="{DynamicResource TextFillColorTertiaryBrush}"
                        CornerRadius="3" />
                </Grid>
                <Border
                    Height="1"
                    Margin="0,10,0,0"
                    Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <TextBlock
                    Margin="0,8,0,0"
                    Style="{StaticResource AfDiagramCaptionStyle}"
                    Text="第一行始终是当前句；第二行取自下面选的内容，静置层空间不足时不会显示。" />
            </StackPanel>
        </Border>
    </ControlTemplate>

    <!--  10. 歌词对齐 / Lyric alignment  -->
    <ControlTemplate x:Key="AfDiagramLyricsAlignment">
        <Border
            Padding="12,10"
            Style="{StaticResource AfDiagramSurfaceStyle}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel HorizontalAlignment="Left">
                        <Border
                            Width="3"
                            Height="14"
                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                            CornerRadius="1" />
                        <TextBlock
                            Margin="0,5,0,0"
                            Style="{StaticResource AfDiagramLabelStyle}"
                            Text="左对齐" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        HorizontalAlignment="Center">
                        <Border
                            Width="3"
                            Height="14"
                            Background="{DynamicResource TextFillColorTertiaryBrush}"
                            CornerRadius="1" />
                        <TextBlock
                            Margin="0,5,0,0"
                            Style="{StaticResource AfDiagramLabelStyle}"
                            Text="居中" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="2"
                        HorizontalAlignment="Right">
                        <Border
                            Width="3"
                            Height="14"
                            Background="{DynamicResource TextFillColorTertiaryBrush}"
                            CornerRadius="1" />
                        <TextBlock
                            Margin="0,5,0,0"
                            Style="{StaticResource AfDiagramLabelStyle}"
                            Text="右对齐" />
                    </StackPanel>
                </Grid>
                <Border
                    Height="1"
                    Margin="0,10,0,0"
                    Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <TextBlock
                    Margin="0,8,0,0"
                    Style="{StaticResource AfDiagramCaptionStyle}"
                    Text="只决定歌词贴在静置层的哪一侧。标题与歌手的对齐是另一项设置，在「显示模式 → 静置层 → 信息布局」。" />
            </StackPanel>
        </Border>
    </ControlTemplate>

    <!--  11. 通知锚点 / Notification anchors  -->
    <ControlTemplate x:Key="AfDiagramNotificationPlacement">
        <Border
            Padding="12,10"
            Style="{StaticResource AfDiagramSurfaceStyle}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="150" Height="72">
                        <Border
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4" />
                        <Border
                            Width="34"
                            Height="18"
                            Margin="0,7,7,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                            CornerRadius="3"
                            Opacity="0.9" />
                        <Ellipse
                            Width="5"
                            Height="5"
                            Margin="9,10,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
