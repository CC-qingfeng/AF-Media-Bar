<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Duration x:Key="AfMotionFastDuration">0:0:0.12</Duration>
    <Duration x:Key="AfMotionStandardDuration">0:0:0.18</Duration>
    <Duration x:Key="AfMotionPanelDuration">0:0:0.18</Duration>
    <Duration x:Key="AfMotionPositionDuration">0:0:0.22</Duration>
    <Duration x:Key="AfMotionExitDuration">0:0:0.12</Duration>

    <PowerEase x:Key="AfEaseOut" Power="3" EasingMode="EaseOut" />
    <PowerEase x:Key="AfEaseInOut" Power="3" EasingMode="EaseInOut" />

    <!-- 阴影按控件层级分档；低性能/高对比度路径由宿主清除。 -->
    <!-- Shadow tiers stay resource-backed; hosts clear them on low-performance/high-contrast paths. -->
    <DropShadowEffect x:Key="AfButtonShadowEffect" BlurRadius="6" ShadowDepth="1" Opacity="0.16" />
    <DropShadowEffect x:Key="AfPanelShadowEffect" BlurRadius="24" ShadowDepth="6" Opacity="0.28" />
    <DropShadowEffect x:Key="AfFlyoutShadowEffect" BlurRadius="16" ShadowDepth="3" Opacity="0.24" />
    <DropShadowEffect x:Key="AfNotificationShadowEffect" BlurRadius="12" ShadowDepth="2" Opacity="0.24" />

    <CornerRadius x:Key="AfButtonCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="AfSurfaceCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="AfNotificationCornerRadius">10</CornerRadius>

    <Style x:Key="AfFocusVisualStyle" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-2"
                            BorderBrush="{x:Static SystemColors.HighlightBrush}"
                            BorderThickness="2"
                            CornerRadius="4" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
