<Page
    x:Class="AFMediaBar.Views.Pages.ExtraFeaturesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:AFMediaBar.Components"
    xmlns:settings="clr-namespace:AFMediaBar.Classes.Settings"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ScrollViewer.CanContentScroll="False">

    <!--
        媒体与通知页 / Media and notifications page

        排布规则：一行一个选项，一行恰好一个控件。列表用展开器承载，列表行仍然是一行一个来源；
        频谱与性能这种「一个开关 + 若干参数」的分组进展开器，展开体是同样的行。

        本页曾经把开关放在显示模式页、参数放在这里，也曾经把四个指标勾选框和满宽滑杆塞进同一张卡片；
        现在两项都改了：开关与参数同处一个展开器，指标各占一行。

        Layout rule: one option per row, exactly one control per row. Lists live behind expanders and each list
        row still holds one item; groups shaped like "one switch plus several parameters", such as the spectrum
        and performance components, become expanders whose body holds the same rows.

        This page used to keep the component switches on the display page while the parameters lived here, and to
        cram four metric checkboxes together with a full-width slider into one card. Both are fixed: each switch
        sits with its own parameters, and each metric gets its own row.
    -->

    <Page.Resources>
        <!--
            依赖未满足时才出现的徽章：组件关闭时它的参数行只读。
            父项开关就在行内，因此徽章只需要一句话。
            A badge that appears only while its dependency is unmet: a component's parameter rows are read-only
            while the component is off. The parent switch is on the same card, so one short phrase is enough.
        -->
        <Style
            x:Key="SpectrumParameterRowStyle"
            BasedOn="{StaticResource {x:Type components:SettingsRow}}"
            TargetType="{x:Type components:SettingsRow}">
            <Setter Property="Badge" Value="" />
            <Setter Property="IsEnabled" Value="{Binding ViewModel.SpectrumVisible}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ViewModel.SpectrumVisible}" Value="False">
                    <Setter Property="Badge" Value="{DynamicResource Loc.Media.Badge.EnableFirst}" />
                    <Setter Property="BadgeTone" Value="Attention" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="PerformanceParameterRowStyle"
            BasedOn="{StaticResource {x:Type components:SettingsRow}}"
            TargetType="{x:Type components:SettingsRow}">
            <Setter Property="Badge" Value="" />
            <Setter Property="IsEnabled" Value="{Binding ViewModel.PerformanceVisible}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ViewModel.PerformanceVisible}" Value="False">
                    <Setter Property="Badge" Value="{DynamicResource Loc.Media.Badge.EnableFirst}" />
                    <Setter Property="BadgeTone" Value="Attention" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <components:SettingsGroupStrip
            Grid.Row="0"
            Margin="{StaticResource AfSettingsHeaderMargin}"
            MaxWidth="{StaticResource AfSettingsContentMaxWidth}"
            PageIcon="{ui:SymbolIcon PuzzlePiece24}"
            Subtitle="{DynamicResource Loc.Media.Header.Subtitle}"
            Target="{Binding ElementName=PageScroll}"
            Title="{DynamicResource Loc.Common.Page.MediaAndNotifications}" />

        <ScrollViewer
            x:Name="PageScroll"
            Grid.Row="1"
            Margin="{StaticResource AfSettingsScrollMargin}"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                x:Name="PageRoot"
                MaxWidth="{StaticResource AfSettingsContentMaxWidth}"
                Loaded="OnPageLoaded">

                <components:SettingsGroup Header="{DynamicResource Loc.Common.MediaSource}" Icon="{ui:SymbolIcon Filter24}">
                    <StackPanel>
                        <components:SettingsRow
                            Description="{DynamicResource Loc.Media.SourceFilter.Description}"
                            Icon="{ui:SymbolIcon Filter24}"
                            Title="{DynamicResource Loc.Media.SourceFilter.Title}">
                            <ui:ToggleSwitch IsChecked="{Binding ViewModel.SmtcFilterEnabled, Mode=TwoWay}" />
                        </components:SettingsRow>

                        <ui:CardExpander
                            Style="{StaticResource AfSettingsExpanderStyle}"
                            Icon="{ui:SymbolIcon AppsList24}"
                            IsExpanded="True">
                            <ui:CardExpander.Header>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource AfSettingsRowTitleStyle}" Text="{DynamicResource Loc.Media.SourceList.Title}" />
                                    <TextBlock Style="{StaticResource AfSettingsRowDescriptionStyle}" Text="{DynamicResource Loc.Media.SourceList.Description}" />
                                </StackPanel>
                            </ui:CardExpander.Header>
                            <ItemsControl ItemsSource="{Binding ViewModel.Sources}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <components:SettingsRow
                                            Description="{Binding Descriptor.SourceId}"
                                            IsNested="True"
                                            Title="{Binding Descriptor.DisplayName}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:ToggleSwitch
                                                    Content="{DynamicResource Loc.Media.SourceList.Allow}"
                                                    IsChecked="{Binding IsAllowed, Mode=TwoWay}" />
                                                <ui:Button
                                                    Margin="12,0,0,0"
                                                    Command="{Binding DataContext.ViewModel.AddDetectedSourceCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    Content="{DynamicResource Loc.Media.SourceList.AddToQuickLaunch}"
                                                    IsEnabled="{Binding Descriptor.CanQuickLaunch}"
                                                    Style="{StaticResource AfSettingsButtonStyle}"
                                                    ToolTip="{DynamicResource Loc.Media.SourceList.AddToQuickLaunch.ToolTip}"
                                                    ToolTipService.ShowOnDisabled="True" />
                                            </StackPanel>
                                        </components:SettingsRow>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ui:CardExpander>
                    </StackPanel>
                </components:SettingsGroup>

                <components:SettingsGroup Header="{DynamicResource Loc.Common.Group.QuickLaunch}" Icon="{ui:SymbolIcon Rocket24}">
                    <StackPanel>
                        <components:SettingsRow
                            Description="{DynamicResource Loc.Media.QuickLaunch.FromNote.Description}"
                            Icon="{ui:SymbolIcon Rocket24}"
                            Title="{DynamicResource Loc.Media.QuickLaunch.FromNote.Title}">
                            <ui:Button
                                Click="BrowseQuickLaunch_Click"
                                Content="{DynamicResource Loc.Media.QuickLaunch.Browse}"
                                Icon="{ui:SymbolIcon FolderOpen24}"
                                Style="{StaticResource AfSettingsButtonStyle}" />
                        </components:SettingsRow>

                        <components:SettingsRow
                            Description="{DynamicResource Loc.Media.QuickLaunch.Entries.Description}"
                            Icon="{ui:SymbolIcon AppsListDetail24}"
                            Title="{DynamicResource Loc.Media.QuickLaunch.Entries.Title}">
                            <TextBlock
                                Style="{StaticResource AfSettingsRowValueStyle}"
                                Text="{Binding ViewModel.QuickLaunchEntryCountText}" />
                        </components:SettingsRow>

                        <ItemsControl Margin="0,0,0,4" ItemsSource="{Binding ViewModel.QuickLaunchEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <components:SettingsRow
                                        Description="{Binding Target}"
                                        IsNested="True"
                                        Title="{Binding DisplayName}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:Button
                                                Command="{Binding DataContext.ViewModel.MoveQuickLaunchUpCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"
                                                Icon="{ui:SymbolIcon ArrowUp24}"
                                                Style="{StaticResource AfSettingsIconButtonStyle}"
                                                ToolTip="{DynamicResource Loc.Media.QuickLaunch.MoveUp}" />
                                            <ui:Button
                                                Margin="4,0,0,0"
                                                Command="{Binding DataContext.ViewModel.MoveQuickLaunchDownCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"
                                                Icon="{ui:SymbolIcon ArrowDown24}"
                                                Style="{StaticResource AfSettingsIconButtonStyle}"
                                                ToolTip="{DynamicResource Loc.Media.QuickLaunch.MoveDown}" />
                                            <ui:Button
                                                Margin="4,0,0,0"
                                                Command="{Binding DataContext.ViewModel.RemoveQuickLaunchCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"
                                                Icon="{ui:SymbolIcon Delete24}"
                                                Style="{StaticResource AfSettingsIconButtonStyle}"
                                                ToolTip="{DynamicResource Loc.Media.QuickLaunch.Remove}" />
                                        </StackPanel>
                                    </components:SettingsRow>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock
                            Margin="0,4,0,0"
                            Style="{StaticResource AfSettingsHintTextStyle}"
                            Text="{Binding ViewModel.StatusText}" />
                    </StackPanel>
                </components:SettingsGroup>

                <components:SettingsGroup
                    Description="{DynamicResource Loc.Media.RestComponents.Description}"
                    Header="{DynamicResource Loc.Common.Group.RestLayerComponents}"
                    Icon="{ui:SymbolIcon DataHistogram24}">
                    <StackPanel>
                        <components:SettingsDiagram Margin="0,0,0,12" Kind="Spectrum" />

                        <components:SettingsRow
                            Description="{DynamicResource Loc.Media.Spectrum.Visible.Description}"
                            Icon="{ui:SymbolIcon DataHistogram24}"
                            Title="{DynamicResource Loc.Media.Spectrum.Visible.Title}">
                            <ui:ToggleSwitch IsChecked="{Binding ViewModel.SpectrumVisible, Mode=TwoWay}" />
                        </components:SettingsRow>

                        <ui:CardExpander
                            Style="{StaticResource AfSettingsExpanderStyle}"
                            Icon="{ui:SymbolIcon DataBarVertical24}"
                            IsExpanded="{Binding ViewModel.SpectrumVisible, Mode=OneWay}">
                            <ui:CardExpander.Header>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource AfSettingsRowTitleStyle}" Text="{DynamicResource Loc.Media.Spectrum.Parameters.Title}" />
                                    <TextBlock Style="{StaticResource AfSettingsRowDescriptionStyle}" Text="{DynamicResource Loc.Media.Spectrum.Parameters.Description}" />
                                </StackPanel>
                            </ui:CardExpander.Header>
                            <StackPanel>
                                <components:SettingsRow
                                    Description="{DynamicResource Loc.Media.Spectrum.Style.Description}"
                                    Icon="{ui:SymbolIcon PaintBrush24}"
                                    IsNested="True"
                                    Style="{StaticResource SpectrumParameterRowStyle}"
                                    Title="{DynamicResource Loc.Media.Spectrum.Style.Title}">
                                    <ComboBox
                                        MinWidth="160"
                                        SelectedValue="{Binding ViewModel.SpectrumStyle, Mode=TwoWay}"
                                        SelectedValuePath="Tag">
                                        <ComboBoxItem Content="{DynamicResource Loc.Media.Spectrum.Style.Bars}" Tag="{x:Static settings:SpectrumStyle.Bars}" />
                                        <ComboBoxItem Content="{DynamicResource Loc.Media.Spectrum.Style.Waveform}" Tag="{x:Static settings:SpectrumStyle.Waveform}" />
                                        <ComboBoxItem Content="{DynamicResource Loc.Media.Spectrum.Style.PixelBars}" Tag="{x:Static settings:SpectrumStyle.PixelBars}" />
                                        <ComboBoxItem Content="{DynamicResource Loc.Media.Spectrum.Style.MirroredBars}" Tag="{x:Static settings:SpectrumStyle.MirroredBars}" />
                                    </ComboBox>
                                </components:SettingsRow>
                                <components:SettingsRow
                                    Description="{DynamicResource Loc.Media.Spectrum.BandCount.Description}"
                                    Icon="{ui:SymbolIcon DataBarVertical24}"
                                    IsNested="True"
                                    Style="{StaticResource SpectrumParameterRowStyle}"
                                    Title="{DynamicResource Loc.Media.Spectrum.BandCount.Title}">
                                    <StackPanel Orientation="Horizontal">
                                        <Slider
                                            IsSnapToTickEnabled="True"
                                            Maximum="{Binding ViewModel.MaximumSpectrumBandCount}"
                                            Minimum="{Binding ViewModel.MinimumSpectrumBandCount}"
                                            Style="{StaticResource AfSettingsRowSliderStyle}"
                                            TickFrequency="1"
                                            Value="{Binding ViewModel.SpectrumBandCount, Mode=TwoWay}" />
                                        <TextBlock Style="{StaticResource AfSettingsRowValueStyle}" Text="{Binding ViewModel.SpectrumBandCountText}" />
                                    </StackPanel>
                                </components:SettingsRow>
                                <components:SettingsRow
                                    Description="{DynamicResource Loc.Media.Spectrum.RefreshRate.Description}"
                                    Icon="{ui:SymbolIcon Timer24}"
                                    IsNested="True"
                                    Style="{StaticResource SpectrumParameterRowStyle}"
                                    Title="{DynamicResource Loc.Media.Spectrum.RefreshRate.Title}">
                                    <StackPanel Orientation="Horizontal">
                                        <Slider
                                            IsSnapToTickEnabled="True"
                                            Maximum="30"
                                            Minimum="5"
                                            Style="{StaticResource AfSettingsRowSliderStyle}"
                                            TickFrequency="1"
                                            Value="{Binding ViewModel.SpectrumRefreshRateHz, Mode=TwoWay}" />
                                        <TextBlock Style="{StaticResource AfSettingsRowValueStyle}" Text="{Binding ViewModel.SpectrumRefreshRateHz, StringFormat={}{0} Hz}" />
                                    </StackPanel>
                                </components:SettingsRow>
                                <components:SettingsRow
                                    Description="{DynamicResource Loc.Media.Spectrum.Sensitivity.Description}"
                                    Icon="{ui:SymbolIcon TopSpeed24}"
                                    IsNested="True"
                                    Style="{StaticResource SpectrumParameterRowStyle}"
                                    Title="{DynamicResource Loc.Media.Spectrum.Sensitivity.Title}">
                                    <StackPanel Orientation="Horizontal">
                                        <Slider
                                            IsSnapToTickEnabled="True"
                                            Maximum="{Binding ViewModel.MaximumSpectrumSensitivityPercent}"
                                            Minimum="{Binding ViewModel.MinimumSpectrumSensitivityPercent}"
                                            Style="{StaticResource AfSettingsRowSliderStyle}"
                                            TickFrequency="{Binding ViewModel.SpectrumSensitivityStepPercent}"
                                            Value="{Binding ViewModel.SpectrumSensitivityPercent, Mode=TwoWay}" />
                                        <TextBlock Style="{StaticResource AfSettingsRowValueStyle}" Text="{Binding ViewModel.SpectrumSensitivityPercent, StringFormat={}{0}%}" />
                                    </StackPanel>
                                </components:SettingsRow>
                            </StackPanel>
                        </ui:CardExpander>

                        <components:SettingsRow
                            Description="{DynamicResource Loc.Media.Performance.Visible.Description}"
                            Icon="{ui:SymbolIcon Gauge24}"
                            Title="{DynamicResource Loc.Media.Performance.Visible.Title}">
                            <ui:ToggleSwitch IsChecked="{Binding ViewModel.PerformanceVisible, Mode=TwoWay}" />
                        </components:SettingsRow>

                        <ui:CardExpander
                            Style="{StaticResource AfSettingsExpanderStyle}"
                            Icon="{ui:SymbolIcon Gauge24}"
                            IsExpanded="{Binding ViewModel.PerformanceVisible, Mode=OneWay}">
                            <ui:CardExpander.Header>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource AfSettingsRowTitleStyle}" Text="{DynamicResource Loc.Media.Performance.Metrics.Title}" />
                                    <TextBlock Style="{StaticResource AfSettingsRowDescriptionStyle}" Text="{DynamicResource Loc.Media.Performance.Metrics.Description}" />
                                </StackPanel>
                            </ui:CardExpander.Header>
                            <StackPanel>
                                <components:SettingsRow
                                    Description="{DynamicResource Loc.Media.Metric.SystemMemory.Description}"
                                    Icon="{ui:SymbolIcon Storage24}"
                                    IsNested="True"
                                    Style="{StaticResource PerformanceParameterRowStyle}"
                                    Title="{DynamicResource Loc.Media.Metric.SystemMemory.Title}">
                                    <ui:ToggleSwitch
                                        IsChecked="{Binding ViewModel.ShowSystemMemory, Mode=TwoWay}"
                                        IsEnabled="{Binding ViewModel.CanUncheckSystemMemory}" />
                                </components:SettingsRow>
                                <components:SettingsRow
                                    Icon="{ui:SymbolIcon DeveloperBoard24}"
                                    IsNested="True"
                                    Style="{StaticResource PerformanceParameterRowStyle}"
                                    Title="CPU">
                                    <ui:ToggleSwitch
                                        IsChecked="{Binding ViewModel.ShowSystemCpu, Mode=TwoWay}"
                                        IsEnabled="{Binding ViewModel.CanUncheckSystemCpu}" />
                                </components:SettingsRow>
                                <components:SettingsRow
                                    Icon="{ui:SymbolIcon VideoClip24}"
                                    IsNested="True"
                                    Style="{StaticResource PerformanceParameterRowStyle}"
                                    Title="GPU">
                                    <ui:ToggleSwitch
                                        IsChecked="{Binding ViewModel.ShowSystemGpu, Mode=TwoWay}"
                                        IsEnabled="{Binding ViewModel.CanUncheckSystemGpu}" />
                                </components:SettingsRow>
                                <components:SettingsRow
                                    Icon="{ui:SymbolIcon Apps24}"
                                    IsNested="True"
                                    Style="{StaticResource PerformanceParameterRowStyle}"
                                    Title="{DynamicResource Loc.Media.Metric.ProcessMemory.Title}">
                                    <ui:ToggleSwitch
                                        IsChecked="{Binding ViewModel.ShowProcessMemory, Mode=TwoWay}"
                                        IsEnabled="{Binding ViewModel.CanUncheckProcessMemory}" />
                                </components:SettingsRow>
                                <components:SettingsRow
                                    Description="{DynamicResource Loc.Media.Performance.RefreshInterval.Description}"
                                    Icon="{ui:SymbolIcon Timer24}"
                                    IsNested="True"
                                    Style="{StaticResource PerformanceParameterRowStyle}"
                                    Title="{DynamicResource Loc.Media.Performance.RefreshInterval.Title}">
                                    <StackPanel Orientation="Horizontal">
                                        <Slider
                                            IsSnapToTickEnabled="True"
                                            Maximum="{Binding ViewModel.MaximumPerformanceRefreshIntervalSeconds}"
                                            Minimum="{Binding ViewModel.MinimumPerformanceRefreshIntervalSeconds}"
                                            Style="{StaticResource AfSettingsRowSliderStyle}"
                                            TickFrequency="{Binding ViewModel.PerformanceRefreshIntervalStepSeconds}"
                                            Value="{Binding ViewModel.PerformanceRefreshIntervalSeconds, Mode=TwoWay}" />
                                        <TextBlock Style="{StaticResource AfSettingsRowValueStyle}" Text="{Binding ViewModel.PerformanceRefreshIntervalText}" />
                                    </StackPanel>
                                </components:SettingsRow>
                                <components:SettingsRow
                                    Description="{DynamicResource Loc.Media.Performance.OpenTaskManager.Description}"
                                    Icon="{ui:SymbolIcon CursorClick24}"
                                    IsNested="True"
                                    Style="{StaticResource PerformanceParameterRowStyle}"
                                    Title="{DynamicResource Loc.Media.Performance.OpenTaskManager.Title}">
                                    <ui:ToggleSwitch IsChecked="{Binding ViewModel.OpenTaskManagerOnMetricsClick, Mode=TwoWay}" />
                                </components:SettingsRow>
                            </StackPanel>
                        </ui:CardExpander>
                    </StackPanel>
                </components:SettingsGroup>

                <components:SettingsGroup Header="{DynamicResource Loc.Common.Group.TrackChangeNotification}" Icon="{ui:SymbolIcon MusicNote220}">
                    <StackPanel>
                        <components:SettingsRow
                            Description="{DynamicResource Loc.Media.Notification.Enabled.Description}"
                            Icon="{ui:SymbolIcon MusicNote220}"
                            Title="{DynamicResource Loc.Media.Notification.Enabled.Title}">
                            <ui:ToggleSwitch IsChecked="{Binding ViewModel.TrackChangeNotificationEnabled, Mode=TwoWay}" />
                        </components:SettingsRow>

                        <ui:CardExpander
                            Style="{StaticResource AfSettingsExpanderStyle}"
                            Icon="{ui:SymbolIcon Settings24}"
                            IsExpanded="{Binding ViewModel.TrackChangeNotificationEnabled, Mode=OneWay}">
                            <ui:CardExpander.Header>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource AfSettingsRowTitleStyle}" Text="{DynamicResource Loc.Media.Notification.Details.Title}" />
                                    <TextBlock Style="{StaticResource AfSettingsRowDescriptionStyle}" Text="{DynamicResource Loc.Media.Notification.Details.Description}" />
                                </StackPanel>
                            </ui:CardExpander.Header>
                            <StackPanel>
                                <components:SettingsDiagram Margin="0,0,0,12" Kind="NotificationPlacement" />

                                <components:SettingsRow
                                    Description="{DynamicResource Loc.Media.Notification.Fullscreen.Description}"
                                    Icon="{ui:SymbolIcon FullScreenMaximize24}"
                                    IsNested="True"
                                    Title="{DynamicResource Loc.Media.Notification.Fullscreen.Title}">
                                    <ui:ToggleSwitch IsChecked="{Binding ViewModel.ShowTrackChangeNotificationWhenFullscreen, Mode=TwoWay}" />
                                </components:SettingsRow>
                                <components:SettingsRow
                                    Icon="{ui:SymbolIcon Pin24}"
                                    IsNested="True"
                                    Title="{DynamicResource Loc.Media.Notification.Position.Title}">
                                    <ComboBox
                                        MinWidth="140"
                                        SelectedValue="{Binding ViewModel.TrackChangeNotificationPosition, Mode=TwoWay}"
                                        SelectedValuePath="Tag">
                                        <ComboBoxItem Content="{DynamicResource Loc.Media.Notification.Position.TopLeft}" Tag="{x:Static settings:TrackChangeNotificationPosition.TopLeft}" />
                                        <ComboBoxItem Content="{DynamicResource Loc.Media.Notification.Position.TopCenter}" Tag="{x:Static settings:TrackChangeNotificationPosition.TopCenter}" />
                                        <ComboBoxItem Content="{DynamicResource Loc.Media.Notification.Position.TopRight}" Tag="{x:Static settings:TrackChangeNotificationPosition.TopRight}" />
                                        <ComboBoxItem Content="{DynamicResource Loc.Media.Notification.Position.BottomLeft}" Tag="{x:Static settings:TrackChangeNotificationPosition.BottomLeft}" />
                                        <ComboBoxItem Content="{DynamicResource Loc.Media.Notification.Position.BottomCenter}" Tag="{x:Static settings:TrackChangeNotificationPosition.BottomCenter}" />
                                        <ComboBoxItem Content="{DynamicResource Loc.Media.Notification.Position.BottomRight}" Tag="{x:Static settings:TrackChangeNotificationPosition.BottomRight}" />
                                    </ComboBox>
                                </components:SettingsRow>
                                <components:SettingsRow
                                    Icon="{ui:SymbolIcon Timer24}"
                                    IsNested="True"
                                    Title="{DynamicResource Loc.Media.Notification.Duration.Title}">
                                    <StackPanel Orientation="Horizontal">
                                        <Slider
                                            IsSnapToTickEnabled="True"
                                            Maximum="10"
                                            Minimum="1"
                                            Style="{StaticResource AfSettingsRowSliderStyle}"
                                            TickFrequency="1"
                                            Value="{Binding ViewModel.TrackChangeNotificationDurationSeconds, Mode=TwoWay}" />
                                        <TextBlock Style="{StaticResource AfSettingsRowValueStyle}" Text="{Binding ViewModel.TrackChangeNotificationDurationText}" />
                                    </StackPanel>
                                </components:SettingsRow>
                                <components:SettingsRow
                                    Description="{DynamicResource Loc.Media.Notification.TargetMode.Description}"
                                    Icon="{ui:SymbolIcon ProjectionScreen24}"
                                    IsNested="True"
                                    Title="{DynamicResource Loc.Common.TargetMonitor}">
                                    <ComboBox
                                        MinWidth="200"
                                        SelectedValue="{Binding ViewModel.TrackChangeNotificationTargetMode, Mode=TwoWay}"
                                        SelectedValuePath="Tag">
                                        <ComboBoxItem Content="{DynamicResource Loc.Media.Notification.TargetMode.Fixed}" Tag="{x:Static settings:NotificationTargetMode.Fixed}" />
                                        <ComboBoxItem Content="{DynamicResource Loc.Media.Notification.TargetMode.ForegroundWindow}" Tag="{x:Static settings:NotificationTargetMode.ForegroundWindow}" />
                                    </ComboBox>
                                </components:SettingsRow>
                                <components:SettingsRow
                                    Icon="{ui:SymbolIcon Desktop24}"
                                    IsEnabled="{Binding ViewModel.CanSelectTrackChangeNotificationMonitor}"
                                    IsNested="True"
                                    Title="{DynamicResource Loc.Media.Notification.FixedMonitor.Title}">
                                    <ComboBox
                                        DisplayMemberPath="DisplayName"
                                        ItemsSource="{Binding ViewModel.MonitorOptions}"
                                        MinWidth="240"
                                        SelectedValue="{Binding ViewModel.TrackChangeNotificationFixedMonitorDeviceId, Mode=TwoWay}"
                                        SelectedValuePath="DeviceId" />
                                </components:SettingsRow>
                            </StackPanel>
                        </ui:CardExpander>
                    </StackPanel>
                </components:SettingsGroup>

                <ui:Button
                    Margin="0,16,0,40"
                    HorizontalAlignment="Left"
                    Click="ResetButton_Click"
                    Content="{DynamicResource Loc.Common.ResetPageDefaults}"
                    Icon="{ui:SymbolIcon ArrowReset24}"
                    Style="{StaticResource AfSettingsButtonStyle}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
