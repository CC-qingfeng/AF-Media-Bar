<Page x:Class="AFMediaBar.Views.Pages.ExtraFeaturesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:settings="clr-namespace:AFMediaBar.Classes.Settings"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <StackPanel MaxWidth="1000" Margin="16,16,24,32">
        <TextBlock Text="额外功能" FontSize="32" FontWeight="{DynamicResource AppTextStrongFontWeight}"/>
        <ui:TextBlock Text="管理不属于固定显示模式的通知与辅助体验" Appearance="Secondary" Margin="0,8,0,24"/>
        <TextBlock Text="曲目切换通知" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon MusicNote220}">
            <ui:CardControl.Header><StackPanel><TextBlock Text="显示刚切换到的当前曲目" FontWeight="SemiBold"/><TextBlock Text="这不是播放队列或下一首预览；首个快照只建立基线" Opacity="0.62" FontSize="12"/></StackPanel></ui:CardControl.Header>
            <ui:ToggleSwitch Content="启用通知" IsChecked="{Binding ViewModel.TrackChangeNotificationEnabled, Mode=TwoWay}"/>
        </ui:CardControl>
        <StackPanel IsEnabled="{Binding ViewModel.TrackChangeNotificationEnabled}" Margin="0,0,0,20">
            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Desktop24}"><ui:CardControl.Header><StackPanel><TextBlock Text="显示策略" FontWeight="SemiBold"/><TextBlock Text="默认在全屏窗口前抑制通知；鼠标进入通知会立即隐藏" Opacity="0.62" FontSize="12"/></StackPanel></ui:CardControl.Header><ui:ToggleSwitch Content="全屏时仍显示" IsChecked="{Binding ViewModel.ShowTrackChangeNotificationWhenFullscreen, Mode=TwoWay}"/></ui:CardControl>
            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon PositionToBack20}"><ui:CardControl.Header><StackPanel><TextBlock Text="位置与停留时间" FontWeight="SemiBold"/><TextBlock Text="通知使用目标显示器的工作区，避免覆盖任务栏" Opacity="0.62" FontSize="12"/></StackPanel></ui:CardControl.Header><StackPanel MinWidth="470"><ComboBox MinWidth="190" HorizontalAlignment="Left" SelectedValuePath="Tag" SelectedValue="{Binding ViewModel.TrackChangeNotificationPosition, Mode=TwoWay}"><ComboBoxItem Content="左上" Tag="{x:Static settings:TrackChangeNotificationPosition.TopLeft}"/><ComboBoxItem Content="中上" Tag="{x:Static settings:TrackChangeNotificationPosition.TopCenter}"/><ComboBoxItem Content="右上" Tag="{x:Static settings:TrackChangeNotificationPosition.TopRight}"/><ComboBoxItem Content="左下" Tag="{x:Static settings:TrackChangeNotificationPosition.BottomLeft}"/><ComboBoxItem Content="中下" Tag="{x:Static settings:TrackChangeNotificationPosition.BottomCenter}"/><ComboBoxItem Content="右下" Tag="{x:Static settings:TrackChangeNotificationPosition.BottomRight}"/></ComboBox><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Slider Width="260" Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding ViewModel.TrackChangeNotificationDurationSeconds, Mode=TwoWay}"/><TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding ViewModel.TrackChangeNotificationDurationSeconds, StringFormat={}{0} 秒}"/></StackPanel></StackPanel></ui:CardControl>
            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon ProjectionScreen24}"><ui:CardControl.Header><StackPanel><TextBlock Text="通知目标显示器" FontWeight="SemiBold"/><TextBlock Text="前台模式会在每次通知前重新解析；失败时回退到固定目标或主屏" Opacity="0.62" FontSize="12"/></StackPanel></ui:CardControl.Header><StackPanel MinWidth="470"><ComboBox MinWidth="220" HorizontalAlignment="Left" SelectedValuePath="Tag" SelectedValue="{Binding ViewModel.TrackChangeNotificationTargetMode, Mode=TwoWay}"><ComboBoxItem Content="固定显示器" Tag="{x:Static settings:NotificationTargetMode.Fixed}"/><ComboBoxItem Content="前台窗口所在显示器" Tag="{x:Static settings:NotificationTargetMode.ForegroundWindow}"/></ComboBox><ComboBox Margin="0,10,0,0" MinWidth="320" HorizontalAlignment="Left" ItemsSource="{Binding ViewModel.MonitorOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="DeviceId" IsEnabled="{Binding ViewModel.CanSelectTrackChangeNotificationMonitor}" SelectedValue="{Binding ViewModel.TrackChangeNotificationFixedMonitorDeviceId, Mode=TwoWay}"/></StackPanel></ui:CardControl>
        </StackPanel>
        <ui:Button Content="恢复本页默认设置" Icon="{ui:SymbolIcon ArrowReset24}" HorizontalAlignment="Left" Click="ResetButton_Click"/>
    </StackPanel>
</Page>
