<Page
    x:Class="AFMediaBar.Views.Pages.ExtraFeaturesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:AFMediaBar.Components"
    xmlns:settings="clr-namespace:AFMediaBar.Classes.Settings"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ScrollViewer.CanContentScroll="False">

    <!--
        媒体与通知页 / Media and notifications page

        排布规则：一行一个选项，一行恰好一个控件。列表用展开器承载，列表行仍然是一行一个来源；
        频谱与性能这种「一个开关 + 若干参数」的分组进展开器，展开体是同样的行。

        本页曾经把开关放在显示模式页、参数放在这里，也曾经把四个指标勾选框和满宽滑杆塞进同一张卡片；
        现在两项都改了：开关与参数同处一个展开器，指标各占一行。

        Layout rule: one option per row, exactly one control per row. Lists live behind expanders and each list
        row still holds one item; groups shaped like "one switch plus several parameters", such as the spectrum
        and performance components, become expanders whose body holds the same rows.

        This page used to keep the component switches on the display page while the parameters lived here, and to
        cram four metric checkboxes together with a full-width slider into one card. Both are fixed: each switch
        sits with its own parameters, and each metric gets its own row.
    -->

    <Page.Resources>
        <!--
            依赖未满足时才出现的徽章：组件关闭时它的参数行只读。
            父项开关就在行内，因此徽章只需要一句话。
            A badge that appears only while its dependency is unmet: a component's parameter rows are read-only
            while the component is off. The parent switch is on the same card, so one short phrase is enough.
        -->
        <Style
            x:Key="SpectrumParameterRowStyle"
            BasedOn="{StaticResource {x:Type components:SettingsRow}}"
            TargetType="{x:Type components:SettingsRow}">
            <Setter Property="Badge" Value="" />
            <Setter Property="IsEnabled" Value="{Binding ViewModel.SpectrumVisible}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ViewModel.SpectrumVisible}" Value="False">
                    <Setter Property="Badge" Value="需先启用" />
                    <Setter Property="BadgeTone" Value="Attention" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="PerformanceParameterRowStyle"
            BasedOn="{StaticResource {x:Type components:SettingsRow}}"
            TargetType="{x:Type components:SettingsRow}">
            <Setter Property="Badge" Value="" />
            <Setter Property="IsEnabled" Value="{Binding ViewModel.PerformanceVisible}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ViewModel.PerformanceVisible}" Value="False">
                    <Setter Property="Badge" Value="需先启用" />
                    <Setter Property="BadgeTone" Value="Attention" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <components:SettingsGroupStrip
            Grid.Row="0"
            Margin="{StaticResource AfSettingsHeaderMargin}"
            MaxWidth="{StaticResource AfSettingsContentMaxWidth}"
            PageIcon="{ui:SymbolIcon PuzzlePiece24}"
            Subtitle="媒体来源、快速启动、静置层组件与曲目通知"
            Target="{Binding ElementName=PageScroll}"
            Title="媒体与通知" />

        <ScrollViewer
            x:Name="PageScroll"
            Grid.Row="1"
            Margin="{StaticResource AfSettingsScrollMargin}"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                x:Name="PageRoot"
                MaxWidth="{StaticResource AfSettingsContentMaxWidth}"
                Loaded="OnPageLoaded">

                <components:SettingsGroup Header="媒体来源" Icon="{ui:SymbolIcon Filter24}">
                    <StackPanel>
                        <components:SettingsRow
                            Description="仅接收列表内的应用；关闭后列表仍然保留"
                            Icon="{ui:SymbolIcon Filter24}"
                            Title="来源允许列表">
                            <ui:ToggleSwitch IsChecked="{Binding ViewModel.SmtcFilterEnabled, Mode=TwoWay}" />
                        </components:SettingsRow>

                        <ui:CardExpander
                            Style="{StaticResource AfSettingsExpanderStyle}"
                            Icon="{ui:SymbolIcon AppsList24}"
                            IsExpanded="True">
                            <ui:CardExpander.Header>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource AfSettingsRowTitleStyle}" Text="已检测来源" />
                                    <TextBlock Style="{StaticResource AfSettingsRowDescriptionStyle}" Text="先运行一次播放器，它才会出现在这里" />
                                </StackPanel>
                            </ui:CardExpander.Header>
                            <ItemsControl ItemsSource="{Binding ViewModel.Sources}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <components:SettingsRow
                                            Description="{Binding Descriptor.SourceId}"
                                            IsNested="True"
                                            Title="{Binding Descriptor.DisplayName}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:ToggleSwitch
                                                    Content="允许"
                                                    IsChecked="{Binding IsAllowed, Mode=TwoWay}" />
                                                <ui:Button
                                                    Margin="12,0,0,0"
                                                    Command="{Binding DataContext.ViewModel.AddDetectedSourceCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    Content="加入快速启动"
                                                    IsEnabled="{Binding Descriptor.CanQuickLaunch}"
                                                    Style="{StaticResource AfSettingsButtonStyle}"
                                                    ToolTip="只有能自动找到启动方式的播放器才能加入；找不到时请用「浏览程序或快捷方式」。"
                                                    ToolTipService.ShowOnDisabled="True" />
                                            </StackPanel>
                                        </components:SettingsRow>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ui:CardExpander>
                    </StackPanel>
                </components:SettingsGroup>

                <components:SettingsGroup Header="快速启动" Icon="{ui:SymbolIcon Rocket24}">
                    <StackPanel>
                        <components:SettingsRow
                            Description="点击音符打开快速启动列表；滚轮预览，停止约 1.2 秒后启动最后一项"
                            Icon="{ui:SymbolIcon Rocket24}"
                            Title="无媒体时从音符启动">
                            <ui:Button
                                Click="BrowseQuickLaunch_Click"
                                Content="浏览程序或快捷方式"
                                Icon="{ui:SymbolIcon FolderOpen24}"
                                Style="{StaticResource AfSettingsButtonStyle}" />
                        </components:SettingsRow>

                        <components:SettingsRow
                            Description="调整顺序只影响本列表的启动优先级"
                            Icon="{ui:SymbolIcon AppsListDetail24}"
                            Title="已添加的启动项">
                            <TextBlock
                                Style="{StaticResource AfSettingsRowValueStyle}"
                                Text="{Binding ViewModel.QuickLaunchEntries.Count, StringFormat={}{0} 项}" />
                        </components:SettingsRow>

                        <ItemsControl Margin="0,0,0,4" ItemsSource="{Binding ViewModel.QuickLaunchEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <components:SettingsRow
                                        Description="{Binding Target}"
                                        IsNested="True"
                                        Title="{Binding DisplayName}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:Button
                                                Command="{Binding DataContext.ViewModel.MoveQuickLaunchUpCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"
                                                Icon="{ui:SymbolIcon ArrowUp24}"
                                                Style="{StaticResource AfSettingsIconButtonStyle}"
                                                ToolTip="上移一位" />
                                            <ui:Button
                                                Margin="4,0,0,0"
                                                Command="{Binding DataContext.ViewModel.MoveQuickLaunchDownCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"
                                                Icon="{ui:SymbolIcon ArrowDown24}"
                                                Style="{StaticResource AfSettingsIconButtonStyle}"
                                                ToolTip="下移一位" />
                                            <ui:Button
                                                Margin="4,0,0,0"
                                                Command="{Binding DataContext.ViewModel.RemoveQuickLaunchCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"
                                                Icon="{ui:SymbolIcon Delete24}"
                                                Style="{StaticResource AfSettingsIconButtonStyle}"
                                                ToolTip="从快速启动中移除" />
                                        </StackPanel>
                                    </components:SettingsRow>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock
                            Margin="0,4,0,0"
                            Style="{StaticResource AfSettingsHintTextStyle}"
                            Text="{Binding ViewModel.StatusText}" />
                    </StackPanel>
                </components:SettingsGroup>

                <components:SettingsGroup
                    Description="叠加在静置层右侧的两个小组件"
                    Header="静置层组件"
                    Icon="{ui:SymbolIcon DataHistogram24}">
                    <StackPanel>
                        <components:SettingsDiagram Margin="0,0,0,12" Kind="Spectrum" />

                        <components:SettingsRow
                            Description="在静置层右侧显示实时音频频谱"
                            Icon="{ui:SymbolIcon DataHistogram24}"
                            Title="显示频谱">
                            <ui:ToggleSwitch IsChecked="{Binding ViewModel.SpectrumVisible, Mode=TwoWay}" />
                        </components:SettingsRow>

                        <ui:CardExpander
                            Style="{StaticResource AfSettingsExpanderStyle}"
                            Icon="{ui:SymbolIcon DataBarVertical24}"
                            IsExpanded="{Binding ViewModel.SpectrumVisible, Mode=OneWay}">
                            <ui:CardExpander.Header>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource AfSettingsRowTitleStyle}" Text="频谱参数" />
                                    <TextBlock Style="{StaticResource AfSettingsRowDescriptionStyle}" Text="柱数、刷新率与灵敏度" />
                                </StackPanel>
                            </ui:CardExpander.Header>
                            <StackPanel>
                                <components:SettingsRow
                                    Description="频谱的绘制方式，不改变柱数与占用宽度"
                                    Icon="{ui:SymbolIcon PaintBrush24}"
                                    IsNested="True"
                                    Style="{StaticResource SpectrumParameterRowStyle}"
                                    Title="样式">
                                    <ComboBox
                                        MinWidth="160"
                                        SelectedValue="{Binding ViewModel.SpectrumStyle, Mode=TwoWay}"
                                        SelectedValuePath="Tag">
                                        <ComboBoxItem Content="柱状图" Tag="{x:Static settings:SpectrumStyle.Bars}" />
                                        <ComboBoxItem Content="波形图" Tag="{x:Static settings:SpectrumStyle.Waveform}" />
                                        <ComboBoxItem Content="像素柱状图" Tag="{x:Static settings:SpectrumStyle.PixelBars}" />
                                        <ComboBoxItem Content="上下对称柱状图" Tag="{x:Static settings:SpectrumStyle.MirroredBars}" />
                                    </ComboBox>
                                </components:SettingsRow>
                                <components:SettingsRow
                                    Description="频谱柱的数量（9–24）；柱宽固定，柱数越多频谱越宽"
                                    Icon="{ui:SymbolIcon DataBarVertical24}"
                                    IsNested="True"
                                    Style="{StaticResource SpectrumParameterRowStyle}"
                                    Title="柱数">
                                    <StackPanel Orientation="Horizontal">
                                        <Slider
                                            IsSnapToTickEnabled="True"
                                            Maximum="{Binding ViewModel.MaximumSpectrumBandCount}"
                                            Minimum="{Binding ViewModel.MinimumSpectrumBandCount}"
                                            Style="{StaticResource AfSettingsRowSliderStyle}"
                                            TickFrequency="1"
                                            Value="{Binding ViewModel.SpectrumBandCount, Mode=TwoWay}" />
                                        <TextBlock Style="{StaticResource AfSettingsRowValueStyle}" Text="{Binding ViewModel.SpectrumBandCount, StringFormat={}{0} 根}" />
                                    </StackPanel>
                                </components:SettingsRow>
                                <components:SettingsRow
                                    Description="频谱刷新频率（5–30 Hz）"
                                    Icon="{ui:SymbolIcon Timer24}"
                                    IsNested="True"
                                    Style="{StaticResource SpectrumParameterRowStyle}"
                                    Title="刷新率">
                                    <StackPanel Orientation="Horizontal">
                                        <Slider
                                            IsSnapToTickEnabled="True"
                                            Maximum="30"
                                            Minimum="5"
                                            Style="{StaticResource AfSettingsRowSliderStyle}"
                                            TickFrequency="1"
                                            Value="{Binding ViewModel.SpectrumRefreshRateHz, Mode=TwoWay}" />
                                        <TextBlock Style="{StaticResource AfSettingsRowValueStyle}" Text="{Binding ViewModel.SpectrumRefreshRateHz, StringFormat={}{0} Hz}" />
                                    </StackPanel>
                                </components:SettingsRow>
                                <components:SettingsRow
                                    Description="频谱柱达到最大高度时对应的音频音量"
                                    Icon="{ui:SymbolIcon TopSpeed24}"
                                    IsNested="True"
                                    Style="{StaticResource SpectrumParameterRowStyle}"
                                    Title="灵敏度">
                                    <StackPanel Orientation="Horizontal">
                                        <Slider
                                            IsSnapToTickEnabled="True"
                                            Maximum="400"
                                            Minimum="1"
                                            Style="{StaticResource AfSettingsRowSliderStyle}"
                                            TickFrequency="1"
                                            Value="{Binding ViewModel.SpectrumSensitivityPercent, Mode=TwoWay}" />
                                        <TextBlock Style="{StaticResource AfSettingsRowValueStyle}" Text="{Binding ViewModel.SpectrumSensitivityPercent, StringFormat={}{0}%}" />
                                    </StackPanel>
                                </components:SettingsRow>
                            </StackPanel>
                        </ui:CardExpander>

                        <components:SettingsRow
                            Description="在静置层右侧轮换显示选中的指标"
                            Icon="{ui:SymbolIcon Gauge24}"
                            Title="显示性能组件">
                            <ui:ToggleSwitch IsChecked="{Binding ViewModel.PerformanceVisible, Mode=TwoWay}" />
                        </components:SettingsRow>

                        <ui:CardExpander
                            Style="{StaticResource AfSettingsExpanderStyle}"
                            Icon="{ui:SymbolIcon Gauge24}"
                            IsExpanded="{Binding ViewModel.PerformanceVisible, Mode=OneWay}">
                            <ui:CardExpander.Header>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource AfSettingsRowTitleStyle}" Text="显示哪些指标" />
                                    <TextBlock Style="{StaticResource AfSettingsRowDescriptionStyle}" Text="选中多个时轮流显示" />
                                </StackPanel>
                            </ui:CardExpander.Header>
                            <StackPanel>
                                <components:SettingsRow
                                    Description="至少保留一项，最后一项无法取消"
                                    Icon="{ui:SymbolIcon Storage24}"
                                    IsNested="True"
                                    Style="{StaticResource PerformanceParameterRowStyle}"
                                    Title="系统内存">
                                    <ui:ToggleSwitch
                                        IsChecked="{Binding ViewModel.ShowSystemMemory, Mode=TwoWay}"
                                        IsEnabled="{Binding ViewModel.CanUncheckSystemMemory}" />
                                </components:SettingsRow>
                                <components:SettingsRow
                                    Icon="{ui:SymbolIcon DeveloperBoard24}"
                                    IsNested="True"
                                    Style="{StaticResource PerformanceParameterRowStyle}"
                                    Title="CPU">
                                    <ui:ToggleSwitch
                                        IsChecked="{Binding ViewModel.ShowSystemCpu, Mode=TwoWay}"
                                        IsEnabled="{Binding ViewModel.CanUncheckSystemCpu}" />
                                </components:SettingsRow>
                                <components:SettingsRow
                                    Icon="{ui:SymbolIcon VideoClip24}"
                                    IsNested="True"
                                    Style="{StaticResource PerformanceParameterRowStyle}"
                                    Title="GPU">
                                    <ui:ToggleSwitch
                                        IsChecked="{Binding ViewModel.ShowSystemGpu, Mode=TwoWay}"
                                        IsEnabled="{Binding ViewModel.CanUncheckSystemGpu}" />
                                </components:SettingsRow>
                                <components:SettingsRow
                                    Icon="{ui:SymbolIcon Apps24}"
                                    IsNested="True"
                                    Style="{StaticResource PerformanceParameterRowStyle}"
                                    Title="本程序内存">
                                    <ui:ToggleSwitch
                                        IsChecked="{Binding ViewModel.ShowProcessMemory, Mode=TwoWay}"
                                        IsEnabled="{Binding ViewModel.CanUncheckProcessMemory}" />
                                </components:SettingsRow>
                                <components:SettingsRow
                                    Description="采样间隔，越小越灵敏（0.5–5 秒）"
                                    Icon="{ui:SymbolIcon Timer24}"
                                    IsNested="True"
                                    Style="{StaticResource PerformanceParameterRowStyle}"
                                    Title="刷新间隔">
                                    <StackPanel Orientation="Horizontal">
                                        <Slider
                                            IsSnapToTickEnabled="True"
                                            Maximum="{Binding ViewModel.MaximumPerformanceRefreshIntervalSeconds}"
                                            Minimum="{Binding ViewModel.MinimumPerformanceRefreshIntervalSeconds}"
                                            Style="{StaticResource AfSettingsRowSliderStyle}"
                                            TickFrequency="{Binding ViewModel.PerformanceRefreshIntervalStepSeconds}"
                                            Value="{Binding ViewModel.PerformanceRefreshIntervalSeconds, Mode=TwoWay}" />
                                        <TextBlock Style="{StaticResource AfSettingsRowValueStyle}" Text="{Binding ViewModel.PerformanceRefreshIntervalSeconds, StringFormat={}{0:0.#} 秒}" />
                                    </StackPanel>
                                </components:SettingsRow>
                                <components:SettingsRow
                                    Description="关闭后点击性能组件不执行任何操作"
                                    Icon="{ui:SymbolIcon CursorClick24}"
                                    IsNested="True"
                                    Style="{StaticResource PerformanceParameterRowStyle}"
                                    Title="点击性能组件时打开任务管理器">
                                    <ui:ToggleSwitch IsChecked="{Binding ViewModel.OpenTaskManagerOnMetricsClick, Mode=TwoWay}" />
                                </components:SettingsRow>
                            </StackPanel>
                        </ui:CardExpander>
                    </StackPanel>
                </components:SettingsGroup>

                <components:SettingsGroup Header="曲目切换通知" Icon="{ui:SymbolIcon MusicNote220}">
                    <StackPanel>
                        <components:SettingsRow
                            Description="曲目切换并开始播放时显示当前曲目"
                            Icon="{ui:SymbolIcon MusicNote220}"
                            Title="启用通知">
                            <ui:ToggleSwitch IsChecked="{Binding ViewModel.TrackChangeNotificationEnabled, Mode=TwoWay}" />
                        </components:SettingsRow>

                        <ui:CardExpander
                            Style="{StaticResource AfSettingsExpanderStyle}"
                            Icon="{ui:SymbolIcon Settings24}"
                            IsExpanded="{Binding ViewModel.TrackChangeNotificationEnabled, Mode=OneWay}">
                            <ui:CardExpander.Header>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource AfSettingsRowTitleStyle}" Text="通知细节" />
                                    <TextBlock Style="{StaticResource AfSettingsRowDescriptionStyle}" Text="选择位置、停留时间与目标显示器" />
                                </StackPanel>
                            </ui:CardExpander.Header>
                            <StackPanel>
                                <components:SettingsDiagram Margin="0,0,0,12" Kind="NotificationPlacement" />

                                <components:SettingsRow
                                    Description="默认在全屏窗口前抑制通知"
                                    Icon="{ui:SymbolIcon FullScreenMaximize24}"
                                    IsNested="True"
                                    Title="全屏时仍然显示">
                                    <ui:ToggleSwitch IsChecked="{Binding ViewModel.ShowTrackChangeNotificationWhenFullscreen, Mode=TwoWay}" />
                                </components:SettingsRow>
                                <components:SettingsRow
                                    Icon="{ui:SymbolIcon Pin24}"
                                    IsNested="True"
                                    Title="显示位置">
                                    <ComboBox
                                        MinWidth="140"
                                        SelectedValue="{Binding ViewModel.TrackChangeNotificationPosition, Mode=TwoWay}"
                                        SelectedValuePath="Tag">
                                        <ComboBoxItem Content="左上" Tag="{x:Static settings:TrackChangeNotificationPosition.TopLeft}" />
                                        <ComboBoxItem Content="中上" Tag="{x:Static settings:TrackChangeNotificationPosition.TopCenter}" />
                                        <ComboBoxItem Content="右上" Tag="{x:Static settings:TrackChangeNotificationPosition.TopRight}" />
                                        <ComboBoxItem Content="左下" Tag="{x:Static settings:TrackChangeNotificationPosition.BottomLeft}" />
                                        <ComboBoxItem Content="中下" Tag="{x:Static settings:TrackChangeNotificationPosition.BottomCenter}" />
                                        <ComboBoxItem Content="右下" Tag="{x:Static settings:TrackChangeNotificationPosition.BottomRight}" />
                                    </ComboBox>
                                </components:SettingsRow>
                                <components:SettingsRow
                                    Icon="{ui:SymbolIcon Timer24}"
                                    IsNested="True"
                                    Title="停留时间">
                                    <StackPanel Orientation="Horizontal">
                                        <Slider
                                            IsSnapToTickEnabled="True"
                                            Maximum="10"
                                            Minimum="1"
                                            Style="{StaticResource AfSettingsRowSliderStyle}"
                                            TickFrequency="1"
                                            Value="{Binding ViewModel.TrackChangeNotificationDurationSeconds, Mode=TwoWay}" />
                                        <TextBlock Style="{StaticResource AfSettingsRowValueStyle}" Text="{Binding ViewModel.TrackChangeNotificationDurationSeconds, StringFormat={}{0} 秒}" />
                                    </StackPanel>
                                </components:SettingsRow>
                                <components:SettingsRow
                                    Description="固定显示器，或跟随前台窗口所在显示器"
                                    Icon="{ui:SymbolIcon ProjectionScreen24}"
                                    IsNested="True"
                                    Title="目标显示器">
                                    <ComboBox
                                        MinWidth="200"
                                        SelectedValue="{Binding ViewModel.TrackChangeNotificationTargetMode, Mode=TwoWay}"
                                        SelectedValuePath="Tag">
                                        <ComboBoxItem Content="固定显示器" Tag="{x:Static settings:NotificationTargetMode.Fixed}" />
                                        <ComboBoxItem Content="跟随前台窗口所在显示器" Tag="{x:Static settings:NotificationTargetMode.ForegroundWindow}" />
                                    </ComboBox>
                                </components:SettingsRow>
                                <components:SettingsRow
                                    Icon="{ui:SymbolIcon Desktop24}"
                                    IsEnabled="{Binding ViewModel.CanSelectTrackChangeNotificationMonitor}"
                                    IsNested="True"
                                    Title="固定到哪一块显示器">
                                    <ComboBox
                                        DisplayMemberPath="DisplayName"
                                        ItemsSource="{Binding ViewModel.MonitorOptions}"
                                        MinWidth="240"
                                        SelectedValue="{Binding ViewModel.TrackChangeNotificationFixedMonitorDeviceId, Mode=TwoWay}"
                                        SelectedValuePath="DeviceId" />
                                </components:SettingsRow>
                            </StackPanel>
                        </ui:CardExpander>
                    </StackPanel>
                </components:SettingsGroup>

                <ui:Button
                    Margin="0,16,0,40"
                    HorizontalAlignment="Left"
                    Click="ResetButton_Click"
                    Content="恢复本页默认设置"
                    Icon="{ui:SymbolIcon ArrowReset24}"
                    Style="{StaticResource AfSettingsButtonStyle}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
