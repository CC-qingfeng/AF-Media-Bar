<Page
    x:Class="AFMediaBar.Views.Pages.ExtraFeaturesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="clr-namespace:AFMediaBar.Classes.Settings"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <!--
        额外功能页 / Extra features page

        四个分组、全部选项和绑定保持不变。改动集中在：
        字段标签换成语义化角色；来源列表和快速启动列表的每一行增加悬停底色与等高图标按钮；
        频谱和性能的滑杆补上数值读出（以前只能靠拖动猜测当前值）；
        并新增两张矢量说明图解释频谱柱和通知锚点。
        Four groups keep every option and binding. Field labels become a semantic role, source and quick-launch
        rows get a hover fill and equal-size icon buttons, the spectrum and performance sliders gain a numeric
        readout (previously the only way to know the value was to drag it), and two vector diagrams explain the
        spectrum bars and the notification anchors.
    -->
    <StackPanel
        x:Name="PageRoot"
        MaxWidth="{StaticResource AfSettingsContentMaxWidth}"
        Margin="{StaticResource AfSettingsPageMargin}"
        Loaded="OnPageLoaded">

        <TextBlock Style="{StaticResource AfSettingsPageTitleStyle}" Text="额外功能" />
        <TextBlock Style="{StaticResource AfSettingsPageSubtitleStyle}" Text="管理媒体来源、任务栏附加组件与通知体验" />

        <ContentControl
            Margin="0,0,0,12"
            Content="媒体来源"
            ContentTemplate="{StaticResource AfSettingsSectionHeaderTemplate}" />

        <ui:CardControl Margin="{StaticResource AfSettingsCardGap}">
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="Filter24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource AfSettingsCardTitleStyle}" Text="SMTC 来源过滤" />
                    <TextBlock
                        Style="{StaticResource AfSettingsCardDescriptionStyle}"
                        Text="开启后只接收下方允许的应用；同一浏览器的多个会话使用同一个来源规则" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch Content="启用允许列表" IsChecked="{Binding ViewModel.SmtcFilterEnabled, Mode=TwoWay}" />
        </ui:CardControl>

        <ui:CardControl Margin="{StaticResource AfSettingsCardGapLast}">
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="AppsList24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource AfSettingsCardTitleStyle}" Text="已检测来源" />
                    <TextBlock
                        Style="{StaticResource AfSettingsCardDescriptionStyle}"
                        Text="先运行一次播放器即可在这里允许来源或加入快速启动" />
                </StackPanel>
            </ui:CardControl.Header>
            <ItemsControl MinWidth="{StaticResource AfSettingsFieldWidth}" ItemsSource="{Binding ViewModel.Sources}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource AfSettingsRowStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock
                                        FontSize="13"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="{Binding Descriptor.DisplayName}" />
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{Binding Descriptor.SourceId}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <CheckBox
                                    Grid.Column="1"
                                    Margin="12,0"
                                    VerticalAlignment="Center"
                                    Content="允许"
                                    IsChecked="{Binding IsAllowed, Mode=TwoWay}" />
                                <ui:Button
                                    Grid.Column="2"
                                    Content="加入快速启动"
                                    IsEnabled="{Binding Descriptor.CanQuickLaunch}"
                                    Command="{Binding DataContext.ViewModel.AddDetectedSourceCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource AfSettingsButtonStyle}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ui:CardControl>

        <ContentControl
            Margin="0,0,0,12"
            Content="快速启动"
            ContentTemplate="{StaticResource AfSettingsSectionHeaderTemplate}" />

        <ui:CardControl Margin="{StaticResource AfSettingsCardGapLast}">
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="Rocket24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource AfSettingsCardTitleStyle}" Text="无媒体时从音符启动播放器" />
                    <TextBlock
                        Style="{StaticResource AfSettingsCardDescriptionStyle}"
                        Text="单击音符打开列表；滚轮停止 1.2 秒后启动最后预览项" />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel MinWidth="{StaticResource AfSettingsFieldWidth}">
                <ui:Button
                    HorizontalAlignment="Left"
                    Click="BrowseQuickLaunch_Click"
                    Content="浏览 EXE 或 LNK"
                    Icon="{ui:SymbolIcon FolderOpen24}"
                    Style="{StaticResource AfSettingsButtonStyle}" />
                <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding ViewModel.QuickLaunchEntries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource AfSettingsRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="13"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Text="{Binding DisplayName}" />
                                        <TextBlock
                                            FontSize="10"
                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                            Text="{Binding Target}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <ui:Button
                                        Grid.Column="1"
                                        Icon="{ui:SymbolIcon ArrowUp24}"
                                        Command="{Binding DataContext.ViewModel.MoveQuickLaunchUpCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource AfSettingsIconButtonStyle}" />
                                    <ui:Button
                                        Grid.Column="2"
                                        Margin="4,0,0,0"
                                        Icon="{ui:SymbolIcon ArrowDown24}"
                                        Command="{Binding DataContext.ViewModel.MoveQuickLaunchDownCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource AfSettingsIconButtonStyle}" />
                                    <ui:Button
                                        Grid.Column="3"
                                        Margin="4,0,0,0"
                                        Icon="{ui:SymbolIcon Delete24}"
                                        Command="{Binding DataContext.ViewModel.RemoveQuickLaunchCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource AfSettingsIconButtonStyle}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock
                    Margin="0,6,0,0"
                    Style="{StaticResource AfSettingsHintTextStyle}"
                    Text="{Binding ViewModel.StatusText}" />
            </StackPanel>
        </ui:CardControl>

        <ContentControl
            Margin="0,0,0,12"
            Content="任务栏附加组件"
            ContentTemplate="{StaticResource AfSettingsSectionHeaderTemplate}" />

        <ContentControl
            Margin="0,0,0,8"
            ContentTemplate="{StaticResource AfDiagramSpectrum}" />

        <ui:CardControl Margin="{StaticResource AfSettingsCardGap}">
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="DataHistogram24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource AfSettingsCardTitleStyle}" Text="频谱" />
                    <TextBlock
                        Style="{StaticResource AfSettingsCardDescriptionStyle}"
                        Text="频谱默认启用，仅在媒体播放时显示" />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel MinWidth="{StaticResource AfSettingsFieldWidth}">
                <TextBlock
                    Margin="{StaticResource AfSettingsFieldLabelGap}"
                    Style="{StaticResource AfSettingsFieldLabelStyle}"
                    Text="柱数" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Slider
                        IsSnapToTickEnabled="True"
                        Maximum="9"
                        Minimum="1"
                        TickFrequency="1"
                        Value="{Binding ViewModel.SpectrumBandCount, Mode=TwoWay}" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="12,0,0,0"
                        Style="{StaticResource AfSettingsFieldValueStyle}"
                        Text="{Binding ViewModel.SpectrumBandCount}" />
                </Grid>
                <TextBlock
                    Margin="0,10,0,6"
                    Style="{StaticResource AfSettingsFieldLabelStyle}"
                    Text="刷新率（Hz）" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Slider
                        IsSnapToTickEnabled="True"
                        Maximum="30"
                        Minimum="5"
                        TickFrequency="1"
                        Value="{Binding ViewModel.SpectrumRefreshRateHz, Mode=TwoWay}" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="12,0,0,0"
                        Style="{StaticResource AfSettingsFieldValueStyle}"
                        Text="{Binding ViewModel.SpectrumRefreshRateHz}" />
                </Grid>
                <TextBlock
                    Margin="0,10,0,6"
                    Style="{StaticResource AfSettingsFieldLabelStyle}"
                    Text="灵敏度（%）" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Slider
                        IsSnapToTickEnabled="True"
                        Maximum="400"
                        Minimum="1"
                        TickFrequency="1"
                        Value="{Binding ViewModel.SpectrumSensitivityPercent, Mode=TwoWay}" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="12,0,0,0"
                        Style="{StaticResource AfSettingsFieldValueStyle}"
                        Text="{Binding ViewModel.SpectrumSensitivityPercent, StringFormat={}{0}%}" />
                </Grid>
            </StackPanel>
        </ui:CardControl>

        <ui:CardControl Margin="{StaticResource AfSettingsCardGapLast}">
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="Gauge24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource AfSettingsCardTitleStyle}" Text="性能" />
                    <TextBlock
                        Style="{StaticResource AfSettingsCardDescriptionStyle}"
                        Text="组件默认启用，每三个采样周期轮换一次选中指标" />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel MinWidth="{StaticResource AfSettingsFieldWidth}">
                <WrapPanel>
                    <CheckBox
                        Margin="0,0,14,0"
                        Content="系统内存"
                        IsChecked="{Binding ViewModel.ShowSystemMemory, Mode=TwoWay}" />
                    <CheckBox
                        Margin="0,0,14,0"
                        Content="CPU"
                        IsChecked="{Binding ViewModel.ShowSystemCpu, Mode=TwoWay}" />
                    <CheckBox
                        Margin="0,0,14,0"
                        Content="GPU"
                        IsChecked="{Binding ViewModel.ShowSystemGpu, Mode=TwoWay}" />
                    <CheckBox Content="本程序内存" IsChecked="{Binding ViewModel.ShowProcessMemory, Mode=TwoWay}" />
                </WrapPanel>
                <TextBlock
                    Margin="0,10,0,6"
                    Style="{StaticResource AfSettingsFieldLabelStyle}"
                    Text="刷新间隔（毫秒）" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Slider
                        IsSnapToTickEnabled="True"
                        Maximum="60000"
                        Minimum="250"
                        TickFrequency="250"
                        Value="{Binding ViewModel.PerformanceRefreshIntervalMilliseconds, Mode=TwoWay}" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="12,0,0,0"
                        Style="{StaticResource AfSettingsFieldValueStyle}"
                        Text="{Binding ViewModel.PerformanceRefreshIntervalMilliseconds}" />
                </Grid>
                <ui:ToggleSwitch
                    Margin="0,10,0,0"
                    Content="点击性能组件打开任务管理器"
                    IsChecked="{Binding ViewModel.OpenTaskManagerOnMetricsClick, Mode=TwoWay}" />
            </StackPanel>
        </ui:CardControl>

        <ContentControl
            Margin="0,0,0,12"
            Content="曲目切换通知"
            ContentTemplate="{StaticResource AfSettingsSectionHeaderTemplate}" />

        <ui:CardControl Margin="{StaticResource AfSettingsCardGap}">
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="MusicNote220" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource AfSettingsCardTitleStyle}" Text="显示刚切换到的当前曲目" />
                    <TextBlock
                        Style="{StaticResource AfSettingsCardDescriptionStyle}"
                        Text="这不是播放队列或下一首预览；首个快照只建立基线" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch Content="启用通知" IsChecked="{Binding ViewModel.TrackChangeNotificationEnabled, Mode=TwoWay}" />
        </ui:CardControl>

        <StackPanel IsEnabled="{Binding ViewModel.TrackChangeNotificationEnabled}">
            <ui:CardControl Margin="{StaticResource AfSettingsCardGap}">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="Desktop24" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource AfSettingsCardTitleStyle}" Text="显示策略" />
                        <TextBlock
                            Style="{StaticResource AfSettingsCardDescriptionStyle}"
                            Text="默认在全屏窗口前抑制通知；鼠标进入通知会立即隐藏" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch Content="全屏时仍显示" IsChecked="{Binding ViewModel.ShowTrackChangeNotificationWhenFullscreen, Mode=TwoWay}" />
            </ui:CardControl>

            <ContentControl
                Margin="0,0,0,8"
                ContentTemplate="{StaticResource AfDiagramNotificationPlacement}" />

            <ui:CardControl Margin="{StaticResource AfSettingsCardGap}">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="PositionToBack20" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource AfSettingsCardTitleStyle}" Text="位置与停留时间" />
                        <TextBlock
                            Style="{StaticResource AfSettingsCardDescriptionStyle}"
                            Text="通知使用目标显示器的工作区，避免覆盖任务栏" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel MinWidth="{StaticResource AfSettingsFieldWidth}">
                    <ComboBox
                        HorizontalAlignment="Left"
                        MinWidth="{StaticResource AfSettingsSelectMinWidth}"
                        SelectedValue="{Binding ViewModel.TrackChangeNotificationPosition, Mode=TwoWay}"
                        SelectedValuePath="Tag">
                        <ComboBoxItem Content="左上" Tag="{x:Static settings:TrackChangeNotificationPosition.TopLeft}" />
                        <ComboBoxItem Content="中上" Tag="{x:Static settings:TrackChangeNotificationPosition.TopCenter}" />
                        <ComboBoxItem Content="右上" Tag="{x:Static settings:TrackChangeNotificationPosition.TopRight}" />
                        <ComboBoxItem Content="左下" Tag="{x:Static settings:TrackChangeNotificationPosition.BottomLeft}" />
                        <ComboBoxItem Content="中下" Tag="{x:Static settings:TrackChangeNotificationPosition.BottomCenter}" />
                        <ComboBoxItem Content="右下" Tag="{x:Static settings:TrackChangeNotificationPosition.BottomRight}" />
                    </ComboBox>
                    <TextBlock
                        Margin="0,12,0,6"
                        Style="{StaticResource AfSettingsFieldLabelStyle}"
                        Text="停留时间" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider
                            IsSnapToTickEnabled="True"
                            Maximum="10"
                            Minimum="1"
                            TickFrequency="1"
                            Value="{Binding ViewModel.TrackChangeNotificationDurationSeconds, Mode=TwoWay}" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            Style="{StaticResource AfSettingsFieldValueStyle}"
                            Text="{Binding ViewModel.TrackChangeNotificationDurationSeconds, StringFormat={}{0} 秒}" />
                    </Grid>
                </StackPanel>
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,0">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="ProjectionScreen24" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource AfSettingsCardTitleStyle}" Text="通知目标显示器" />
                        <TextBlock
                            Style="{StaticResource AfSettingsCardDescriptionStyle}"
                            Text="前台模式会在每次通知前重新解析；失败时回退到固定目标或主屏" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel MinWidth="{StaticResource AfSettingsFieldWidth}">
                    <ComboBox
                        HorizontalAlignment="Left"
                        MinWidth="{StaticResource AfSettingsSelectMinWidth}"
                        SelectedValue="{Binding ViewModel.TrackChangeNotificationTargetMode, Mode=TwoWay}"
                        SelectedValuePath="Tag">
                        <ComboBoxItem Content="固定显示器" Tag="{x:Static settings:NotificationTargetMode.Fixed}" />
                        <ComboBoxItem Content="前台窗口所在显示器" Tag="{x:Static settings:NotificationTargetMode.ForegroundWindow}" />
                    </ComboBox>
                    <ComboBox
                        Margin="0,10,0,0"
                        HorizontalAlignment="Left"
                        IsEnabled="{Binding ViewModel.CanSelectTrackChangeNotificationMonitor}"
                        ItemsSource="{Binding ViewModel.MonitorOptions}"
                        DisplayMemberPath="DisplayName"
                        MinWidth="{StaticResource AfSettingsFieldWidthWide}"
                        SelectedValue="{Binding ViewModel.TrackChangeNotificationFixedMonitorDeviceId, Mode=TwoWay}"
                        SelectedValuePath="DeviceId" />
                </StackPanel>
            </ui:CardControl>
        </StackPanel>

        <ui:Button
            Margin="0,18,0,0"
            HorizontalAlignment="Left"
            Click="ResetButton_Click"
            Content="恢复本页默认设置"
            Icon="{ui:SymbolIcon ArrowReset24}"
            Style="{StaticResource AfSettingsButtonStyle}" />
    </StackPanel>
</Page>
