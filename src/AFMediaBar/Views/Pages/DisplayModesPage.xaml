<Page
    x:Class="AFMediaBar.Views.Pages.DisplayModesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:AFMediaBar.Components"
    xmlns:settings="clr-namespace:AFMediaBar.Classes.Settings"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ScrollViewer.CanContentScroll="False">

    <!--
        显示模式页 / Display modes page

        本页承担任务栏媒体栏的承载、位置、尺寸和三层体验。结构上的四个决定：

        1. 模式选择从页面顶部移到最后一个分组，并且不再门控任务栏设置。以前点“灵动岛”会把整页任务栏设置
           换成一张“尚未实现”的卡片，用户想回去只能再点回“任务栏”。
        2. “当前模式”芯片读真实 WindowMode，而不是写死在任务栏卡片上。
        3. 静置层/悬停层/完整层各自带一张只解释自己那一层的图，取代页面顶部一张抽象的“三层总览”。
        4. 悬停层与完整层的详细设置在父卡片内部的子区域里，跟随开关折叠；关闭时不再只是平级卡片变灰。

        This page owns how the taskbar bar is hosted, positioned, sized, and layered. Four structural decisions:

        1. The mode picker moved from the top of the page to the last group and no longer gates the taskbar
           settings. Clicking "dynamic island" used to replace every taskbar setting with a single
           "not implemented" card, leaving the only way back as clicking "taskbar" again.
        2. The "current mode" chip reads the real WindowMode instead of being hardcoded on the taskbar card.
        3. Each of the rest, hover, and full layers carries a diagram that explains only itself, replacing one
           abstract three-layer overview at the top of the page.
        4. Hover and full layer details live in a sub-region inside their parent card and fold with the switch,
           instead of greyed-out sibling cards.
    -->

    <!--
        ScrollViewer.CanContentScroll="False" 必须显式保留在 Page 上。
        WPF-UI 的 NavigationViewContentPresenter 会据此决定是否给页面再包一层 DynamicScrollViewer：
        取 True 时会包装，于是页面被以无限高度测量，页面自带的滚动器长到内容高度、固定页头随之被滚走；
        取 False 时不包装，页面自己拿到有界视口。这正是本页页头能够固定的前提。
        ScrollViewer.CanContentScroll="False" must stay explicit on the Page. WPF-UI's
        NavigationViewContentPresenter uses it to decide whether to wrap the page in another DynamicScrollViewer:
        True wraps it, so the page is measured with infinite height, its own scroller grows to the content
        height, and the pinned header scrolls away; False leaves the page with a bounded viewport, which is
        exactly what lets this page pin its header.
    -->

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!--  模式选择卡片：仍使用原 RadioButton、GroupName、Command 与 CommandParameter 绑定，只替换外观。  -->
        <!--  Mode choice cards keep the original RadioButton, GroupName, Command, and CommandParameter bindings.  -->
        <Style
            x:Key="ModeChoiceStyle"
            BasedOn="{StaticResource AfSettingsChoiceCardStyle}"
            TargetType="RadioButton">
            <Setter Property="MinHeight" Value="92" />
            <Setter Property="Padding" Value="16,14" />
        </Style>

        <!--  模式卡片内的说明：与模式名分开，避免名称和说明挤在同一层级上。  -->
        <!--  Mode card captions, kept separate so name and detail do not collapse into one level.  -->
        <Style x:Key="ModeCaptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineHeight" Value="17" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <!--
            只读提示：只在页面高亮了一个未实现的承载模式时出现。
            那种状态下任务栏专属设置拒绝写入（受测试保护的既有不变量），因此必须让用户看见原因，
            而不是让十几个开关看起来能用、点了却不保存。
            The read-only notice appears only while an unimplemented hosting mode is highlighted. In that state
            taskbar-only settings refuse writes, which is an existing invariant guarded by a test, so the reason
            has to be visible rather than leaving a dozen switches that look usable but do not save.
        -->
        <Style
            x:Key="ReadOnlyNoticeStyle"
            TargetType="{x:Type components:SettingsCallout}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ViewModel.IsUnimplementedMode}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <components:SettingsGroupStrip
            Grid.Row="0"
            Margin="{StaticResource AfSettingsHeaderMargin}"
            MaxWidth="{StaticResource AfSettingsContentMaxWidth}"
            PageIcon="{ui:SymbolIcon Desktop24}"
            StatusText="{Binding ViewModel.HostingModeText}"
            Subtitle="任务栏媒体栏的承载位置、尺寸与三层体验"
            Target="{Binding ElementName=PageScroll}"
            Title="显示模式" />

        <ScrollViewer
            x:Name="PageScroll"
            Grid.Row="1"
            Margin="{StaticResource AfSettingsScrollMargin}"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                x:Name="PageRoot"
                MaxWidth="{StaticResource AfSettingsContentMaxWidth}"
                Loaded="OnPageLoaded">

                <components:SettingsCallout
                    Margin="0,0,0,4"
                    IsAccent="False"
                    Style="{StaticResource ReadOnlyNoticeStyle}"
                    Symbol="Info24"
                    Text="你高亮的是一个尚未实现的承载模式，因此下面这些任务栏设置暂时只读、改动不会被保存。点回最后一张卡片里的「任务栏」即可继续编辑。" />

                <components:SettingsGroup Header="承载与位置" Icon="{ui:SymbolIcon Desktop24}">
                    <StackPanel>
                        <ui:CardControl Margin="{StaticResource AfSettingsCardGap}">
                            <ui:CardControl.Icon>
                                <ui:SymbolIcon Symbol="Desktop24" />
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource AfSettingsCardTitleStyle}" Text="承载显示器" />
                                    <TextBlock
                                        Style="{StaticResource AfSettingsCardDescriptionStyle}"
                                        Text="选择哪一块显示器的任务栏承载媒体栏；列出的是显示器，不是任务栏本身。" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ComboBox
                                HorizontalAlignment="Left"
                                DisplayMemberPath="DisplayName"
                                ItemsSource="{Binding ViewModel.MonitorOptions}"
                                MinWidth="{StaticResource AfSettingsFieldWidthWide}"
                                SelectedValue="{Binding ViewModel.TaskbarTargetMonitorDeviceId, Mode=TwoWay}"
                                SelectedValuePath="DeviceId" />
                        </ui:CardControl>

                        <ui:CardControl Margin="{StaticResource AfSettingsCardGap}">
                            <ui:CardControl.Icon>
                                <ui:SymbolIcon Symbol="Orientation24" />
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource AfSettingsCardTitleStyle}" Text="排列方向" />
                                    <TextBlock
                                        Style="{StaticResource AfSettingsCardDescriptionStyle}"
                                        Text="媒体栏内部组件的排列方向；自动会跟随任务栏的实际方向。" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ComboBox
                                HorizontalAlignment="Left"
                                Width="{StaticResource AfSettingsSelectMinWidth}"
                                SelectedValue="{Binding ViewModel.Orientation, Mode=TwoWay}"
                                SelectedValuePath="Tag">
                                <ComboBoxItem Content="自动（跟随任务栏）" Tag="{x:Static settings:LayoutOrientationMode.Auto}" />
                                <ComboBoxItem Content="强制横向" Tag="{x:Static settings:LayoutOrientationMode.Horizontal}" />
                                <ComboBoxItem Content="强制纵向" Tag="{x:Static settings:LayoutOrientationMode.Vertical}" />
                            </ComboBox>
                        </ui:CardControl>

                        <ui:CardControl Margin="{StaticResource AfSettingsCardGap}" Style="{StaticResource AfSettingsCardStackedStyle}">
                            <ui:CardControl.Icon>
                                <ui:SymbolIcon Symbol="LockClosed24" />
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource AfSettingsCardTitleStyle}" Text="位置与自动避让" />
                                    <TextBlock
                                        Style="{StaticResource AfSettingsCardDescriptionStyle}"
                                        Text="决定媒体栏贴在任务栏的哪一段，以及它与图标区之间的间距。" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <StackPanel>
                                <components:SettingsDiagram Margin="0,0,0,14" Kind="TaskbarPlacement" />

                                <WrapPanel>
                                    <ui:ToggleSwitch
                                        Margin="0,0,20,10"
                                        Content="避开任务栏图标"
                                        IsChecked="{Binding ViewModel.IsTaskbarAvoidingIcons, Mode=TwoWay}" />
                                    <ui:ToggleSwitch
                                        Margin="0,0,20,10"
                                        Content="锁定位置"
                                        IsChecked="{Binding ViewModel.IsTaskbarPositionLocked, Mode=TwoWay}" />
                                </WrapPanel>

                                <TextBlock
                                    Margin="0,4,0,6"
                                    Style="{StaticResource AfSettingsFieldLabelStyle}"
                                    Text="边缘偏移（DIP）" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider
                                        IsSnapToTickEnabled="True"
                                        Maximum="20"
                                        Minimum="-20"
                                        TickFrequency="1"
                                        Value="{Binding ViewModel.TaskbarCrossAxisOffsetDip, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="12,0,0,0"
                                        Style="{StaticResource AfSettingsFieldValueStyle}"
                                        Text="{Binding ViewModel.TaskbarCrossAxisOffsetDip, StringFormat={}{0:0} DIP}" />
                                </Grid>

                                <ui:Button
                                    Margin="0,14,0,0"
                                    HorizontalAlignment="Left"
                                    Command="{Binding ViewModel.ResetTaskbarPositionCommand}"
                                    Content="重置位置"
                                    Icon="{ui:SymbolIcon ArrowReset24}"
                                    Style="{StaticResource AfSettingsButtonStyle}" />
                            </StackPanel>
                        </ui:CardControl>

                        <ui:CardControl Margin="{StaticResource AfSettingsCardGap}" Style="{StaticResource AfSettingsCardStackedStyle}">
                            <ui:CardControl.Icon>
                                <ui:SymbolIcon Symbol="ResizeLarge24" />
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource AfSettingsCardTitleStyle}" Text="媒体栏长度" />
                                    <TextBlock
                                        Style="{StaticResource AfSettingsCardDescriptionStyle}"
                                        Text="跟随媒体文字长度时宽度随内容变化；取消跟随才使用固定长度。" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <StackPanel>
                                <ui:ToggleSwitch Content="跟随媒体文字长度" IsChecked="{Binding ViewModel.FollowMediaTextLength, Mode=TwoWay}" />

                                <components:SettingsSubRegion
                                    Description="固定长度会被夹取在悬停层所需最小长度与任务栏安全上限之间。"
                                    Header="固定长度"
                                    IsSubRegionEnabled="{Binding ViewModel.UsesFixedTaskbarLength}"
                                    StatusText="需先取消跟随"
                                    StatusTone="Attention">
                                    <StackPanel>
                                        <components:SettingsDiagram Margin="0,0,0,12" Kind="TaskbarLength" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Slider
                                                Maximum="{Binding ViewModel.FixedTaskbarLengthMaximum}"
                                                Minimum="{Binding ViewModel.FixedTaskbarLengthMinimum}"
                                                Value="{Binding ViewModel.FixedTaskbarLengthDip, Mode=TwoWay}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Margin="12,0,0,0"
                                                Style="{StaticResource AfSettingsFieldValueStyle}"
                                                Text="{Binding ViewModel.FixedTaskbarLengthDip, StringFormat={}{0:0} DIP}" />
                                        </Grid>
                                        <TextBlock
                                            Margin="0,6,0,0"
                                            Style="{StaticResource AfSettingsHintTextStyle}"
                                            Text="{Binding ViewModel.FixedTaskbarLengthRangeText}" />
                                    </StackPanel>
                                </components:SettingsSubRegion>
                            </StackPanel>
                        </ui:CardControl>

                        <ui:CardControl Margin="{StaticResource AfSettingsCardGapLast}">
                            <ui:CardControl.Icon>
                                <ui:SymbolIcon Symbol="PaddingLeft24" />
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource AfSettingsCardTitleStyle}" Text="组件间距" />
                                    <TextBlock
                                        Style="{StaticResource AfSettingsCardDescriptionStyle}"
                                        Text="封面、文字与附加组件之间的水平间距。" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <Grid Width="{StaticResource AfSettingsFieldWidth}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Slider
                                    IsSnapToTickEnabled="True"
                                    Maximum="32"
                                    Minimum="4"
                                    TickFrequency="1"
                                    Value="{Binding ViewModel.ComponentSpacingDip, Mode=TwoWay}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="12,0,0,0"
                                    Style="{StaticResource AfSettingsFieldValueStyle}"
                                    Text="{Binding ViewModel.ComponentSpacingDip, StringFormat={}{0:0} DIP}" />
                            </Grid>
                        </ui:CardControl>
                    </StackPanel>
                </components:SettingsGroup>

                <components:SettingsGroup
                    Header="静置层"
                    Icon="{ui:SymbolIcon Layer24}"
                    StatusText="始终开启"
                    StatusTone="Accent">
                    <StackPanel>
                        <components:SettingsDiagram Margin="0,0,0,12" Kind="LayerRest" />

                        <ui:CardControl Margin="{StaticResource AfSettingsCardGap}" Style="{StaticResource AfSettingsCardStackedStyle}">
                            <ui:CardControl.Icon>
                                <ui:SymbolIcon Symbol="TextAlignJustify24" />
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource AfSettingsCardTitleStyle}" Text="信息布局" />
                                    <TextBlock
                                        Style="{StaticResource AfSettingsCardDescriptionStyle}"
                                        Text="常驻显示多少信息、如何排列，以及标题与歌手如何对齐。" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock
                                        Margin="{StaticResource AfSettingsFieldLabelGap}"
                                        Style="{StaticResource AfSettingsFieldLabelStyle}"
                                        Text="信息密度" />
                                    <ComboBox
                                        HorizontalAlignment="Stretch"
                                        SelectedValue="{Binding ViewModel.Density, Mode=TwoWay}"
                                        SelectedValuePath="Tag">
                                        <ComboBoxItem Content="精简" Tag="{x:Static settings:TaskbarInformationDensity.Minimal}" />
                                        <ComboBoxItem Content="均衡" Tag="{x:Static settings:TaskbarInformationDensity.Balanced}" />
                                        <ComboBoxItem Content="信息优先" Tag="{x:Static settings:TaskbarInformationDensity.Information}" />
                                    </ComboBox>

                                    <TextBlock
                                        Margin="0,10,0,6"
                                        Style="{StaticResource AfSettingsFieldLabelStyle}"
                                        Text="内容排列" />
                                    <ComboBox
                                        HorizontalAlignment="Stretch"
                                        SelectedValue="{Binding ViewModel.ContentLayout, Mode=TwoWay}"
                                        SelectedValuePath="Tag">
                                        <ComboBoxItem Content="紧凑行内" Tag="{x:Static settings:TaskbarContentLayout.CompactInline}" />
                                        <ComboBoxItem Content="自适应堆叠" Tag="{x:Static settings:TaskbarContentLayout.AdaptiveStack}" />
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock
                                        Margin="{StaticResource AfSettingsFieldLabelGap}"
                                        Style="{StaticResource AfSettingsFieldLabelStyle}"
                                        Text="标题与歌手对齐" />
                                    <ComboBox
                                        HorizontalAlignment="Stretch"
                                        SelectedValue="{Binding ViewModel.MediaTextAlignment, Mode=TwoWay}"
                                        SelectedValuePath="Tag">
                                        <ComboBoxItem Content="左对齐" Tag="{x:Static settings:TaskbarMediaTextAlignment.Left}" />
                                        <ComboBoxItem Content="居中" Tag="{x:Static settings:TaskbarMediaTextAlignment.Center}" />
                                        <ComboBoxItem Content="右对齐" Tag="{x:Static settings:TaskbarMediaTextAlignment.Right}" />
                                    </ComboBox>

                                    <TextBlock
                                        Margin="0,12,0,0"
                                        Style="{StaticResource AfSettingsHintTextStyle}"
                                        Text="频谱与性能两个附加组件的开关和参数在「媒体与通知 → 静置层组件」。" />
                                </StackPanel>
                            </Grid>
                        </ui:CardControl>
                    </StackPanel>
                </components:SettingsGroup>

                <components:SettingsGroup Header="悬停层" Icon="{ui:SymbolIcon HandDraw24}">
                    <StackPanel>
                        <components:SettingsDiagram Margin="0,0,0,12" Kind="LayerHover" />

                        <ui:CardControl Margin="{StaticResource AfSettingsCardGapLast}">
                            <ui:CardControl.Icon>
                                <ui:SymbolIcon Symbol="HandDraw24" />
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource AfSettingsCardTitleStyle}" Text="启用悬停层" />
                                    <TextBlock
                                        Style="{StaticResource AfSettingsCardDescriptionStyle}"
                                        Text="鼠标移入媒体栏时展开快捷控制；关闭后下面的按钮设置不生效。" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch IsChecked="{Binding ViewModel.HoverLayerEnabled, Mode=TwoWay}" />
                        </ui:CardControl>

                        <components:SettingsSubRegion
                            CollapseWhenDisabled="True"
                            Description="决定悬停时出现哪些按钮。关闭后整块折叠，避免留下一排不起作用的开关。"
                            Header="悬停层控制"
                            IsSubRegionEnabled="{Binding ViewModel.HoverLayerEnabled}"
                            StatusText="需先启用">
                            <WrapPanel>
                                <ui:ToggleSwitch
                                    Margin="0,0,20,10"
                                    Content="播放 / 暂停"
                                    IsChecked="{Binding ViewModel.HoverPlayPauseVisible, Mode=TwoWay}" />
                                <ui:ToggleSwitch
                                    Margin="0,0,20,10"
                                    Content="上一首 / 下一首"
                                    IsChecked="{Binding ViewModel.HoverPreviousNextVisible, Mode=TwoWay}" />
                                <ui:ToggleSwitch
                                    Margin="0,0,20,10"
                                    Content="输出设备"
                                    IsChecked="{Binding ViewModel.HoverOutputDeviceVisible, Mode=TwoWay}" />
                                <ui:ToggleSwitch
                                    Margin="0,0,20,10"
                                    Content="音频控制"
                                    IsChecked="{Binding ViewModel.HoverAudioControlVisible, Mode=TwoWay}" />
                                <ui:ToggleSwitch
                                    Margin="0,0,20,10"
                                    Content="进度控制"
                                    IsChecked="{Binding ViewModel.HoverProgressVisible, Mode=TwoWay}" />
                            </WrapPanel>
                        </components:SettingsSubRegion>
                    </StackPanel>
                </components:SettingsGroup>

                <components:SettingsGroup Header="完整层" Icon="{ui:SymbolIcon ProjectionScreen24}">
                    <StackPanel>
                        <components:SettingsDiagram Margin="0,0,0,12" Kind="LayerFull" />

                        <ui:CardControl Margin="{StaticResource AfSettingsCardGapLast}">
                            <ui:CardControl.Icon>
                                <ui:SymbolIcon Symbol="ProjectionScreen24" />
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource AfSettingsCardTitleStyle}" Text="启用完整层" />
                                    <TextBlock
                                        Style="{StaticResource AfSettingsCardDescriptionStyle}"
                                        Text="点击媒体栏展开完整面板；关闭后下面的分区设置不生效。" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch IsChecked="{Binding ViewModel.FullLayerEnabled, Mode=TwoWay}" />
                        </ui:CardControl>

                        <components:SettingsSubRegion
                            CollapseWhenDisabled="True"
                            Description="四个分区可以分别关闭，但至少保留一个；只剩一个时它的开关会被禁用。"
                            Header="完整层内容"
                            IsSubRegionEnabled="{Binding ViewModel.FullLayerEnabled}"
                            StatusText="需先启用">
                            <StackPanel>
                                <WrapPanel Margin="0,0,0,12">
                                    <ui:Button
                                        Margin="0,0,8,0"
                                        Command="{Binding ViewModel.ApplyCompactFullPanelPresetCommand}"
                                        Content="套用紧凑预设"
                                        Style="{StaticResource AfSettingsButtonStyle}" />
                                    <ui:Button
                                        Command="{Binding ViewModel.ApplyFullFullPanelPresetCommand}"
                                        Content="套用完整预设"
                                        Style="{StaticResource AfSettingsButtonStyle}" />
                                </WrapPanel>

                                <TextBlock
                                    Margin="{StaticResource AfSettingsFieldLabelGap}"
                                    Style="{StaticResource AfSettingsFieldLabelStyle}"
                                    Text="{Binding ViewModel.FullPanelLayoutStatus, StringFormat=当前方案：{0}}" />

                                <WrapPanel>
                                    <ui:ToggleSwitch
                                        Margin="0,0,20,10"
                                        Content="媒体信息"
                                        IsChecked="{Binding ViewModel.FullPanelMediaInfoVisible, Mode=TwoWay}"
                                        IsEnabled="{Binding ViewModel.CanToggleFullPanelMediaInfo}" />
                                    <ui:ToggleSwitch
                                        Margin="0,0,20,10"
                                        Content="播放控制"
                                        IsChecked="{Binding ViewModel.FullPanelMediaControlsVisible, Mode=TwoWay}"
                                        IsEnabled="{Binding ViewModel.CanToggleFullPanelMediaControls}" />
                                    <ui:ToggleSwitch
                                        Margin="0,0,20,10"
                                        Content="音频控制"
                                        IsChecked="{Binding ViewModel.FullPanelAudioControlsVisible, Mode=TwoWay}"
                                        IsEnabled="{Binding ViewModel.CanToggleFullPanelAudioControls}" />
                                    <ui:ToggleSwitch
                                        Margin="0,0,20,10"
                                        Content="性能信息"
                                        IsChecked="{Binding ViewModel.FullPanelPerformanceVisible, Mode=TwoWay}"
                                        IsEnabled="{Binding ViewModel.CanToggleFullPanelPerformance}" />
                                </WrapPanel>
                            </StackPanel>
                        </components:SettingsSubRegion>
                    </StackPanel>
                </components:SettingsGroup>

                <components:SettingsGroup
                    Header="其他承载模式"
                    Icon="{ui:SymbolIcon WindowConsole20}"
                    StatusText="未实现"
                    StatusTone="Neutral"
                    Tint="Muted">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,12"
                            Style="{StaticResource AfSettingsHintTextStyle}"
                            Text="下面三种承载方式尚未实现。选中其中一种只会高亮这张卡片，不会切换正在运行的任务栏窗口；但选中期间上面的任务栏设置会变为只读，点回「任务栏」即可继续编辑。" />

                        <UniformGrid Columns="2">
                            <RadioButton
                                GroupName="DisplayMode"
                                IsChecked="{Binding ViewModel.IsTaskbarMode, Mode=OneWay}"
                                Command="{Binding ViewModel.SwitchToTaskbarModeCommand}"
                                Style="{StaticResource ModeChoiceStyle}">
                                <StackPanel>
                                    <DockPanel>
                                        <!--  芯片先声明并按右停靠，标题最后声明以填充剩余宽度；顺序反过来会把芯片拉满整行。  -->
                                        <!--  The chip docks right and is declared first; the title fills. The reverse order stretches the chip across the row.  -->
                                        <ContentControl
                                            DockPanel.Dock="Right"
                                            Content="当前模式"
                                            Style="{StaticResource AfSettingsChipAccentStyle}"
                                            Visibility="{Binding ViewModel.IsTaskbarHostingActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <TextBlock
                                            FontSize="16"
                                            FontWeight="{DynamicResource AppTextStrongFontWeight}"
                                            Text="任务栏" />
                                    </DockPanel>
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        Style="{StaticResource ModeCaptionStyle}"
                                        Text="融入 Windows 任务栏，提供静置、悬停和完整三层体验。" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton
                                GroupName="DisplayMode"
                                IsChecked="{Binding ViewModel.IsDynamicIslandMode, Mode=OneWay}"
                                Command="{Binding ViewModel.SwitchToDynamicIslandModeCommand}"
                                Style="{StaticResource ModeChoiceStyle}">
                                <StackPanel>
                                    <DockPanel>
                                        <ContentControl
                                            DockPanel.Dock="Right"
                                            Content="未实现"
                                            Style="{StaticResource AfSettingsChipNeutralStyle}" />
                                        <TextBlock
                                            FontSize="16"
                                            FontWeight="{DynamicResource AppTextStrongFontWeight}"
                                            Text="灵动岛" />
                                    </DockPanel>
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        Style="{StaticResource ModeCaptionStyle}"
                                        Text="以屏幕边缘浮层呈现媒体状态。" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton
                                GroupName="DisplayMode"
                                IsChecked="{Binding ViewModel.IsDesktopCardMode, Mode=OneWay}"
                                Command="{Binding ViewModel.SwitchToDesktopCardModeCommand}"
                                Style="{StaticResource ModeChoiceStyle}">
                                <StackPanel>
                                    <DockPanel>
                                        <ContentControl
                                            DockPanel.Dock="Right"
                                            Content="未实现"
                                            Style="{StaticResource AfSettingsChipNeutralStyle}" />
                                        <TextBlock
                                            FontSize="16"
                                            FontWeight="{DynamicResource AppTextStrongFontWeight}"
                                            Text="桌面卡片" />
                                    </DockPanel>
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        Style="{StaticResource ModeCaptionStyle}"
                                        Text="在桌面放置可自由布局的媒体卡片。" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton
                                GroupName="DisplayMode"
                                IsChecked="{Binding ViewModel.IsFloatingBallMode, Mode=OneWay}"
                                Command="{Binding ViewModel.SwitchToFloatingBallModeCommand}"
                                Style="{StaticResource ModeChoiceStyle}">
                                <StackPanel>
                                    <DockPanel>
                                        <ContentControl
                                            DockPanel.Dock="Right"
                                            Content="未实现"
                                            Style="{StaticResource AfSettingsChipNeutralStyle}" />
                                        <TextBlock
                                            FontSize="16"
                                            FontWeight="{DynamicResource AppTextStrongFontWeight}"
                                            Text="悬浮球" />
                                    </DockPanel>
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        Style="{StaticResource ModeCaptionStyle}"
                                        Text="用紧凑悬浮入口快速展开控制。" />
                                </StackPanel>
                            </RadioButton>
                        </UniformGrid>
                    </StackPanel>
                </components:SettingsGroup>

                <ui:Button
                    Margin="0,20,0,40"
                    HorizontalAlignment="Left"
                    Click="ResetButton_Click"
                    Content="恢复本页默认设置"
                    Icon="{ui:SymbolIcon ArrowReset24}"
                    Style="{StaticResource AfSettingsButtonStyle}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
