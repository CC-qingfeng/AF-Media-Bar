<Page
    x:Class="AFMediaBar.Views.Pages.DisplayModesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="clr-namespace:AFMediaBar.Classes.Settings"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!--
            模式选择卡片：仍然使用 RadioButton 和原来的 GroupName、IsChecked、Command 绑定，
            只是外观换成分段选择。以前是四个无描边的默认 ToggleButton，选中状态只靠填充色深浅区分。
            Mode choice cards still use RadioButton with the original GroupName, IsChecked, and Command bindings;
            only the appearance becomes a segmented choice. They previously rendered as four unstroked default
            ToggleButtons whose selection was signalled by fill shade alone.
        -->
        <Style
            x:Key="ModeChoiceStyle"
            BasedOn="{StaticResource AfSettingsChoiceCardStyle}"
            TargetType="RadioButton">
            <Setter Property="MinHeight" Value="96" />
            <Setter Property="Padding" Value="16,14" />
        </Style>

        <!--  模式卡片内的小标题：与卡片说明分开，避免模式名和说明挤在同一层级上。  -->
        <!--  Mode card captions, kept separate from the description so name and detail do not collapse together.  -->
        <Style x:Key="ModeCaptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineHeight" Value="17" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
    </Page.Resources>


        <StackPanel
            x:Name="PageRoot"
            MaxWidth="{StaticResource AfSettingsContentMaxWidth}"
            Margin="{StaticResource AfSettingsPageMargin}"
            Loaded="OnPageLoaded">

            <TextBlock Style="{StaticResource AfSettingsPageTitleStyle}" Text="显示模式" />
            <TextBlock
                Style="{StaticResource AfSettingsPageSubtitleStyle}"
                Text="先选择要配置的承载模式；未实现模式仅用于预览设置入口，不会切换当前窗口" />

            <ContentControl
                Margin="0,0,0,12"
                Content="选择模式"
                ContentTemplate="{StaticResource AfSettingsSectionHeaderTemplate}" />

            <UniformGrid Margin="0,0,0,16" Columns="2">
                <RadioButton
                    GroupName="DisplayMode"
                    IsChecked="{Binding ViewModel.IsTaskbarMode, Mode=OneWay}"
                    Command="{Binding ViewModel.SwitchToTaskbarModeCommand}"
                    Style="{StaticResource ModeChoiceStyle}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock
                                FontSize="16"
                                FontWeight="{DynamicResource AppTextStrongFontWeight}"
                                Text="任务栏" />
                            <Border
                                DockPanel.Dock="Right"
                                Padding="7,2"
                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                CornerRadius="8">
                                <!--  写死的 White 在高对比度下会丢失，改用主题的“主色底上的文字”画刷。  -->
                                <!--  A hardcoded White is lost under high contrast; the themed on-accent brush replaces it.  -->
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                    Text="当前模式" />
                            </Border>
                        </DockPanel>
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource ModeCaptionStyle}" Text="融入 Windows 任务栏，提供静置、悬停和完整三层体验" />
                    </StackPanel>
                </RadioButton>

                <RadioButton
                    GroupName="DisplayMode"
                    IsChecked="{Binding ViewModel.IsDynamicIslandMode, Mode=OneWay}"
                    Command="{Binding ViewModel.SwitchToDynamicIslandModeCommand}"
                    Style="{StaticResource ModeChoiceStyle}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock
                                FontSize="16"
                                FontWeight="{DynamicResource AppTextStrongFontWeight}"
                                Text="灵动岛" />
                            <TextBlock
                                DockPanel.Dock="Right"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="未实现" />
                        </DockPanel>
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource ModeCaptionStyle}" Text="以屏幕边缘浮层呈现媒体状态" />
                    </StackPanel>
                </RadioButton>

                <RadioButton
                    GroupName="DisplayMode"
                    IsChecked="{Binding ViewModel.IsDesktopCardMode, Mode=OneWay}"
                    Command="{Binding ViewModel.SwitchToDesktopCardModeCommand}"
                    Style="{StaticResource ModeChoiceStyle}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock
                                FontSize="16"
                                FontWeight="{DynamicResource AppTextStrongFontWeight}"
                                Text="桌面卡片" />
                            <TextBlock
                                DockPanel.Dock="Right"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="未实现" />
                        </DockPanel>
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource ModeCaptionStyle}" Text="在桌面放置可自由布局的媒体卡片" />
                    </StackPanel>
                </RadioButton>

                <RadioButton
                    GroupName="DisplayMode"
                    IsChecked="{Binding ViewModel.IsFloatingBallMode, Mode=OneWay}"
                    Command="{Binding ViewModel.SwitchToFloatingBallModeCommand}"
                    Style="{StaticResource ModeChoiceStyle}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock
                                FontSize="16"
                                FontWeight="{DynamicResource AppTextStrongFontWeight}"
                                Text="悬浮球" />
                            <TextBlock
                                DockPanel.Dock="Right"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="未实现" />
                        </DockPanel>
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource ModeCaptionStyle}" Text="用紧凑悬浮入口快速展开控制" />
                    </StackPanel>
                </RadioButton>
            </UniformGrid>

            <StackPanel Visibility="{Binding ViewModel.IsUnimplementedMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ui:CardControl Margin="{StaticResource AfSettingsCardGapLast}">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="WindowConsole20" />
                    </ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Style="{StaticResource AfSettingsCardTitleStyle}" Text="该模式尚未实现" />
                            <TextBlock
                                Style="{StaticResource AfSettingsCardDescriptionStyle}"
                                Text="当前选择只在本页高亮，不会改变正在运行的任务栏模式；专属设置将在实现后提供。" />
                        </StackPanel>
                    </ui:CardControl.Header>
                </ui:CardControl>
            </StackPanel>

            <StackPanel Visibility="{Binding ViewModel.IsTaskbarMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ContentControl
                    Margin="0,0,0,12"
                    Content="任务栏模式"
                    ContentTemplate="{StaticResource AfSettingsSectionHeaderTemplate}" />

                <ContentControl
                    Margin="0,0,0,12"
                    ContentTemplate="{StaticResource AfDiagramTaskbarLayers}" />

                <ui:CardControl Margin="{StaticResource AfSettingsCardGap}">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Desktop24" />
                    </ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Style="{StaticResource AfSettingsCardTitleStyle}" Text="显示器" />
                            <TextBlock
                                Style="{StaticResource AfSettingsCardDescriptionStyle}"
                                Text="选择承载媒体栏的任务栏" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ComboBox
                        HorizontalAlignment="Left"
                        ItemsSource="{Binding ViewModel.MonitorOptions}"
                        DisplayMemberPath="DisplayName"
                        MinWidth="{StaticResource AfSettingsFieldWidthWide}"
                        SelectedValue="{Binding ViewModel.TaskbarTargetMonitorDeviceId, Mode=TwoWay}"
                        SelectedValuePath="DeviceId" />
                </ui:CardControl>

                <ui:CardControl Margin="{StaticResource AfSettingsCardGap}">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Orientation24" />
                    </ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Style="{StaticResource AfSettingsCardTitleStyle}" Text="排列方向" />
                            <TextBlock
                                Style="{StaticResource AfSettingsCardDescriptionStyle}"
                                Text="自动跟随任务栏，也可强制横向或纵向" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ComboBox
                        HorizontalAlignment="Left"
                        Width="{StaticResource AfSettingsSelectMinWidth}"
                        SelectedValue="{Binding ViewModel.Orientation, Mode=TwoWay}"
                        SelectedValuePath="Tag">
                        <ComboBoxItem Content="自动" Tag="{x:Static settings:LayoutOrientationMode.Auto}" />
                        <ComboBoxItem Content="横向" Tag="{x:Static settings:LayoutOrientationMode.Horizontal}" />
                        <ComboBoxItem Content="纵向" Tag="{x:Static settings:LayoutOrientationMode.Vertical}" />
                    </ComboBox>
                </ui:CardControl>

                <ContentControl
                    Margin="0,0,0,8"
                    ContentTemplate="{StaticResource AfDiagramTaskbarPlacement}" />

                <ui:CardControl Margin="{StaticResource AfSettingsCardGap}">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="LockClosed24" />
                    </ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Style="{StaticResource AfSettingsCardTitleStyle}" Text="位置与自动避让" />
                            <TextBlock
                                Style="{StaticResource AfSettingsCardDescriptionStyle}"
                                Text="自动避开任务栏图标；锁定后阻止拖动" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <StackPanel MinWidth="{StaticResource AfSettingsFieldWidth}">
                        <WrapPanel>
                            <ui:ToggleSwitch
                                Margin="0,0,20,0"
                                Content="避开任务栏图标"
                                IsChecked="{Binding ViewModel.IsTaskbarAvoidingIcons, Mode=TwoWay}" />
                            <ui:ToggleSwitch Content="锁定位置" IsChecked="{Binding ViewModel.IsTaskbarPositionLocked, Mode=TwoWay}" />
                        </WrapPanel>
                        <TextBlock
                            Margin="0,12,0,6"
                            Style="{StaticResource AfSettingsFieldLabelStyle}"
                            Text="边缘偏移" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider
                                IsSnapToTickEnabled="True"
                                Maximum="20"
                                Minimum="-20"
                                TickFrequency="1"
                                Value="{Binding ViewModel.TaskbarCrossAxisOffsetDip, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="12,0,0,0"
                                Style="{StaticResource AfSettingsFieldValueStyle}"
                                Text="{Binding ViewModel.TaskbarCrossAxisOffsetDip, StringFormat={}{0:0} DIP}" />
                        </Grid>
                        <ui:Button
                            Margin="0,12,0,0"
                            HorizontalAlignment="Left"
                            Command="{Binding ViewModel.ResetTaskbarPositionCommand}"
                            Content="重置位置"
                            Icon="{ui:SymbolIcon ArrowReset24}"
                            Style="{StaticResource AfSettingsButtonStyle}" />
                    </StackPanel>
                </ui:CardControl>

                <ContentControl
                    Margin="0,0,0,8"
                    ContentTemplate="{StaticResource AfDiagramTaskbarLength}" />

                <ui:CardControl Margin="{StaticResource AfSettingsCardGapLast}">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="ResizeLarge24" />
                    </ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Style="{StaticResource AfSettingsCardTitleStyle}" Text="尺寸" />
                            <TextBlock
                                Style="{StaticResource AfSettingsCardDescriptionStyle}"
                                Text="跟随媒体文字长度，或使用固定长度" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <StackPanel MinWidth="{StaticResource AfSettingsFieldWidth}">
                        <ui:ToggleSwitch Content="跟随媒体文字长度" IsChecked="{Binding ViewModel.FollowMediaTextLength, Mode=TwoWay}" />
                        <StackPanel IsEnabled="{Binding ViewModel.UsesFixedTaskbarLength}">
                            <TextBlock
                                Margin="0,12,0,6"
                                Style="{StaticResource AfSettingsFieldLabelStyle}"
                                Text="固定长度" />
                            <Slider
                                Maximum="{Binding ViewModel.FixedTaskbarLengthMaximum}"
                                Minimum="{Binding ViewModel.FixedTaskbarLengthMinimum}"
                                Value="{Binding ViewModel.FixedTaskbarLengthDip, Mode=TwoWay}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                Style="{StaticResource AfSettingsHintTextStyle}"
                                Text="{Binding ViewModel.FixedTaskbarLengthRangeText}" />
                        </StackPanel>
                        <TextBlock
                            Margin="0,12,0,6"
                            Style="{StaticResource AfSettingsFieldLabelStyle}"
                            Text="组件间距" />
                        <Slider
                            Maximum="32"
                            Minimum="4"
                            TickFrequency="1"
                            Value="{Binding ViewModel.ComponentSpacingDip, Mode=TwoWay}" />
                    </StackPanel>
                </ui:CardControl>

                <ContentControl
                    Margin="0,8,0,12"
                    Content="静置层"
                    ContentTemplate="{StaticResource AfSettingsSectionHeaderTemplate}" />

                <ui:CardControl Margin="{StaticResource AfSettingsCardGap}">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Layer24" />
                    </ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Style="{StaticResource AfSettingsCardTitleStyle}" Text="静置层（始终开启）" />
                            <TextBlock
                                Style="{StaticResource AfSettingsCardDescriptionStyle}"
                                Text="用于持续展示封面、标题、歌词、频谱和性能等信息，是任务栏模式的基础层。" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch Content="始终开启" IsChecked="True" IsEnabled="False" />
                </ui:CardControl>

                <ui:CardControl Margin="{StaticResource AfSettingsCardGap}">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="TextAlignJustify24" />
                    </ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Style="{StaticResource AfSettingsCardTitleStyle}" Text="信息布局" />
                            <TextBlock
                                Style="{StaticResource AfSettingsCardDescriptionStyle}"
                                Text="标题与歌手对齐独立于歌词页的歌词对齐设置" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <StackPanel MinWidth="{StaticResource AfSettingsFieldWidth}">
                        <TextBlock
                            Margin="{StaticResource AfSettingsFieldLabelGap}"
                            Style="{StaticResource AfSettingsFieldLabelStyle}"
                            Text="信息密度" />
                        <ComboBox
                            HorizontalAlignment="Left"
                            Width="{StaticResource AfSettingsSelectMinWidth}"
                            SelectedValue="{Binding ViewModel.Density, Mode=TwoWay}"
                            SelectedValuePath="Tag">
                            <ComboBoxItem Content="精简" Tag="{x:Static settings:TaskbarInformationDensity.Minimal}" />
                            <ComboBoxItem Content="均衡" Tag="{x:Static settings:TaskbarInformationDensity.Balanced}" />
                            <ComboBoxItem Content="信息优先" Tag="{x:Static settings:TaskbarInformationDensity.Information}" />
                        </ComboBox>
                        <TextBlock
                            Margin="0,10,0,6"
                            Style="{StaticResource AfSettingsFieldLabelStyle}"
                            Text="内容排列" />
                        <ComboBox
                            HorizontalAlignment="Left"
                            Width="{StaticResource AfSettingsSelectMinWidth}"
                            SelectedValue="{Binding ViewModel.ContentLayout, Mode=TwoWay}"
                            SelectedValuePath="Tag">
                            <ComboBoxItem Content="紧凑行内" Tag="{x:Static settings:TaskbarContentLayout.CompactInline}" />
                            <ComboBoxItem Content="自适应堆叠" Tag="{x:Static settings:TaskbarContentLayout.AdaptiveStack}" />
                        </ComboBox>
                        <TextBlock
                            Margin="0,10,0,6"
                            Style="{StaticResource AfSettingsFieldLabelStyle}"
                            Text="标题与歌手对齐" />
                        <ComboBox
                            HorizontalAlignment="Left"
                            Width="{StaticResource AfSettingsSelectMinWidth}"
                            SelectedValue="{Binding ViewModel.MediaTextAlignment, Mode=TwoWay}"
                            SelectedValuePath="Tag">
                            <ComboBoxItem Content="左对齐" Tag="{x:Static settings:TaskbarMediaTextAlignment.Left}" />
                            <ComboBoxItem Content="居中" Tag="{x:Static settings:TaskbarMediaTextAlignment.Center}" />
                            <ComboBoxItem Content="右对齐" Tag="{x:Static settings:TaskbarMediaTextAlignment.Right}" />
                        </ComboBox>
                    </StackPanel>
                </ui:CardControl>

                <ui:CardControl Margin="{StaticResource AfSettingsCardGapLast}">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="DataHistogram24" />
                    </ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Style="{StaticResource AfSettingsCardTitleStyle}" Text="静置信息组件" />
                            <TextBlock
                                Style="{StaticResource AfSettingsCardDescriptionStyle}"
                                Text="详细参数仍在额外功能页配置" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <WrapPanel>
                        <ui:ToggleSwitch
                            Margin="0,0,20,0"
                            Content="频谱组件"
                            IsChecked="{Binding ViewModel.SpectrumVisible, Mode=TwoWay}" />
                        <ui:ToggleSwitch Content="性能组件" IsChecked="{Binding ViewModel.PerformanceVisible, Mode=TwoWay}" />
                    </WrapPanel>
                </ui:CardControl>

                <ContentControl
                    Margin="0,8,0,12"
                    Content="悬停层"
                    ContentTemplate="{StaticResource AfSettingsSectionHeaderTemplate}" />

                <ui:CardControl Margin="{StaticResource AfSettingsCardGap}">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="HandDraw24" />
                    </ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Style="{StaticResource AfSettingsCardTitleStyle}" Text="启用悬停层" />
                            <TextBlock
                                Style="{StaticResource AfSettingsCardDescriptionStyle}"
                                Text="鼠标移入媒体栏时展开，用于放置常用控制按钮。" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch IsChecked="{Binding ViewModel.HoverLayerEnabled, Mode=TwoWay}" />
                </ui:CardControl>

                <ui:CardControl Margin="{StaticResource AfSettingsCardGapLast}" Visibility="{Binding ViewModel.HoverLayerEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="WindowConsole20" />
                    </ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Style="{StaticResource AfSettingsCardTitleStyle}" Text="悬停层控制" />
                            <TextBlock
                                Style="{StaticResource AfSettingsCardDescriptionStyle}"
                                Text="选择悬停时出现的快捷控制；默认保留设备、音量和进度。" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <WrapPanel MaxWidth="360">
                        <ui:ToggleSwitch
                            Margin="0,0,20,10"
                            Content="播放/暂停"
                            IsChecked="{Binding ViewModel.HoverPlayPauseVisible, Mode=TwoWay}" />
                        <ui:ToggleSwitch
                            Margin="0,0,20,10"
                            Content="上一首/下一首"
                            IsChecked="{Binding ViewModel.HoverPreviousNextVisible, Mode=TwoWay}" />
                        <ui:ToggleSwitch
                            Margin="0,0,20,10"
                            Content="输出设备"
                            IsChecked="{Binding ViewModel.HoverOutputDeviceVisible, Mode=TwoWay}" />
                        <ui:ToggleSwitch
                            Margin="0,0,20,10"
                            Content="音频控制"
                            IsChecked="{Binding ViewModel.HoverAudioControlVisible, Mode=TwoWay}" />
                        <ui:ToggleSwitch
                            Margin="0,0,20,10"
                            Content="进度控制"
                            IsChecked="{Binding ViewModel.HoverProgressVisible, Mode=TwoWay}" />
                    </WrapPanel>
                </ui:CardControl>

                <ContentControl
                    Margin="0,8,0,12"
                    Content="完整层"
                    ContentTemplate="{StaticResource AfSettingsSectionHeaderTemplate}" />

                <ui:CardControl Margin="{StaticResource AfSettingsCardGap}">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="ProjectionScreen24" />
                    </ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Style="{StaticResource AfSettingsCardTitleStyle}" Text="启用完整层" />
                            <TextBlock
                                Style="{StaticResource AfSettingsCardDescriptionStyle}"
                                Text="展开后提供完整媒体信息、播放控制、音频控制与性能信息。" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch IsChecked="{Binding ViewModel.FullLayerEnabled, Mode=TwoWay}" />
                </ui:CardControl>

                <ui:CardControl Margin="{StaticResource AfSettingsCardGapLast}" Visibility="{Binding ViewModel.FullLayerEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="WindowConsole20" />
                    </ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Style="{StaticResource AfSettingsCardTitleStyle}" Text="完整层内容" />
                            <TextBlock
                                Style="{StaticResource AfSettingsCardDescriptionStyle}"
                                Text="{Binding ViewModel.FullPanelLayoutStatus, Mode=OneWay, StringFormat=当前方案：{0}（至少保留一个分组）}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <StackPanel MinWidth="{StaticResource AfSettingsFieldWidth}">
                        <WrapPanel>
                            <ui:Button
                                Margin="0,0,8,8"
                                Command="{Binding ViewModel.ApplyCompactFullPanelPresetCommand}"
                                Content="紧凑预设"
                                Style="{StaticResource AfSettingsButtonStyle}" />
                            <ui:Button
                                Margin="0,0,8,8"
                                Command="{Binding ViewModel.ApplyFullFullPanelPresetCommand}"
                                Content="完整预设"
                                Style="{StaticResource AfSettingsButtonStyle}" />
                        </WrapPanel>
                        <WrapPanel>
                            <ui:ToggleSwitch
                                Margin="0,0,20,10"
                                Content="媒体信息"
                                IsChecked="{Binding ViewModel.FullPanelMediaInfoVisible, Mode=TwoWay}"
                                IsEnabled="{Binding ViewModel.CanToggleFullPanelMediaInfo}" />
                            <ui:ToggleSwitch
                                Margin="0,0,20,10"
                                Content="播放控制"
                                IsChecked="{Binding ViewModel.FullPanelMediaControlsVisible, Mode=TwoWay}"
                                IsEnabled="{Binding ViewModel.CanToggleFullPanelMediaControls}" />
                            <ui:ToggleSwitch
                                Margin="0,0,20,10"
                                Content="音频控制"
                                IsChecked="{Binding ViewModel.FullPanelAudioControlsVisible, Mode=TwoWay}"
                                IsEnabled="{Binding ViewModel.CanToggleFullPanelAudioControls}" />
                            <ui:ToggleSwitch
                                Margin="0,0,20,10"
                                Content="性能信息"
                                IsChecked="{Binding ViewModel.FullPanelPerformanceVisible, Mode=TwoWay}"
                                IsEnabled="{Binding ViewModel.CanToggleFullPanelPerformance}" />
                        </WrapPanel>
                    </StackPanel>
                </ui:CardControl>
            </StackPanel>

            <ui:Button
                Margin="0,18,0,0"
                HorizontalAlignment="Left"
                Click="ResetButton_Click"
                Content="恢复本页默认设置"
                Icon="{ui:SymbolIcon ArrowReset24}"
                Style="{StaticResource AfSettingsButtonStyle}" />
        </StackPanel>

</Page>
