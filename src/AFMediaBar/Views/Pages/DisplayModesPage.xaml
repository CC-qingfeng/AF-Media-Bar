<Page x:Class="AFMediaBar.Views.Pages.DisplayModesPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:settings="clr-namespace:AFMediaBar.Classes.Settings" xmlns:models="clr-namespace:AFMediaBar.Classes.Models.Layout" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
<Page.Resources><BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/></Page.Resources>
<StackPanel MaxWidth="1000" Margin="16,16,24,32">
<TextBlock Text="显示模式" FontSize="32" FontWeight="{DynamicResource AppTextStrongFontWeight}"/><ui:TextBlock Text="选择承载方式；下方只显示当前模式支持的自定义内容" Appearance="Secondary" Margin="0,8,0,24"/>
<UniformGrid Columns="2" Margin="0,0,0,24"><Button Margin="0,0,8,0" Padding="16" Command="{Binding ViewModel.SwitchToTaskbarModeCommand}"><StackPanel><TextBlock Text="任务栏模式" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="静置、悬停和完整面板" Foreground="#4CC2FF"/><TextBlock Text="嵌入 Windows 任务栏，提供紧凑常驻信息和分层交互。" TextWrapping="Wrap" Opacity="0.66"/></StackPanel></Button><Button Margin="8,0,0,0" Padding="16" Command="{Binding ViewModel.SwitchToDynamicIslandModeCommand}"><StackPanel><TextBlock Text="灵动岛模式" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="独立悬浮与边缘收起" Foreground="#4CC2FF"/><TextBlock Text="在桌面边缘显示媒体信息，可拖动并在暂停时收起。" TextWrapping="Wrap" Opacity="0.66"/></StackPanel></Button></UniformGrid>
<StackPanel Visibility="{Binding ViewModel.IsTaskbarMode, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="任务栏模式自定义" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
<ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Layer24}"><ui:CardControl.Header><StackPanel><TextBlock Text="可选层级" FontWeight="SemiBold"/><TextBlock Text="静置层始终存在，可按需要增加悬停操作和完整面板" Opacity="0.62" FontSize="12"/></StackPanel></ui:CardControl.Header><StackPanel MinWidth="500"><TextBlock Text="静置层：常驻任务栏，显示封面、标题/歌词、来源、进度和播放态频谱。" TextWrapping="Wrap" Margin="0,0,0,8"/><StackPanel Orientation="Horizontal"><TextBlock Text="悬停层" Width="70" VerticalAlignment="Center"/><TextBlock Text="鼠标移入文字区显示媒体按钮、输出设备、音量和进度。" Width="320" TextWrapping="Wrap" Opacity="0.72"/><ui:ToggleSwitch IsChecked="{Binding ViewModel.HoverLayerEnabled, Mode=TwoWay}" Margin="12,0,0,0"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><TextBlock Text="完整层" Width="70" VerticalAlignment="Center"/><TextBlock Text="任务栏外展开媒体详情、完整控制、音频设备和系统性能。" Width="320" TextWrapping="Wrap" Opacity="0.72"/><ui:ToggleSwitch IsChecked="{Binding ViewModel.FullLayerEnabled, Mode=TwoWay}" Margin="12,0,0,0"/></StackPanel><TextBlock Margin="0,8,0,0" Text="关闭悬停层但保留完整层时，文字区顶部会出现细杠入口。歌词只显示在静置层。" TextWrapping="Wrap" FontSize="12" Opacity="0.62"/></StackPanel></ui:CardControl>
<ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon WindowConsole20}" IsEnabled="{Binding ViewModel.FullLayerEnabled}"><ui:CardControl.Header><StackPanel><TextBlock Text="完整层布局" FontWeight="SemiBold"/><TextBlock Text="选择预设或组合需要的内容，至少保留一个分组" Opacity="0.62" FontSize="12"/></StackPanel></ui:CardControl.Header><StackPanel><StackPanel Orientation="Horizontal"><ui:Button Content="紧凑" Command="{Binding ViewModel.ApplyCompactFullPanelPresetCommand}" Margin="0,0,8,0"/><ui:Button Content="完整" Command="{Binding ViewModel.ApplyFullFullPanelPresetCommand}"/><TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding ViewModel.FullPanelLayoutStatus, StringFormat=当前：{0}}"/></StackPanel><WrapPanel Margin="0,12,0,0"><ui:ToggleSwitch Content="媒体信息" Margin="0,0,20,8" IsChecked="{Binding ViewModel.FullPanelMediaInfoVisible, Mode=TwoWay}" IsEnabled="{Binding ViewModel.CanToggleFullPanelMediaInfo}"/><ui:ToggleSwitch Content="媒体控制" Margin="0,0,20,8" IsChecked="{Binding ViewModel.FullPanelMediaControlsVisible, Mode=TwoWay}" IsEnabled="{Binding ViewModel.CanToggleFullPanelMediaControls}"/><ui:ToggleSwitch Content="音频控制" Margin="0,0,20,8" IsChecked="{Binding ViewModel.FullPanelAudioControlsVisible, Mode=TwoWay}" IsEnabled="{Binding ViewModel.CanToggleFullPanelAudioControls}"/><ui:ToggleSwitch Content="性能" IsChecked="{Binding ViewModel.FullPanelPerformanceVisible, Mode=TwoWay}" IsEnabled="{Binding ViewModel.CanToggleFullPanelPerformance}"/></WrapPanel></StackPanel></ui:CardControl>
<ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon ResizeLarge24}"><ui:CardControl.Header><StackPanel><TextBlock Text="组件间距" FontWeight="SemiBold"/><TextBlock Text="调整封面、文字、频谱以及悬停控件之间的留白" Opacity="0.62" FontSize="12"/></StackPanel></ui:CardControl.Header><Grid Width="360"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="78"/></Grid.ColumnDefinitions><Slider Minimum="4" Maximum="32" TickFrequency="2" IsSnapToTickEnabled="True" Value="{Binding ViewModel.ComponentSpacingDip, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Column="1" HorizontalAlignment="Right" Text="{Binding ViewModel.ComponentSpacingDip, StringFormat={}{0:0} DIP}"/></Grid></ui:CardControl>
<ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon TextAlignJustify24}"><ui:CardControl.Header><StackPanel><TextBlock Text="内容布局" FontWeight="SemiBold"/><TextBlock Text="改变任务栏文字的排列和对齐" Opacity="0.62" FontSize="12"/></StackPanel></ui:CardControl.Header><ComboBox MinWidth="190" SelectedValuePath="Tag" SelectedValue="{Binding ViewModel.ContentLayout, Mode=TwoWay}"><ComboBoxItem Content="紧凑单行" Tag="{x:Static settings:TaskbarContentLayout.CompactInline}"/><ComboBoxItem Content="自适应双行" Tag="{x:Static settings:TaskbarContentLayout.AdaptiveStack}"/><ComboBoxItem Content="居中双行" Tag="{x:Static settings:TaskbarContentLayout.CenteredStack}"/></ComboBox></ui:CardControl>
<ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon ProjectionScreen24}"><ui:CardControl.Header><StackPanel><TextBlock Text="目标显示器" FontWeight="SemiBold"/><TextBlock Text="断开时临时回退主屏，重连后恢复首选显示器" Opacity="0.62" FontSize="12"/></StackPanel></ui:CardControl.Header><ComboBox MinWidth="320" ItemsSource="{Binding ViewModel.MonitorOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="DeviceId" SelectedValue="{Binding ViewModel.TaskbarTargetMonitorDeviceId, Mode=TwoWay}"/></ui:CardControl>
</StackPanel>
<StackPanel Visibility="{Binding ViewModel.IsDynamicIslandMode, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="灵动岛模式自定义" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/><ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Orientation24}"><ui:CardControl.Header><StackPanel><TextBlock Text="内容方向" FontWeight="SemiBold"/><TextBlock Text="选择悬浮媒体内容的横向或纵向排布" Opacity="0.62" FontSize="12"/></StackPanel></ui:CardControl.Header><ComboBox MinWidth="190" SelectedValuePath="Tag" SelectedValue="{Binding ViewModel.Orientation, Mode=TwoWay}"><ComboBoxItem Content="自动" Tag="{x:Static settings:LayoutOrientationMode.Auto}"/><ComboBoxItem Content="横向" Tag="{x:Static settings:LayoutOrientationMode.Horizontal}"/><ComboBoxItem Content="纵向" Tag="{x:Static settings:LayoutOrientationMode.Vertical}"/></ComboBox></ui:CardControl><ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon ColorBackground20}"><ui:CardControl.Header><StackPanel><TextBlock Text="背景方案" FontWeight="SemiBold"/><TextBlock Text="使用系统主题配色或透明背景" Opacity="0.62" FontSize="12"/></StackPanel></ui:CardControl.Header><ComboBox MinWidth="190" SelectedValuePath="Tag" SelectedValue="{Binding ViewModel.DynamicIslandBackgroundMode, Mode=TwoWay}"><ComboBoxItem Content="系统主题" Tag="{x:Static settings:DynamicIslandBackgroundMode.SystemTheme}"/><ComboBoxItem Content="透明" Tag="{x:Static settings:DynamicIslandBackgroundMode.Transparent}"/></ComboBox></ui:CardControl><ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon PositionToBack20}"><ui:CardControl.Header><StackPanel><TextBlock Text="暂停时收起边缘" FontWeight="SemiBold"/><TextBlock Text="拖动到桌面边缘后，暂停时从该方向收起" Opacity="0.62" FontSize="12"/></StackPanel></ui:CardControl.Header><ComboBox MinWidth="190" SelectedValuePath="Tag" SelectedValue="{Binding ViewModel.DynamicIslandEdge, Mode=TwoWay}"><ComboBoxItem Content="顶部" Tag="{x:Static models:DynamicIslandEdge.Top}"/><ComboBoxItem Content="右侧" Tag="{x:Static models:DynamicIslandEdge.Right}"/><ComboBoxItem Content="底部" Tag="{x:Static models:DynamicIslandEdge.Bottom}"/><ComboBoxItem Content="左侧" Tag="{x:Static models:DynamicIslandEdge.Left}"/></ComboBox></ui:CardControl><Border Padding="14" CornerRadius="8" Background="#0CFFFFFF"><TextBlock Text="灵动岛沿用现有封面、文字、歌词和媒体操作；任务栏专用的三层、完整面板、图标避让与固定长度不会应用到此模式。" TextWrapping="Wrap" Opacity="0.66"/></Border></StackPanel>
<ui:Button Content="恢复本页默认设置" Icon="{ui:SymbolIcon ArrowReset24}" Margin="0,18,0,0" HorizontalAlignment="Left" Click="ResetButton_Click"/>
</StackPanel></Page>
