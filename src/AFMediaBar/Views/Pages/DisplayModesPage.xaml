<Page x:Class="AFMediaBar.Views.Pages.DisplayModesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:settings="clr-namespace:AFMediaBar.Classes.Settings"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Page.Resources><BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/></Page.Resources>

        <StackPanel MaxWidth="1000" Margin="16,16,24,32">
            <TextBlock Text="显示模式" FontSize="32" FontWeight="{DynamicResource AppTextStrongFontWeight}"/>
            <ui:TextBlock Text="先选择一种固定外观，再对层级、布局和密度做轻度调整" Appearance="Secondary" Margin="0,8,0,24"/>

            <UniformGrid Columns="2" Margin="0,0,0,24">
                <Button Margin="0,0,8,8" Padding="16" HorizontalContentAlignment="Stretch"
                        Command="{Binding ViewModel.SwitchToTaskbarModeCommand}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBlock Grid.ColumnSpan="2" Text="当前使用" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="#4CC2FF" Visibility="{Binding ViewModel.IsTaskbarMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <Border Width="64" Height="44" CornerRadius="7" Background="#E9222428">
                            <Grid Margin="6"><Border Width="26" Height="26" HorizontalAlignment="Left" CornerRadius="4" Background="#30FFFFFF"/>
                                <Rectangle Height="2" Margin="35,0,3,4" VerticalAlignment="Bottom" Fill="#FF75B9"/>
                                <StackPanel Margin="34,7,0,0"><Rectangle Height="4" Fill="#A0FFFFFF"/><Rectangle Height="3" Margin="0,5,10,0" Fill="#50FFFFFF"/></StackPanel></Grid>
                        </Border>
                        <StackPanel Grid.Column="1"><TextBlock Text="任务栏模式" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="已实现 · 静置 / 悬停 / 完整面板" Foreground="#4CC2FF" Margin="0,3,0,0"/>
                            <TextBlock Text="嵌入 Windows 任务栏，横向保留原播放器外观并叠加三层交互；左右任务栏保留紧凑纵向布局。" TextWrapping="Wrap" Opacity="0.66" Margin="0,5,0,0"/></StackPanel>
                    </Grid>
                </Button>
                <Button Margin="8,0,0,8" Padding="16" HorizontalContentAlignment="Stretch"
                        Command="{Binding ViewModel.SwitchToDynamicIslandModeCommand}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBlock Grid.ColumnSpan="2" Text="当前使用" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="#4CC2FF" Visibility="{Binding ViewModel.IsDynamicIslandMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <Border Width="64" Height="28" CornerRadius="14" Background="Black"><Rectangle Width="34" Height="4" RadiusX="2" Fill="#70FFFFFF"/></Border>
                        <StackPanel Grid.Column="1"><TextBlock Text="灵动岛模式" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="可用 · 保持现有外观" Foreground="#4CC2FF" Margin="0,3,0,0"/>
                            <TextBlock Text="独立悬浮于屏幕边缘；本批保留现有视觉与操作，新的固定三层外观将在后续批次接入。" TextWrapping="Wrap" Opacity="0.66" Margin="0,5,0,0"/></StackPanel>
                    </Grid>
                </Button>
                <Button Margin="0,8,8,0" Padding="16" IsEnabled="False" HorizontalContentAlignment="Stretch">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Ellipse Width="44" Height="44" HorizontalAlignment="Left" Fill="#3050A5FF" Stroke="#8050A5FF"/>
                        <StackPanel Grid.Column="1"><TextBlock Text="悬浮球模式" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="稍后推出" Opacity="0.55" Margin="0,3,0,0"/><TextBlock Text="固定静置、悬停、完整层外观将在任务栏模式稳定后开发。" TextWrapping="Wrap" Opacity="0.66" Margin="0,5,0,0"/></StackPanel>
                    </Grid>
                </Button>
                <Button Margin="8,8,0,0" Padding="16" IsEnabled="False" HorizontalContentAlignment="Stretch">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Width="64" Height="44" HorizontalAlignment="Left" CornerRadius="8" Background="#30305060" BorderBrush="#604CC2FF" BorderThickness="1"/>
                        <StackPanel Grid.Column="1"><TextBlock Text="桌面卡片模式" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="稍后推出" Opacity="0.55" Margin="0,3,0,0"/><TextBlock Text="桌面常驻卡片与可扩展完整信息布局将在后续开发。" TextWrapping="Wrap" Opacity="0.66" Margin="0,5,0,0"/></StackPanel>
                    </Grid>
                </Button>
            </UniformGrid>

            <Border Padding="16" CornerRadius="8" Background="#0D4CC2FF" BorderBrush="#304CC2FF" BorderThickness="1" Margin="0,0,0,20">
                <StackPanel><TextBlock Text="任务栏模式的固定内容" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Margin="0,7,0,0" TextWrapping="Wrap" Text="静置：原有封面和文字布局、歌词或标题与歌手/来源、底部只读进度、右侧微型频谱；封面、文字、频谱分别响应悬停。&#x0a;悬停：原文字区域直接模糊、淡化，清晰的媒体控制、输出设备、音量合成器与可点击/拖动进度覆盖其上。&#x0a;完整：任务栏外独立面板；关闭悬停层但保留完整层时，从文字区顶部细杠打开。"/>
                    <TextBlock Margin="0,8,0,0" Opacity="0.64" TextWrapping="Wrap" Text="歌词可用时会自动隐藏标题和歌手/来源，且只存在于静置层；请在“歌词”页控制歌词。"/>
                </StackPanel>
            </Border>

            <TextBlock Text="曲目切换通知" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon MusicNote220}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="显示刚切换到的当前曲目" FontWeight="SemiBold"/>
                        <TextBlock Text="这不是播放队列或下一首预览；首个快照只建立基线" Opacity="0.62" FontSize="12"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch Content="启用通知"
                                 IsChecked="{Binding ViewModel.TrackChangeNotificationEnabled, Mode=TwoWay}"/>
            </ui:CardControl>
            <StackPanel IsEnabled="{Binding ViewModel.TrackChangeNotificationEnabled}" Margin="0,0,0,20">
                <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Desktop24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="显示策略" FontWeight="SemiBold"/>
                            <TextBlock Text="默认在全屏窗口前抑制通知；鼠标进入通知会立即隐藏" Opacity="0.62" FontSize="12"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch Content="全屏时仍显示"
                                     IsChecked="{Binding ViewModel.ShowTrackChangeNotificationWhenFullscreen, Mode=TwoWay}"/>
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon PositionToBack20}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="位置与停留时间" FontWeight="SemiBold"/>
                            <TextBlock Text="通知使用目标显示器的工作区，避免覆盖任务栏" Opacity="0.62" FontSize="12"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <StackPanel MinWidth="470">
                        <ComboBox MinWidth="190" HorizontalAlignment="Left" SelectedValuePath="Tag"
                                  SelectedValue="{Binding ViewModel.TrackChangeNotificationPosition, Mode=TwoWay}">
                            <ComboBoxItem Content="左上" Tag="{x:Static settings:TrackChangeNotificationPosition.TopLeft}"/>
                            <ComboBoxItem Content="中上" Tag="{x:Static settings:TrackChangeNotificationPosition.TopCenter}"/>
                            <ComboBoxItem Content="右上" Tag="{x:Static settings:TrackChangeNotificationPosition.TopRight}"/>
                            <ComboBoxItem Content="左下" Tag="{x:Static settings:TrackChangeNotificationPosition.BottomLeft}"/>
                            <ComboBoxItem Content="中下" Tag="{x:Static settings:TrackChangeNotificationPosition.BottomCenter}"/>
                            <ComboBoxItem Content="右下" Tag="{x:Static settings:TrackChangeNotificationPosition.BottomRight}"/>
                        </ComboBox>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Slider Width="260" Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding ViewModel.TrackChangeNotificationDurationSeconds, Mode=TwoWay}"/>
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center"
                                       Text="{Binding ViewModel.TrackChangeNotificationDurationSeconds, StringFormat={}{0} 秒}"/>
                        </StackPanel>
                    </StackPanel>
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon ProjectionScreen24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="通知目标显示器" FontWeight="SemiBold"/>
                            <TextBlock Text="前台模式会在每次通知前重新解析；失败时回退到固定目标或主屏" Opacity="0.62" FontSize="12"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <StackPanel MinWidth="470">
                        <ComboBox MinWidth="220" HorizontalAlignment="Left" SelectedValuePath="Tag"
                                  SelectedValue="{Binding ViewModel.TrackChangeNotificationTargetMode, Mode=TwoWay}">
                            <ComboBoxItem Content="固定显示器" Tag="{x:Static settings:NotificationTargetMode.Fixed}"/>
                            <ComboBoxItem Content="前台窗口所在显示器" Tag="{x:Static settings:NotificationTargetMode.ForegroundWindow}"/>
                        </ComboBox>
                        <ComboBox Margin="0,10,0,0" MinWidth="320" HorizontalAlignment="Left"
                                  ItemsSource="{Binding ViewModel.MonitorOptions}"
                                  DisplayMemberPath="DisplayName" SelectedValuePath="DeviceId"
                                  IsEnabled="{Binding ViewModel.CanSelectTrackChangeNotificationMonitor}"
                                  SelectedValue="{Binding ViewModel.TrackChangeNotificationFixedMonitorDeviceId, Mode=TwoWay}"/>
                    </StackPanel>
                </ui:CardControl>
            </StackPanel>

            <StackPanel IsEnabled="{Binding ViewModel.IsTaskbarMode}">
                <TextBlock Text="任务栏轻度自定义" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon ProjectionScreen24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="任务栏目标显示器" FontWeight="SemiBold"/>
                            <TextBlock Text="与曲目通知独立；目标断开时临时回退主屏，重连后自动恢复" Opacity="0.62" FontSize="12"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ComboBox MinWidth="320" HorizontalAlignment="Left"
                              ItemsSource="{Binding ViewModel.MonitorOptions}"
                              DisplayMemberPath="DisplayName" SelectedValuePath="DeviceId"
                              SelectedValue="{Binding ViewModel.TaskbarTargetMonitorDeviceId, Mode=TwoWay}"/>
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Layer24}"><ui:CardControl.Header><StackPanel><TextBlock Text="可选层级" FontWeight="SemiBold"/><TextBlock Text="静置层始终存在；关闭悬停层后，完整层仍可从文字区顶部细杠打开" Opacity="0.62" FontSize="12"/></StackPanel></ui:CardControl.Header>
                    <StackPanel Orientation="Horizontal"><ui:ToggleSwitch Content="悬停层" IsChecked="{Binding ViewModel.HoverLayerEnabled, Mode=TwoWay}" Margin="0,0,20,0"/><ui:ToggleSwitch Content="完整层" IsChecked="{Binding ViewModel.FullLayerEnabled, Mode=TwoWay}"/></StackPanel>
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon WindowConsole20}"
                                IsEnabled="{Binding ViewModel.FullLayerEnabled}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="完整层布局" FontWeight="SemiBold"/>
                            <TextBlock Text="固定 520 DIP 宽度，高度随可见内容自动调整" Opacity="0.62" FontSize="12"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <StackPanel MinWidth="470">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <ui:Button Content="紧凑" Command="{Binding ViewModel.ApplyCompactFullPanelPresetCommand}" Margin="0,0,8,0"/>
                            <ui:Button Content="完整" Command="{Binding ViewModel.ApplyFullFullPanelPresetCommand}" Margin="0,0,12,0"/>
                            <TextBlock VerticalAlignment="Center" Opacity="0.7"
                                       Text="{Binding ViewModel.FullPanelLayoutStatus, StringFormat=当前：{0}}"/>
                        </StackPanel>
                        <WrapPanel>
                            <ui:ToggleSwitch Content="媒体信息" Margin="0,0,20,8"
                                             IsChecked="{Binding ViewModel.FullPanelMediaInfoVisible, Mode=TwoWay}"
                                             IsEnabled="{Binding ViewModel.CanToggleFullPanelMediaInfo}"/>
                            <ui:ToggleSwitch Content="媒体控制" Margin="0,0,20,8"
                                             IsChecked="{Binding ViewModel.FullPanelMediaControlsVisible, Mode=TwoWay}"
                                             IsEnabled="{Binding ViewModel.CanToggleFullPanelMediaControls}"/>
                            <ui:ToggleSwitch Content="音频控制" Margin="0,0,20,8"
                                             IsChecked="{Binding ViewModel.FullPanelAudioControlsVisible, Mode=TwoWay}"
                                             IsEnabled="{Binding ViewModel.CanToggleFullPanelAudioControls}"/>
                            <ui:ToggleSwitch Content="性能" Margin="0,0,0,8"
                                             IsChecked="{Binding ViewModel.FullPanelPerformanceVisible, Mode=TwoWay}"
                                             IsEnabled="{Binding ViewModel.CanToggleFullPanelPerformance}"/>
                        </WrapPanel>
                        <TextBlock Text="至少保留一个分组；来源始终跟随媒体信息显示。" FontSize="12" Opacity="0.62"/>
                    </StackPanel>
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Gauge24}"><ui:CardControl.Header><StackPanel><TextBlock Text="信息密度" FontWeight="SemiBold"/><TextBlock Text="统一改变按钮、进度和封面—文字—频谱间隔；最小宽度只施加到中间文字区" Opacity="0.62" FontSize="12"/></StackPanel></ui:CardControl.Header>
                    <ComboBox MinWidth="190" SelectedValuePath="Tag" SelectedValue="{Binding ViewModel.Density, Mode=TwoWay}"><ComboBoxItem Content="极简" Tag="{x:Static settings:TaskbarInformationDensity.Minimal}"/><ComboBoxItem Content="均衡" Tag="{x:Static settings:TaskbarInformationDensity.Balanced}"/><ComboBoxItem Content="信息优先" Tag="{x:Static settings:TaskbarInformationDensity.Information}"/></ComboBox>
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon TextAlignJustify24}"><ui:CardControl.Header><StackPanel><TextBlock Text="内容布局" FontWeight="SemiBold"/><TextBlock Text="改变媒体文字的排列和对齐，不允许任意跨层拖放" Opacity="0.62" FontSize="12"/></StackPanel></ui:CardControl.Header>
                    <ComboBox MinWidth="190" SelectedValuePath="Tag" SelectedValue="{Binding ViewModel.ContentLayout, Mode=TwoWay}"><ComboBoxItem Content="紧凑单行" Tag="{x:Static settings:TaskbarContentLayout.CompactInline}"/><ComboBoxItem Content="自适应双行" Tag="{x:Static settings:TaskbarContentLayout.AdaptiveStack}"/><ComboBoxItem Content="居中双行" Tag="{x:Static settings:TaskbarContentLayout.CenteredStack}"/></ComboBox>
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Gauge24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="程序长度" FontWeight="SemiBold"/>
                            <TextBlock Text="固定长度时，超出区域的标题、歌手和歌词会自动滚动" Opacity="0.62" FontSize="12"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <StackPanel MinWidth="470">
                        <ui:ToggleSwitch Content="跟随标题、歌手和歌词长度"
                                         IsChecked="{Binding ViewModel.FollowMediaTextLength, Mode=TwoWay}"/>
                        <StackPanel Margin="0,12,0,0" IsEnabled="{Binding ViewModel.UsesFixedTaskbarLength}">
                            <StackPanel Orientation="Horizontal">
                                <Slider Width="300"
                                        Minimum="{Binding ViewModel.FixedTaskbarLengthMinimum}"
                                        Maximum="{Binding ViewModel.FixedTaskbarLengthMaximum}"
                                        SmallChange="4" LargeChange="20"
                                        Value="{Binding ViewModel.FixedTaskbarLengthDip, Mode=TwoWay}"/>
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center"
                                           Text="{Binding ViewModel.FixedTaskbarLengthDip, StringFormat={}{0:0} DIP}"/>
                            </StackPanel>
                            <TextBlock Margin="0,5,0,0" FontSize="12" Opacity="0.62"
                                       Text="{Binding ViewModel.FixedTaskbarLengthRangeText}"/>
                        </StackPanel>
                    </StackPanel>
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Orientation24}"><ui:CardControl.Header><StackPanel><TextBlock Text="任务栏方向" FontWeight="SemiBold"/><TextBlock Text="自动可识别底部、顶部、左侧和右侧任务栏" Opacity="0.62" FontSize="12"/></StackPanel></ui:CardControl.Header>
                    <ComboBox MinWidth="190" SelectedValuePath="Tag" SelectedValue="{Binding ViewModel.Orientation, Mode=TwoWay}"><ComboBoxItem Content="自动" Tag="{x:Static settings:LayoutOrientationMode.Auto}"/><ComboBoxItem Content="横向" Tag="{x:Static settings:LayoutOrientationMode.Horizontal}"/><ComboBoxItem Content="纵向（兼容布局）" Tag="{x:Static settings:LayoutOrientationMode.Vertical}"/></ComboBox>
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon LockClosed24}"><ui:CardControl.Header><StackPanel><TextBlock Text="位置与安全区域" FontWeight="SemiBold"/><TextBlock Text="拖动空白区域移动；可避开通知图标和任务栏按钮" Opacity="0.62" FontSize="12"/></StackPanel></ui:CardControl.Header>
                    <StackPanel Orientation="Horizontal"><ui:ToggleSwitch Content="锁定位置" IsChecked="{Binding ViewModel.IsTaskbarPositionLocked, Mode=TwoWay}" Margin="0,0,20,0"/><ui:ToggleSwitch Content="避开图标" IsChecked="{Binding ViewModel.IsTaskbarAvoidingIcons, Mode=TwoWay}" Margin="0,0,20,0"/><ui:Button Content="重置位置" Command="{Binding ViewModel.ResetTaskbarPositionCommand}"/></StackPanel>
                </ui:CardControl>
            </StackPanel>

            <Border Margin="0,20,0,0" Padding="14" CornerRadius="8" Background="#0CFFFFFF"><TextBlock Text="深度自定义（任意组件跨层放置）将在四种固定外观与功能稳定后开发。" TextWrapping="Wrap" Opacity="0.66"/></Border>
            <ui:Button Content="恢复本页默认设置" Icon="{ui:SymbolIcon ArrowReset24}" Margin="0,18,0,0" HorizontalAlignment="Left" Click="ResetButton_Click"/>
        </StackPanel>

</Page>
