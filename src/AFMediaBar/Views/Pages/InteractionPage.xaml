<Page
    x:Class="AFMediaBar.Views.Pages.InteractionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:AFMediaBar.Components"
    xmlns:settings="clr-namespace:AFMediaBar.Classes.Settings"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ScrollViewer.CanContentScroll="False">

    <!--
        交互页 / Interaction page

                        按「先选按键，再分别设置媒体栏和托盘」排列，共三个分组。

        排布规则：一行一个绑定，一行恰好一个下拉框，全部单列。上一版把「程序内」的两张卡并排成两列，
        在 820 DIP 版心内每列只剩约 370，标题与控件挤在一起——这正是「杂糅」的另一个来源。

        Laid out as "pick the modifier first, then configure each surface", across three groups.

        Layout rule: one binding per row, exactly one select per row, all in a single column. The previous version
        put the program-in cards side by side, which inside an 820 DIP measure left about 370 per column and
        squeezed title and control together; that was another source of the clutter.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <components:SettingsGroupStrip
            Grid.Row="0"
            Margin="{StaticResource AfSettingsHeaderMargin}"
            MaxWidth="{StaticResource AfSettingsContentMaxWidth}"
            PageIcon="{ui:SymbolIcon HandDraw24}"
            Subtitle="为媒体栏与托盘上的每种操作指定结果"
            Target="{Binding ElementName=PageScroll}"
            Title="交互" />

        <ScrollViewer
            x:Name="PageScroll"
            Grid.Row="1"
            Margin="{StaticResource AfSettingsScrollMargin}"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                x:Name="PageRoot"
                MaxWidth="{StaticResource AfSettingsContentMaxWidth}"
                Loaded="OnPageLoaded">

                <components:SettingsGroup
                    Description="按住该按键再滚动滚轮，触发「组合滚轮」"
                    Header="共用的按键"
                    Icon="{ui:SymbolIcon Keyboard24}">
                    <StackPanel>
                        <components:SettingsDiagram Margin="0,0,0,12" Kind="WheelGestures" />

                        <components:SettingsRow
                            Description="媒体栏与托盘共用同一个按键"
                            Icon="{ui:SymbolIcon Keyboard24}"
                            Title="组合滚轮按键">
                            <ComboBox
                                MinWidth="150"
                                SelectedValue="{Binding ViewModel.Modifier, Mode=TwoWay}"
                                SelectedValuePath="Tag">
                                <ComboBoxItem Content="Shift 键" Tag="{x:Static settings:InteractionModifier.Shift}" />
                                <ComboBoxItem Content="鼠标左键" Tag="{x:Static settings:InteractionModifier.LeftMouseButton}" />
                                <ComboBoxItem Content="鼠标右键" Tag="{x:Static settings:InteractionModifier.RightMouseButton}" />
                            </ComboBox>
                        </components:SettingsRow>

                        <components:SettingsCallout
                            Margin="0,4,0,0"
                            IsAccent="False"
                            Symbol="Info24"
                            Text="使用鼠标左键或右键作为按键时，滚轮后产生的点击或菜单会被抑制，避免误触。" />
                    </StackPanel>
                </components:SettingsGroup>

                <components:SettingsGroup
                    Description="点在静置层上的结果"
                    Header="程序内（静置层）"
                    Icon="{ui:SymbolIcon CursorClick24}">
                    <StackPanel>
                        <components:SettingsDiagram Margin="0,0,0,12" Kind="InputGestures" />

                        <components:SettingsRow
                            Description="与下一项可分别设置"
                            Icon="{ui:SymbolIcon Play24}"
                            Title="点击封面">
                            <ComboBox
                                MinWidth="200"
                                SelectedValue="{Binding ViewModel.ArtworkClickAction, Mode=TwoWay}"
                                SelectedValuePath="Tag">
                                <ComboBoxItem Content="播放 / 暂停" Tag="{x:Static settings:PlayerClickAction.TogglePlayPause}" />
                                <ComboBoxItem Content="打开播放中的程序" Tag="{x:Static settings:PlayerClickAction.ActivateSource}" />
                                <ComboBoxItem Content="打开完整层" Tag="{x:Static settings:PlayerClickAction.OpenFullPanel}" />
                            </ComboBox>
                        </components:SettingsRow>

                        <components:SettingsRow
                            Icon="{ui:SymbolIcon TextQuote24}"
                            Title="点击标题或歌词">
                            <ComboBox
                                MinWidth="200"
                                SelectedValue="{Binding ViewModel.TextClickAction, Mode=TwoWay}"
                                SelectedValuePath="Tag">
                                <ComboBoxItem Content="打开播放中的程序" Tag="{x:Static settings:PlayerClickAction.ActivateSource}" />
                                <ComboBoxItem Content="播放 / 暂停" Tag="{x:Static settings:PlayerClickAction.TogglePlayPause}" />
                                <ComboBoxItem Content="打开完整层" Tag="{x:Static settings:PlayerClickAction.OpenFullPanel}" />
                            </ComboBox>
                        </components:SettingsRow>

                        <components:SettingsRow
                            Description="不按组合键时的滚轮行为"
                            Icon="{ui:SymbolIcon Cursor24}"
                            Title="普通滚轮">
                            <ComboBox
                                MinWidth="200"
                                SelectedValue="{Binding ViewModel.PrimaryWheelAction, Mode=TwoWay}"
                                SelectedValuePath="Tag">
                                <ComboBoxItem Content="上一首 / 下一首" Tag="{x:Static settings:WheelAction.PreviousNext}" />
                                <ComboBoxItem Content="切换输出设备" Tag="{x:Static settings:WheelAction.OutputDevice}" />
                                <ComboBoxItem Content="调节当前媒体音量" Tag="{x:Static settings:WheelAction.CurrentApplicationVolume}" />
                                <ComboBoxItem Content="切换播放器" Tag="{x:Static settings:WheelAction.SwitchMediaSource}" />
                            </ComboBox>
                        </components:SettingsRow>

                        <components:SettingsRow
                            Description="按住上述按键再滚动滚轮"
                            Icon="{ui:SymbolIcon Keyboard24}"
                            Title="组合滚轮">
                            <ComboBox
                                MinWidth="200"
                                SelectedValue="{Binding ViewModel.ChordWheelAction, Mode=TwoWay}"
                                SelectedValuePath="Tag">
                                <ComboBoxItem Content="切换播放器" Tag="{x:Static settings:WheelAction.SwitchMediaSource}" />
                                <ComboBoxItem Content="调节当前媒体音量" Tag="{x:Static settings:WheelAction.CurrentApplicationVolume}" />
                                <ComboBoxItem Content="切换输出设备" Tag="{x:Static settings:WheelAction.OutputDevice}" />
                                <ComboBoxItem Content="上一首 / 下一首" Tag="{x:Static settings:WheelAction.PreviousNext}" />
                            </ComboBox>
                        </components:SettingsRow>
                    </StackPanel>
                </components:SettingsGroup>

                <components:SettingsGroup Header="托盘图标" Icon="{ui:SymbolIcon Apps24}">
                    <StackPanel>
                        <components:SettingsDiagram Margin="0,0,0,12" Kind="TrayOverflow" />

                        <components:SettingsRow
                            Description="右键始终打开菜单；此处设置左键单击行为"
                            Icon="{ui:SymbolIcon CursorClick24}"
                            Title="点击托盘图标">
                            <ComboBox
                                MinWidth="200"
                                SelectedValue="{Binding ViewModel.TrayClickAction, Mode=TwoWay}"
                                SelectedValuePath="Tag">
                                <ComboBoxItem Content="打开音频控制菜单" Tag="{x:Static settings:TrayClickAction.OpenAudioControl}" />
                                <ComboBoxItem Content="打开输出设备菜单" Tag="{x:Static settings:TrayClickAction.OpenOutputDeviceMenu}" />
                                <ComboBoxItem Content="打开当前应用音量菜单" Tag="{x:Static settings:TrayClickAction.OpenCurrentAppVolumeMenu}" />
                                <ComboBoxItem Content="打开设置页" Tag="{x:Static settings:TrayClickAction.OpenSettings}" />
                                <ComboBoxItem Content="打开右键菜单" Tag="{x:Static settings:TrayClickAction.OpenContextMenu}" />
                            </ComboBox>
                        </components:SettingsRow>

                        <components:SettingsRow
                            Description="仅在指针位于托盘图标上时生效"
                            Icon="{ui:SymbolIcon Cursor24}"
                            Title="普通滚轮">
                            <ComboBox
                                MinWidth="200"
                                SelectedValue="{Binding ViewModel.TrayPrimaryWheelAction, Mode=TwoWay}"
                                SelectedValuePath="Tag">
                                <ComboBoxItem Content="切换输出设备" Tag="{x:Static settings:TrayWheelBehavior.SwitchOutputDevice}" />
                                <ComboBoxItem Content="调节当前媒体音量" Tag="{x:Static settings:TrayWheelBehavior.AdjustVolume}" />
                            </ComboBox>
                        </components:SettingsRow>

                        <components:SettingsRow
                            Description="先显示设备候选，停止滚动约 1.2 秒后应用"
                            Icon="{ui:SymbolIcon Keyboard24}"
                            Title="组合滚轮">
                            <ComboBox
                                MinWidth="200"
                                SelectedValue="{Binding ViewModel.TrayChordWheelAction, Mode=TwoWay}"
                                SelectedValuePath="Tag">
                                <ComboBoxItem Content="调节当前媒体音量" Tag="{x:Static settings:TrayWheelBehavior.AdjustVolume}" />
                                <ComboBoxItem Content="切换输出设备" Tag="{x:Static settings:TrayWheelBehavior.SwitchOutputDevice}" />
                            </ComboBox>
                        </components:SettingsRow>
                    </StackPanel>
                </components:SettingsGroup>

                <ui:Button
                    Margin="0,16,0,40"
                    HorizontalAlignment="Left"
                    Click="ResetButton_Click"
                    Content="恢复本页默认设置"
                    Icon="{ui:SymbolIcon ArrowReset24}"
                    Style="{StaticResource AfSettingsButtonStyle}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
