<Page x:Class="AFMediaBar.Views.Pages.InteractionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:settings="clr-namespace:AFMediaBar.Classes.Settings"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1000" Margin="16,16,24,32">
            <TextBlock Text="交互" FontSize="32" FontWeight="{DynamicResource AppTextStrongFontWeight}"/>
            <ui:TextBlock Text="像按键绑定一样，为任务栏和托盘的每种操作选择一个结果" Appearance="Secondary" Margin="0,8,0,24"/>

            <TextBlock Text="程序内" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon CursorClick24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="点击操作" FontWeight="SemiBold"/>
                        <TextBlock Text="仅作用于任务栏静置层；完整层保持固定控制" Opacity="0.62" FontSize="12"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel MinWidth="520">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
                        <TextBlock Text="点击封面" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" SelectedValuePath="Tag" SelectedValue="{Binding ViewModel.ArtworkClickAction, Mode=TwoWay}">
                            <ComboBoxItem Content="播放 / 暂停" Tag="{x:Static settings:PlayerClickAction.TogglePlayPause}"/>
                            <ComboBoxItem Content="打开播放中的程序" Tag="{x:Static settings:PlayerClickAction.ActivateSource}"/>
                        </ComboBox>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
                        <TextBlock Text="点击标题或歌词" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" SelectedValuePath="Tag" SelectedValue="{Binding ViewModel.TextClickAction, Mode=TwoWay}">
                            <ComboBoxItem Content="打开播放中的程序" Tag="{x:Static settings:PlayerClickAction.ActivateSource}"/>
                            <ComboBoxItem Content="播放 / 暂停" Tag="{x:Static settings:PlayerClickAction.TogglePlayPause}"/>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Keyboard24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="组合滚轮修饰键" FontWeight="SemiBold"/>
                        <TextBlock Text="程序内与托盘共用；鼠标按键滚轮会抑制随后产生的点击或菜单" Opacity="0.62" FontSize="12"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox MinWidth="220" SelectedValuePath="Tag" SelectedValue="{Binding ViewModel.Modifier, Mode=TwoWay}">
                    <ComboBoxItem Content="Shift" Tag="{x:Static settings:InteractionModifier.Shift}"/>
                    <ComboBoxItem Content="鼠标左键" Tag="{x:Static settings:InteractionModifier.LeftMouseButton}"/>
                    <ComboBoxItem Content="鼠标右键" Tag="{x:Static settings:InteractionModifier.RightMouseButton}"/>
                </ComboBox>
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,20" Icon="{ui:SymbolIcon Cursor24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="滚轮操作" FontWeight="SemiBold"/>
                        <TextBlock Text="向上为上一项、增大音量，向下为下一项、减小音量" Opacity="0.62" FontSize="12"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel MinWidth="520">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
                        <TextBlock Text="普通滚轮" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" SelectedValuePath="Tag" SelectedValue="{Binding ViewModel.PrimaryWheelAction, Mode=TwoWay}">
                            <ComboBoxItem Content="上一首 / 下一首" Tag="{x:Static settings:WheelAction.PreviousNext}"/>
                            <ComboBoxItem Content="切换输出设备" Tag="{x:Static settings:WheelAction.OutputDevice}"/>
                            <ComboBoxItem Content="当前媒体音量" Tag="{x:Static settings:WheelAction.CurrentApplicationVolume}"/>
                            <ComboBoxItem Content="切换可用媒体源" Tag="{x:Static settings:WheelAction.SwitchMediaSource}"/>
                        </ComboBox>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
                        <TextBlock Text="按键 + 滚轮" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" SelectedValuePath="Tag" SelectedValue="{Binding ViewModel.ChordWheelAction, Mode=TwoWay}">
                            <ComboBoxItem Content="切换可用媒体源" Tag="{x:Static settings:WheelAction.SwitchMediaSource}"/>
                            <ComboBoxItem Content="当前媒体音量" Tag="{x:Static settings:WheelAction.CurrentApplicationVolume}"/>
                            <ComboBoxItem Content="切换输出设备" Tag="{x:Static settings:WheelAction.OutputDevice}"/>
                            <ComboBoxItem Content="上一首 / 下一首" Tag="{x:Static settings:WheelAction.PreviousNext}"/>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </ui:CardControl>

            <TextBlock Text="托盘图标" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Apps24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="点击操作" FontWeight="SemiBold"/>
                        <TextBlock Text="右键始终可打开菜单；左键也可以绑定到同一菜单" Opacity="0.62" FontSize="12"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <Grid MinWidth="520">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
                    <TextBlock Text="点击托盘图标" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" SelectedValuePath="Tag" SelectedValue="{Binding ViewModel.TrayClickAction, Mode=TwoWay}">
                        <ComboBoxItem Content="打开音频控制菜单" Tag="{x:Static settings:TrayClickAction.OpenAudioControl}"/>
                        <ComboBoxItem Content="打开设置页" Tag="{x:Static settings:TrayClickAction.OpenSettings}"/>
                        <ComboBoxItem Content="打开右键菜单" Tag="{x:Static settings:TrayClickAction.OpenContextMenu}"/>
                    </ComboBox>
                </Grid>
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Settings24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="滚轮操作" FontWeight="SemiBold"/>
                        <TextBlock Text="设备候选会立即显示，停止滚动约 1.2 秒后应用" Opacity="0.62" FontSize="12"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel MinWidth="520">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
                        <TextBlock Text="普通滚轮" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" SelectedValuePath="Tag" SelectedValue="{Binding ViewModel.TrayPrimaryWheelAction, Mode=TwoWay}">
                            <ComboBoxItem Content="切换输出设备" Tag="{x:Static settings:TrayWheelBehavior.SwitchOutputDevice}"/>
                            <ComboBoxItem Content="调节当前媒体音量" Tag="{x:Static settings:TrayWheelBehavior.AdjustVolume}"/>
                        </ComboBox>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
                        <TextBlock Text="按键 + 滚轮" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" SelectedValuePath="Tag" SelectedValue="{Binding ViewModel.TrayChordWheelAction, Mode=TwoWay}">
                            <ComboBoxItem Content="调节当前媒体音量" Tag="{x:Static settings:TrayWheelBehavior.AdjustVolume}"/>
                            <ComboBoxItem Content="切换输出设备" Tag="{x:Static settings:TrayWheelBehavior.SwitchOutputDevice}"/>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </ui:CardControl>

            <Border Padding="14" CornerRadius="8" Background="#0CFFFFFF">
                <TextBlock Text="建议在 Windows 的任务栏设置中，将 AF Media Bar 图标从隐藏的小箭头区域拖到任务栏，以便直接点击和滚动。" TextWrapping="Wrap" Opacity="0.7"/>
            </Border>
            <ui:Button Content="恢复本页默认设置" Icon="{ui:SymbolIcon ArrowReset24}" Margin="0,18,0,0" HorizontalAlignment="Left" Click="ResetButton_Click"/>
        </StackPanel>
    </ScrollViewer>
</Page>
