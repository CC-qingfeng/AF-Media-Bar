<Page x:Class="AFMediaBar.Views.Pages.InteractionPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:settings="clr-namespace:AFMediaBar.Classes.Settings" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
<StackPanel MaxWidth="1000" Margin="16,16,24,32">
  <TextBlock Text="交互" FontSize="32" FontWeight="{DynamicResource AppTextStrongFontWeight}"/><ui:TextBlock Text="播放器表面使用媒体手势；托盘只负责输出设备和当前媒体音量；完整层使用显式按钮和局部控件" Appearance="Secondary" Margin="0,8,0,24"/>
  <TextBlock Text="播放器操作方式" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
  <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon HandDraw24}"><ui:CardControl.Header><StackPanel><TextBlock Text="交互预设" FontWeight="SemiBold"/><TextBlock Text="手势优先会在任务栏主体和悬停层隐藏三个媒体按钮；完整层始终保留按钮" Opacity="0.62" FontSize="12"/></StackPanel></ui:CardControl.Header>
   <ComboBox MinWidth="220" SelectedValuePath="Tag" SelectedValue="{Binding ViewModel.Mode, Mode=TwoWay}"><ComboBoxItem Content="按钮优先（只显示按钮）" Tag="{x:Static settings:MediaInteractionMode.Buttons}"/><ComboBoxItem Content="混合操作（按钮 + 封面点击 + 滚轮）" Tag="{x:Static settings:MediaInteractionMode.Hybrid}"/><ComboBoxItem Content="手势优先（主体和悬停层隐藏三个按钮）" Tag="{x:Static settings:MediaInteractionMode.Gestures}"/></ComboBox>
  </ui:CardControl>
  <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Cursor24}"><ui:CardControl.Header><StackPanel><TextBlock Text="普通滚轮" FontWeight="SemiBold"/><TextBlock Text="向上为上一项，向下为下一项；完整层不使用此映射" Opacity="0.62" FontSize="12"/></StackPanel></ui:CardControl.Header>
   <ComboBox MinWidth="220" SelectedValuePath="Tag" SelectedValue="{Binding ViewModel.PrimaryWheelAction, Mode=TwoWay}"><ComboBoxItem Content="切换上一首 / 下一首" Tag="{x:Static settings:WheelAction.PreviousNext}"/><ComboBoxItem Content="切换媒体源" Tag="{x:Static settings:WheelAction.SwitchMediaSource}"/></ComboBox>
  </ui:CardControl>
  <ui:CardControl Margin="0,0,0,20" Icon="{ui:SymbolIcon CursorClick24}"><ui:CardControl.Header><StackPanel><TextBlock Text="按键 + 滚轮" FontWeight="SemiBold"/><TextBlock Text="可选左键或右键；关闭时只使用普通滚轮" Opacity="0.62" FontSize="12"/></StackPanel></ui:CardControl.Header>
   <StackPanel><ui:ToggleSwitch Content="启用按键 + 滚轮" IsChecked="{Binding ViewModel.ChordWheelEnabled, Mode=TwoWay}"/><StackPanel Margin="0,10,0,0" Orientation="Horizontal" IsEnabled="{Binding ViewModel.CanConfigureChord}"><ComboBox Width="130" Margin="0,0,10,0" SelectedValuePath="Tag" SelectedValue="{Binding ViewModel.ChordButton, Mode=TwoWay}"><ComboBoxItem Content="左键 + 滚轮" Tag="{x:Static settings:MouseChordButton.Left}"/><ComboBoxItem Content="右键 + 滚轮" Tag="{x:Static settings:MouseChordButton.Right}"/></ComboBox><ComboBox Width="220" SelectedValuePath="Tag" SelectedValue="{Binding ViewModel.ChordWheelAction, Mode=TwoWay}"><ComboBoxItem Content="切换上一首 / 下一首" Tag="{x:Static settings:WheelAction.PreviousNext}"/><ComboBoxItem Content="切换媒体源" Tag="{x:Static settings:WheelAction.SwitchMediaSource}"/></ComboBox></StackPanel></StackPanel>
  </ui:CardControl>
  <TextBlock Text="通知区域图标" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
  <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon Apps24}"><ui:CardControl.Header><StackPanel><TextBlock Text="左键单击" FontWeight="SemiBold"/><TextBlock Text="右键始终保留正常菜单" Opacity="0.62" FontSize="12"/></StackPanel></ui:CardControl.Header><ComboBox MinWidth="220" SelectedValuePath="Tag" SelectedValue="{Binding ViewModel.TrayClickAction, Mode=TwoWay}"><ComboBoxItem Content="不执行操作" Tag="{x:Static settings:TrayClickAction.None}"/><ComboBoxItem Content="打开设置" Tag="{x:Static settings:TrayClickAction.OpenSettings}"/><ComboBoxItem Content="打开音频控制" Tag="{x:Static settings:TrayClickAction.OpenAudioControl}"/></ComboBox></ui:CardControl>
  <ui:CardControl Icon="{ui:SymbolIcon Settings24}"><ui:CardControl.Header><StackPanel><TextBlock Text="托盘滚轮" FontWeight="SemiBold"/><TextBlock Text="独立于播放器手势，并实时更新原生提示" Opacity="0.62" FontSize="12"/></StackPanel></ui:CardControl.Header><ComboBox MinWidth="220" SelectedValuePath="Tag" SelectedValue="{Binding ViewModel.TrayWheelBehavior, Mode=TwoWay}"><ComboBoxItem Content="切换输出设备" Tag="{x:Static settings:TrayWheelBehavior.SwitchOutputDevice}"/><ComboBoxItem Content="调节当前媒体音量" Tag="{x:Static settings:TrayWheelBehavior.AdjustVolume}"/><ComboBoxItem Content="禁用" Tag="{x:Static settings:TrayWheelBehavior.Disabled}"/></ComboBox></ui:CardControl>
  <ui:Button Content="恢复本页默认设置" Icon="{ui:SymbolIcon ArrowReset24}" Margin="0,18,0,0" HorizontalAlignment="Left" Click="ResetButton_Click"/>
 </StackPanel>
</Page>
