<Page
    x:Class="AFMediaBar.Views.Pages.LyricsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:AFMediaBar.Components"
    xmlns:settings="clr-namespace:AFMediaBar.Classes.Settings"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <!--
        歌词页 / Lyrics page

        五张卡片的选项和绑定保持不变。原来的说明条写死 #0D4CC2FF 和 #304CC2FF，
        深色主题下偏亮、浅色主题下偏脏，而且永远不跟随系统主色；现在改用 SettingsCallout 的主题化主色语气。
        The five cards keep their options and bindings. The old note hardcoded #0D4CC2FF and #304CC2FF, which read
        too bright in dark and muddy in light and never followed the system accent; it is now the accent tone of
        the themed SettingsCallout.
    -->
    <StackPanel
        x:Name="PageRoot"
        MaxWidth="{StaticResource AfSettingsContentMaxWidth}"
        Margin="{StaticResource AfSettingsPageMargin}"
        Loaded="OnPageLoaded">

        <TextBlock Style="{StaticResource AfSettingsPageTitleStyle}" Text="歌词" />
        <TextBlock Style="{StaticResource AfSettingsPageSubtitleStyle}" Text="歌词是媒体内容，而不是显示模式组件" />

        <components:SettingsCallout
            Margin="0,0,0,24"
            IsAccent="True"
            Symbol="TextQuote24"
            Text="歌词仅显示在静置层。当前歌词可用并启用时，会自动隐藏标题和歌手/来源；悬停层与完整层始终显示媒体信息。" />

        <ContentControl
            Margin="0,0,0,24"
            ContentTemplate="{StaticResource AfDiagramLyricsLines}" />

        <ContentControl
            Margin="0,0,0,12"
            Content="显示"
            ContentTemplate="{StaticResource AfSettingsSectionHeaderTemplate}" />

        <ui:CardControl Margin="{StaticResource AfSettingsCardGap}">
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="TextQuote24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource AfSettingsCardTitleStyle}" Text="显示实时歌词" />
                    <TextBlock
                        Style="{StaticResource AfSettingsCardDescriptionStyle}"
                        Text="没有歌词时自动回退为标题与歌手，歌手为空时显示来源" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding ViewModel.LyricsEnabled, Mode=TwoWay}" />
        </ui:CardControl>

        <ui:CardControl Margin="{StaticResource AfSettingsCardGap}">
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="TextAlignJustify24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource AfSettingsCardTitleStyle}" Text="双行歌词" />
                    <TextBlock
                        Style="{StaticResource AfSettingsCardDescriptionStyle}"
                        Text="静置层空间允许时显示下一句或当前句翻译" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch
                IsChecked="{Binding ViewModel.TwoLineLyricsEnabled, Mode=TwoWay}"
                IsEnabled="{Binding ViewModel.CanConfigureTwoLine}" />
        </ui:CardControl>

        <ui:CardControl Margin="{StaticResource AfSettingsCardGap}">
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="TextBulletListSquare24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource AfSettingsCardTitleStyle}" Text="第二行内容" />
                    <TextBlock
                        Style="{StaticResource AfSettingsCardDescriptionStyle}"
                        Text="翻译不存在时不会显示空白占位" />
                </StackPanel>
            </ui:CardControl.Header>
            <ComboBox
                MinWidth="{StaticResource AfSettingsSelectMinWidth}"
                IsEnabled="{Binding ViewModel.CanConfigureSecondary}"
                SelectedValue="{Binding ViewModel.SecondaryLineMode, Mode=TwoWay}"
                SelectedValuePath="Tag">
                <ComboBoxItem Content="下一句歌词" Tag="{x:Static settings:LyricsSecondaryLineMode.NextLine}" />
                <ComboBoxItem Content="当前句翻译" Tag="{x:Static settings:LyricsSecondaryLineMode.Translation}" />
            </ComboBox>
        </ui:CardControl>

        <ui:CardControl Margin="{StaticResource AfSettingsCardGapLast}">
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="TextAlignLeft24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource AfSettingsCardTitleStyle}" Text="文字对齐" />
                    <TextBlock
                        Style="{StaticResource AfSettingsCardDescriptionStyle}"
                        Text="应用于任务栏静置歌词和媒体文字" />
                </StackPanel>
            </ui:CardControl.Header>
            <ComboBox
                MinWidth="{StaticResource AfSettingsSelectMinWidth}"
                SelectedValue="{Binding ViewModel.TextAlignment, Mode=TwoWay}"
                SelectedValuePath="Tag">
                <ComboBoxItem Content="左对齐" Tag="{x:Static settings:LyricsTextAlignment.Left}" />
                <ComboBoxItem Content="居中" Tag="{x:Static settings:LyricsTextAlignment.Center}" />
                <ComboBoxItem Content="右对齐" Tag="{x:Static settings:LyricsTextAlignment.Right}" />
            </ComboBox>
        </ui:CardControl>

        <ui:Button
            Margin="0,18,0,0"
            HorizontalAlignment="Left"
            Click="ResetButton_Click"
            Content="恢复本页默认设置"
            Icon="{ui:SymbolIcon ArrowReset24}"
            Style="{StaticResource AfSettingsButtonStyle}" />
    </StackPanel>
</Page>
