<Page
    x:Class="AFMediaBar.Views.Pages.AppearancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:AFMediaBar.Classes.Converters"
    xmlns:settings="clr-namespace:AFMediaBar.Classes.Settings"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Page.Resources>
        <converters:GenericEnumToBooleanConverter x:Key="EnumToBooleanConverter" />
    </Page.Resources>

    <!--
        全局外观页 / Global appearance page

        每个 RadioButton 的 GroupName、IsChecked、Command 和 CommandParameter 与原来完全一致，只替换外观。
        三处实质变化：
        交互动效卡片里那三条宽度写死、也不会动的“预览”条被移除（它不解释任何东西）；
        当前模式表面改用四张真实表面示意；
        字体预览扩展成 12/14/16/20 的字样，让字重滑杆的调整真的看得见。
        Every RadioButton keeps its GroupName, IsChecked, Command, and CommandParameter; only the appearance
        changes. Three substantive changes: the motion card's three hardcoded, never-moving preview bars are gone
        because they explained nothing; the current-surface group gains four real surface mock-ups; and the font
        preview becomes a 12/14/16/20 specimen so the weight slider has a visible effect.
    -->
    <StackPanel
        x:Name="PageRoot"
        MaxWidth="{StaticResource AfSettingsContentMaxWidth}"
        Margin="{StaticResource AfSettingsPageMargin}"
        Loaded="OnPageLoaded">

        <TextBlock Style="{StaticResource AfSettingsPageTitleStyle}" Text="全局外观" />
        <TextBlock Style="{StaticResource AfSettingsPageSubtitleStyle}" Text="调整字体、文字颜色、窗口材质和当前模式表面" />

        <ContentControl
            Margin="0,0,0,12"
            Content="动效"
            ContentTemplate="{StaticResource AfSettingsSectionHeaderTemplate}" />

        <ui:CardControl Margin="{StaticResource AfSettingsCardGapLast}">
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="ArrowSync24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource AfSettingsCardTitleStyle}" Text="交互动效" />
                    <TextBlock
                        Style="{StaticResource AfSettingsCardDescriptionStyle}"
                        Text="根据系统动画、高对比度和渲染能力自动调整" />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel MinWidth="{StaticResource AfSettingsFieldWidth}">
                <TextBlock
                    FontSize="15"
                    FontWeight="{DynamicResource AppTextStrongFontWeight}"
                    Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                    Text="{Binding ViewModel.MotionModeText}" />
                <TextBlock
                    Margin="0,4,0,0"
                    Style="{StaticResource AfSettingsHintTextStyle}"
                    Text="{Binding ViewModel.MotionDetailText}" />
            </StackPanel>
        </ui:CardControl>

        <ContentControl
            Margin="0,0,0,12"
            Content="字体"
            ContentTemplate="{StaticResource AfSettingsSectionHeaderTemplate}" />

        <ui:CardControl Margin="{StaticResource AfSettingsCardGap}">
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="TextFont24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource AfSettingsCardTitleStyle}" Text="界面字体" />
                    <TextBlock
                        Style="{StaticResource AfSettingsCardDescriptionStyle}"
                        Text="分别选择西文和中文字体" />
                </StackPanel>
            </ui:CardControl.Header>
            <Grid Width="{StaticResource AfSettingsFieldWidth}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox SelectedValue="{Binding ViewModel.LatinFont, Mode=TwoWay}" SelectedValuePath="Tag">
                    <ComboBoxItem Content="Segoe UI" Tag="{x:Static settings:LatinFontPreset.SegoeUi}" />
                    <ComboBoxItem Content="Arial" Tag="{x:Static settings:LatinFontPreset.Arial}" />
                    <ComboBoxItem Content="Calibri" Tag="{x:Static settings:LatinFontPreset.Calibri}" />
                    <ComboBoxItem Content="Verdana" Tag="{x:Static settings:LatinFontPreset.Verdana}" />
                    <ComboBoxItem Content="Consolas" Tag="{x:Static settings:LatinFontPreset.Consolas}" />
                    <ComboBoxItem Content="Times New Roman" Tag="{x:Static settings:LatinFontPreset.TimesNewRoman}" />
                </ComboBox>
                <ComboBox
                    Grid.Column="2"
                    SelectedValue="{Binding ViewModel.CjkFont, Mode=TwoWay}"
                    SelectedValuePath="Tag">
                    <ComboBoxItem Content="跟随系统" Tag="{x:Static settings:CjkFontPreset.SystemDefault}" />
                    <ComboBoxItem Content="微软雅黑" Tag="{x:Static settings:CjkFontPreset.MicrosoftYaHei}" />
                    <ComboBoxItem Content="等线" Tag="{x:Static settings:CjkFontPreset.DengXian}" />
                    <ComboBoxItem Content="宋体" Tag="{x:Static settings:CjkFontPreset.SimSun}" />
                    <ComboBoxItem Content="黑体" Tag="{x:Static settings:CjkFontPreset.SimHei}" />
                    <ComboBoxItem Content="楷体" Tag="{x:Static settings:CjkFontPreset.KaiTi}" />
                    <ComboBoxItem Content="仿宋" Tag="{x:Static settings:CjkFontPreset.FangSong}" />
                </ComboBox>
            </Grid>
        </ui:CardControl>

        <ui:CardControl Margin="{StaticResource AfSettingsCardGap}">
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="TextFontSize24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource AfSettingsCardTitleStyle}" Text="字重" />
                    <TextBlock
                        Style="{StaticResource AfSettingsCardDescriptionStyle}"
                        Text="调整界面文字的粗细" />
                </StackPanel>
            </ui:CardControl.Header>
            <Grid Width="{StaticResource AfSettingsFieldWidth}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Slider
                    IsSnapToTickEnabled="True"
                    Maximum="900"
                    Minimum="300"
                    TickFrequency="50"
                    Value="{Binding ViewModel.FontWeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    Style="{StaticResource AfSettingsFieldValueStyle}"
                    Text="{Binding ViewModel.FontWeight}" />
            </Grid>
        </ui:CardControl>

        <ui:CardControl Margin="{StaticResource AfSettingsCardGapLast}">
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="TextCaseTitle24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource AfSettingsCardTitleStyle}" Text="字体预览" />
                    <TextBlock
                        Style="{StaticResource AfSettingsCardDescriptionStyle}"
                        Text="按四档字号预览当前字体与字重" />
                </StackPanel>
            </ui:CardControl.Header>
            <Grid MinWidth="{StaticResource AfSettingsFieldWidth}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Margin="0,0,12,0"
                    Style="{StaticResource AfSettingsFieldLabelStyle}"
                    Text="20" />
                <TextBlock
                    Grid.Column="1"
                    FontFamily="{DynamicResource AppTextFontFamily}"
                    FontSize="20"
                    FontWeight="{DynamicResource AppTextFontWeight}"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="AF Media Bar" />

                <TextBlock
                    Grid.Row="1"
                    Margin="0,8,12,0"
                    Style="{StaticResource AfSettingsFieldLabelStyle}"
                    Text="16" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="0,8,0,0"
                    FontFamily="{DynamicResource AppTextFontFamily}"
                    FontSize="16"
                    FontWeight="{DynamicResource AppTextFontWeight}"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="你是我的一切 · 君は私のすべて" />

                <TextBlock
                    Grid.Row="2"
                    Margin="0,8,12,0"
                    Style="{StaticResource AfSettingsFieldLabelStyle}"
                    Text="14" />
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="0,8,0,0"
                    FontFamily="{DynamicResource AppTextFontFamily}"
                    FontSize="14"
                    FontWeight="{DynamicResource AppTextFontWeight}"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="You are my everything · 당신은 나의 전부" />

                <TextBlock
                    Grid.Row="3"
                    Margin="0,8,12,0"
                    Style="{StaticResource AfSettingsFieldLabelStyle}"
                    Text="12" />
                <TextBlock
                    Grid.Row="3"
                    Grid.Column="1"
                    Margin="0,8,0,0"
                    FontFamily="{DynamicResource AppTextFontFamily}"
                    FontSize="12"
                    FontWeight="{DynamicResource AppTextFontWeight}"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="You are my everything · 你是我的一切 · 君は私のすべて · 당신은 나의 전부" />
            </Grid>
        </ui:CardControl>

        <ContentControl
            Margin="0,0,0,12"
            Content="播放器文字"
            ContentTemplate="{StaticResource AfSettingsSectionHeaderTemplate}" />

        <ui:CardControl Margin="{StaticResource AfSettingsCardGapLast}">
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="TextColor24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource AfSettingsCardTitleStyle}" Text="文字颜色" />
                    <TextBlock
                        Style="{StaticResource AfSettingsCardDescriptionStyle}"
                        Text="自动模式会根据文字背后的实际颜色切换深浅" />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <RadioButton
                    GroupName="ForegroundMode"
                    IsChecked="{Binding ViewModel.PlayerForegroundMode, Mode=OneWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Automatic}"
                    Command="{Binding ViewModel.SetPlayerForegroundModeCommand}"
                    CommandParameter="{x:Static settings:PlayerForegroundMode.Automatic}"
                    Content="自动（根据背景）"
                    Style="{StaticResource AfSettingsChoiceRadioStyle}" />
                <RadioButton
                    GroupName="ForegroundMode"
                    IsChecked="{Binding ViewModel.PlayerForegroundMode, Mode=OneWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=LightText}"
                    Command="{Binding ViewModel.SetPlayerForegroundModeCommand}"
                    CommandParameter="{x:Static settings:PlayerForegroundMode.LightText}"
                    Content="浅色文字"
                    Style="{StaticResource AfSettingsChoiceRadioStyle}" />
                <RadioButton
                    GroupName="ForegroundMode"
                    IsChecked="{Binding ViewModel.PlayerForegroundMode, Mode=OneWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=DarkText}"
                    Command="{Binding ViewModel.SetPlayerForegroundModeCommand}"
                    CommandParameter="{x:Static settings:PlayerForegroundMode.DarkText}"
                    Content="深色文字"
                    Style="{StaticResource AfSettingsChoiceRadioStyle}" />
            </StackPanel>
        </ui:CardControl>

        <ContentControl
            Margin="0,0,0,12"
            Content="应用主题"
            ContentTemplate="{StaticResource AfSettingsSectionHeaderTemplate}" />

        <ui:CardControl Margin="{StaticResource AfSettingsCardGap}">
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="Color24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource AfSettingsCardTitleStyle}" Text="应用主题" />
                    <TextBlock
                        Style="{StaticResource AfSettingsCardDescriptionStyle}"
                        Text="选择整个程序界面的明暗外观" />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <RadioButton
                    GroupName="ApplicationThemeMode"
                    IsChecked="{Binding ViewModel.ApplicationThemeMode, Mode=OneWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Automatic}"
                    Command="{Binding ViewModel.SetApplicationThemeModeCommand}"
                    CommandParameter="{x:Static settings:ApplicationThemeMode.Automatic}"
                    Content="自动"
                    Style="{StaticResource AfSettingsChoiceRadioStyle}" />
                <RadioButton
                    GroupName="ApplicationThemeMode"
                    IsChecked="{Binding ViewModel.ApplicationThemeMode, Mode=OneWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Light}"
                    Command="{Binding ViewModel.SetApplicationThemeModeCommand}"
                    CommandParameter="{x:Static settings:ApplicationThemeMode.Light}"
                    Content="浅色"
                    Style="{StaticResource AfSettingsChoiceRadioStyle}" />
                <RadioButton
                    GroupName="ApplicationThemeMode"
                    IsChecked="{Binding ViewModel.ApplicationThemeMode, Mode=OneWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Dark}"
                    Command="{Binding ViewModel.SetApplicationThemeModeCommand}"
                    CommandParameter="{x:Static settings:ApplicationThemeMode.Dark}"
                    Content="深色"
                    Style="{StaticResource AfSettingsChoiceRadioStyle}" />
            </StackPanel>
        </ui:CardControl>

        <ui:CardControl Margin="{StaticResource AfSettingsCardGapLast}">
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="WindowConsole20" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource AfSettingsCardTitleStyle}" Text="背景材质" />
                    <TextBlock
                        Style="{StaticResource AfSettingsCardDescriptionStyle}"
                        Text="统一设置窗口、托盘弹窗和右键菜单的背景效果" />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <RadioButton
                    GroupName="BackdropMode"
                    IsChecked="{Binding ViewModel.BackdropMode, Mode=OneWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=FluentSolid}"
                    Command="{Binding ViewModel.SetBackdropModeCommand}"
                    CommandParameter="{x:Static settings:ApplicationBackdropMode.FluentSolid}"
                    Content="Fluent 纯色"
                    Style="{StaticResource AfSettingsChoiceRadioStyle}" />
                <RadioButton
                    GroupName="BackdropMode"
                    IsChecked="{Binding ViewModel.BackdropMode, Mode=OneWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Mica}"
                    Command="{Binding ViewModel.SetBackdropModeCommand}"
                    CommandParameter="{x:Static settings:ApplicationBackdropMode.Mica}"
                    Content="Mica 云母"
                    Style="{StaticResource AfSettingsChoiceRadioStyle}" />
                <RadioButton
                    GroupName="BackdropMode"
                    IsChecked="{Binding ViewModel.BackdropMode, Mode=OneWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Acrylic}"
                    Command="{Binding ViewModel.SetBackdropModeCommand}"
                    CommandParameter="{x:Static settings:ApplicationBackdropMode.Acrylic}"
                    Content="Acrylic 亚克力"
                    Style="{StaticResource AfSettingsChoiceRadioStyle}" />
            </StackPanel>
        </ui:CardControl>

        <ContentControl
            Margin="0,0,0,12"
            Content="当前模式表面"
            ContentTemplate="{StaticResource AfSettingsSectionHeaderTemplate}" />

        <TextBlock
            Margin="0,0,0,10"
            Style="{StaticResource AfSettingsHintTextStyle}"
            Text="任务栏模式当前固定使用透明主体；切换到灵动岛模式后可调整以下表面选项。" />

        <ContentControl
            Margin="0,0,0,12"
            ContentTemplate="{StaticResource AfDiagramSurfacePresets}" />

        <ui:CardControl Margin="{StaticResource AfSettingsCardGap}" Style="{StaticResource AfSettingsCardDisabledStyle}" IsEnabled="{Binding ViewModel.CanCustomizeCurrentSurface}">
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="ColorBackground24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource AfSettingsCardTitleStyle}" Text="{Binding ViewModel.CurrentSurfaceName}" />
                    <TextBlock
                        Style="{StaticResource AfSettingsCardDescriptionStyle}"
                        Text="基础表面风格，不改变组件布局" />
                </StackPanel>
            </ui:CardControl.Header>
            <ComboBox
                HorizontalAlignment="Left"
                MinWidth="{StaticResource AfSettingsSelectMinWidth}"
                SelectedValue="{Binding ViewModel.SurfaceStyle, Mode=TwoWay}"
                SelectedValuePath="Tag">
                <ComboBoxItem Content="自动" Tag="{x:Static settings:PlayerSurfaceStyle.Automatic}" />
                <ComboBoxItem Content="纯色" Tag="{x:Static settings:PlayerSurfaceStyle.Solid}" />
                <ComboBoxItem Content="主题色调" Tag="{x:Static settings:PlayerSurfaceStyle.ThemeTint}" />
            </ComboBox>
        </ui:CardControl>

        <ui:CardControl Margin="{StaticResource AfSettingsCardGap}" Style="{StaticResource AfSettingsCardDisabledStyle}" IsEnabled="{Binding ViewModel.CanCustomizeCurrentSurface}">
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="Eye24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource AfSettingsCardTitleStyle}" Text="背景不透明度" />
                    <TextBlock
                        Style="{StaticResource AfSettingsCardDescriptionStyle}"
                        Text="只调整播放器表面" />
                </StackPanel>
            </ui:CardControl.Header>
            <Grid Width="{StaticResource AfSettingsFieldWidth}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Slider Maximum="100" Minimum="0" Value="{Binding ViewModel.SurfaceOpacityPercent, Mode=TwoWay}" />
                <TextBlock
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    Style="{StaticResource AfSettingsFieldValueStyle}"
                    Text="{Binding ViewModel.SurfaceOpacityPercent, StringFormat={}{0}%}" />
            </Grid>
        </ui:CardControl>

        <ui:CardControl Margin="{StaticResource AfSettingsCardGap}" Style="{StaticResource AfSettingsCardDisabledStyle}" IsEnabled="{Binding ViewModel.CanCustomizeCurrentSurface}">
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="Square24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource AfSettingsCardTitleStyle}" Text="圆角" />
                    <TextBlock
                        Style="{StaticResource AfSettingsCardDescriptionStyle}"
                        Text="0–24 DIP" />
                </StackPanel>
            </ui:CardControl.Header>
            <Grid Width="{StaticResource AfSettingsFieldWidth}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Slider Maximum="24" Minimum="0" Value="{Binding ViewModel.SurfaceCornerRadiusDip, Mode=TwoWay}" />
                <TextBlock
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    Style="{StaticResource AfSettingsFieldValueStyle}"
                    Text="{Binding ViewModel.SurfaceCornerRadiusDip, StringFormat={}{0:0.#}}" />
            </Grid>
        </ui:CardControl>

        <ui:CardControl Margin="0,24,0,0">
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="ArrowReset24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource AfSettingsCardTitleStyle}" Text="恢复本页默认设置" />
                    <TextBlock
                        Style="{StaticResource AfSettingsCardDescriptionStyle}"
                        Text="恢复完整外观设置" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:Button
                Click="ResetButton_Click"
                Content="恢复默认"
                Icon="{ui:SymbolIcon ArrowReset24}"
                Style="{StaticResource AfSettingsButtonStyle}" />
        </ui:CardControl>
    </StackPanel>
</Page>
