<Page
    x:Class="AFMediaBar.Views.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:AFMediaBar.Components"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ScrollViewer.CanContentScroll="False">

    <!--
        应用与关于页 / Application and about page

        它接替了原先独立的“常规”页。那一页只剩三个不可用的预留条目和一个设置文件入口，
        外加一张不解释任何可操作项的生命周期图，单独占一个导航项并不值得。

        结构上的修正：

        1. 三个尚未接入的功能集中到一张卡片里，每一项带一个状态芯片。原先它们是三张各带一个不可用控件的
           独立卡片，读起来像三个坏掉的开关，而不是三条明确的路线图。
        2. 顶部那张“登录 Windows → 自动启动（预留）→ 托盘常驻 → 退出”的流程图被删除：它不解释任何
           当前可操作的设置，只是占掉了页面最好的位置。
        3. 本页没有属于自己的设置，因此只保留“重置全部设置”，并写清它影响什么。

        It replaces the former standalone general page, which had been reduced to three unusable reserved entries,
        one settings-file entry, and a lifecycle diagram that explained nothing actionable. The three
        not-yet-wired features are now one card with a state chip per row rather than three cards each holding a
        dead control, the top-of-page lifecycle flow is gone, and the page offers only a full reset with its scope
        spelled out, because it owns no settings of its own.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <components:SettingsGroupStrip
            Grid.Row="0"
            Margin="{StaticResource AfSettingsHeaderMargin}"
            MaxWidth="{StaticResource AfSettingsContentMaxWidth}"
            PageIcon="{ui:SymbolIcon QuestionCircle24}"
            Subtitle="应用信息、设置文件与支持入口"
            Target="{Binding ElementName=PageScroll}"
            Title="应用与关于" />

        <ScrollViewer
            x:Name="PageScroll"
            Grid.Row="1"
            Margin="{StaticResource AfSettingsScrollMargin}"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                x:Name="PageRoot"
                MaxWidth="{StaticResource AfSettingsContentMaxWidth}"
                Loaded="OnPageLoaded">

                <components:SettingsGroup
                    Header="应用"
                    Icon="{ui:SymbolIcon Info24}"
                    StatusText="均未接入"
                    StatusTone="Neutral">
                    <ui:CardControl Margin="{StaticResource AfSettingsCardGapLast}" Style="{StaticResource AfSettingsCardStackedStyle}">
                        <ui:CardControl.Icon>
                            <ui:SymbolIcon Symbol="Info24" />
                        </ui:CardControl.Icon>
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock Style="{StaticResource AfSettingsCardTitleStyle}" Text="尚未接入的功能" />
                                <TextBlock
                                    Style="{StaticResource AfSettingsCardDescriptionStyle}"
                                    Text="下面三项在当前版本中不可用，列出它们是为了说明计划，而不是让你去点。" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock
                                        FontSize="13"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="开机自动启动" />
                                    <TextBlock
                                        Style="{StaticResource AfSettingsHintTextStyle}"
                                        Text="登录 Windows 后自动运行 AF Media Bar。" />
                                </StackPanel>
                                <ContentControl
                                    Grid.Column="1"
                                    Margin="12,0,0,0"
                                    Content="预留"
                                    Style="{StaticResource AfSettingsChipNeutralStyle}" />
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock
                                        FontSize="13"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="界面语言" />
                                    <TextBlock
                                        Style="{StaticResource AfSettingsHintTextStyle}"
                                        Text="当前版本只有简体中文，没有其它语言资源。" />
                                </StackPanel>
                                <ContentControl
                                    Grid.Column="1"
                                    Margin="12,0,0,0"
                                    Content="仅简体中文"
                                    Style="{StaticResource AfSettingsChipNeutralStyle}" />
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock
                                        FontSize="13"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="检查更新" />
                                    <TextBlock
                                        Style="{StaticResource AfSettingsHintTextStyle}"
                                        Text="本程序不联网检查版本，升级请从发布页获取。" />
                                </StackPanel>
                                <ContentControl
                                    Grid.Column="1"
                                    Margin="12,0,0,0"
                                    Content="尚未接入"
                                    Style="{StaticResource AfSettingsChipNeutralStyle}" />
                            </Grid>
                        </StackPanel>
                    </ui:CardControl>
                </components:SettingsGroup>

                <components:SettingsGroup Header="设置文件" Icon="{ui:SymbolIcon FolderOpen24}">
                    <StackPanel>
                        <ui:CardControl Margin="{StaticResource AfSettingsCardGap}">
                            <ui:CardControl.Icon>
                                <ui:SymbolIcon Symbol="FolderOpen24" />
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource AfSettingsCardTitleStyle}" Text="打开设置文件夹" />
                                    <TextBlock
                                        Style="{StaticResource AfSettingsCardDescriptionStyle}"
                                        Text="settings.json 就在这个文件夹里，可以直接备份或替换。" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:Button
                                Click="OpenSettingsFolder_Click"
                                Content="打开文件夹"
                                Icon="{ui:SymbolIcon FolderOpen24}"
                                Style="{StaticResource AfSettingsButtonStyle}" />
                        </ui:CardControl>

                        <ui:CardControl Margin="{StaticResource AfSettingsCardGapLast}">
                            <ui:CardControl.Icon>
                                <ui:SymbolIcon Symbol="ArrowReset24" />
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource AfSettingsCardTitleStyle}" Text="重置全部设置" />
                                    <TextBlock
                                        Style="{StaticResource AfSettingsCardDescriptionStyle}"
                                        Text="显示模式、交互、歌词、外观、媒体与通知全部回到默认值。此操作无法撤销。" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:Button
                                Click="ResetAllButton_Click"
                                Content="重置全部设置"
                                Icon="{ui:SymbolIcon ArrowReset24}"
                                Style="{StaticResource AfSettingsButtonStyle}" />
                        </ui:CardControl>
                    </StackPanel>
                </components:SettingsGroup>

                <components:SettingsGroup Header="项目信息" Icon="{ui:SymbolIcon Heart24}">
                    <ui:CardControl Margin="{StaticResource AfSettingsCardGapLast}" Style="{StaticResource AfSettingsCardStackedStyle}">
                        <ui:CardControl.Icon>
                            <ui:SymbolIcon Symbol="Info24" />
                        </ui:CardControl.Icon>
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock
                                    FontSize="14"
                                    Style="{StaticResource AfSettingsCardTitleStyle}"
                                    Text="AF Media Bar" />
                                <TextBlock
                                    Style="{StaticResource AfSettingsCardDescriptionStyle}"
                                    Text="Windows 任务栏媒体体验 · 版本 1.0.0" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <WrapPanel>
                            <ui:Anchor
                                Margin="0,0,10,0"
                                Content="在 GitHub 点 Star"
                                Icon="{ui:SymbolIcon Star24}"
                                NavigateUri="https://github.com/Fervent-Tempo/AF-Media-Bar" />
                            <ui:Anchor
                                Content="问题反馈"
                                Icon="{ui:SymbolIcon Bug24}"
                                NavigateUri="https://github.com/Fervent-Tempo/AF-Media-Bar/issues" />
                        </WrapPanel>
                    </ui:CardControl>
                </components:SettingsGroup>

                <components:SettingsGroup Header="赞助支持" Icon="{ui:SymbolIcon Heart24}">
                    <ui:CardControl Margin="{StaticResource AfSettingsCardGapLast}">
                        <ui:CardControl.Icon>
                            <ui:SymbolIcon Symbol="Heart24" />
                        </ui:CardControl.Icon>
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock Style="{StaticResource AfSettingsCardTitleStyle}" Text="暂无赞助者" />
                                <TextBlock
                                    Style="{StaticResource AfSettingsCardDescriptionStyle}"
                                    Text="赞助目录随版本发布，不会在后台联网读取。" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <TextBlock
                            Style="{StaticResource AfSettingsHintTextStyle}"
                            Text="成为第一位支持者" />
                    </ui:CardControl>
                </components:SettingsGroup>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
