<Page
    x:Class="AFMediaBar.Views.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:AFMediaBar.Components"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ScrollViewer.CanContentScroll="False">

    <!--
        应用与关于页 / Application and about page

        它接替了原先独立的「常规」页：那一页只剩三个不可用的预留条目和一个设置文件入口，
        外加一张不解释任何可操作项的生命周期图，单独占一个导航项并不值得。

        尚未接入的三项各占一行，行标题右侧带内联徽章说明状态，控件本身就是禁用的那一个。
        这比把三项塞进一张卡片、或让三个死控件孤零零地排着，都更清楚地表达「这是路线图，不是开关」。
        It replaces the former standalone general page, which had been reduced to three unusable reserved entries,
        one settings-file entry, and a lifecycle diagram that explained nothing actionable.

        Each not-yet-wired feature owns one row, with an inline badge stating its state on the title line and the
        disabled control in the control slot. That says "this is a roadmap, not a switch" far more clearly than
        burying three rows in one card or leaving three dead controls standing alone.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <components:SettingsGroupStrip
            Grid.Row="0"
            Margin="{StaticResource AfSettingsHeaderMargin}"
            MaxWidth="{StaticResource AfSettingsContentMaxWidth}"
            PageIcon="{ui:SymbolIcon QuestionCircle24}"
            Subtitle="应用信息、设置文件与支持入口"
            Target="{Binding ElementName=PageScroll}"
            Title="应用与关于" />

        <ScrollViewer
            x:Name="PageScroll"
            Grid.Row="1"
            Margin="{StaticResource AfSettingsScrollMargin}"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                x:Name="PageRoot"
                MaxWidth="{StaticResource AfSettingsContentMaxWidth}"
                Loaded="OnPageLoaded">

                <components:SettingsGroup
                    Header="应用"
                    Icon="{ui:SymbolIcon Info24}"
                    StatusText="均未接入"
                    StatusTone="Neutral">
                    <StackPanel>
                        <components:SettingsCallout
                            Margin="0,0,0,12"
                            IsAccent="False"
                            Symbol="Info24"
                            Text="下面三项在当前版本中尚未接入，此处仅说明计划。" />

                        <components:SettingsRow
                            Badge="预留"
                            Description="登录 Windows 后自动运行 AF Media Bar"
                            Icon="{ui:SymbolIcon ShareScreenStart24}"
                            Title="开机自动启动">
                            <ui:ToggleSwitch IsEnabled="False" />
                        </components:SettingsRow>

                        <components:SettingsRow
                            Badge="仅简体中文"
                            Description="目前仅提供简体中文"
                            Icon="{ui:SymbolIcon Globe24}"
                            Title="界面语言">
                            <ComboBox IsEnabled="False" MinWidth="140" SelectedIndex="0">
                                <ComboBoxItem Content="简体中文" />
                            </ComboBox>
                        </components:SettingsRow>

                        <components:SettingsRow
                            Badge="尚未接入"
                            Description="本程序不联网检查版本，升级请从发布页获取"
                            Icon="{ui:SymbolIcon ArrowSync24}"
                            Title="检查更新">
                            <ui:Button
                                Content="检查更新"
                                IsEnabled="False"
                                Style="{StaticResource AfSettingsButtonStyle}" />
                        </components:SettingsRow>
                    </StackPanel>
                </components:SettingsGroup>

                <components:SettingsGroup Header="设置文件" Icon="{ui:SymbolIcon FolderOpen24}">
                    <StackPanel>
                        <components:SettingsRow
                            Description="打开 settings.json 所在文件夹，可直接备份或替换"
                            Icon="{ui:SymbolIcon FolderOpen24}"
                            Title="打开设置文件夹">
                            <ui:Button
                                Click="OpenSettingsFolder_Click"
                                Content="打开文件夹"
                                Icon="{ui:SymbolIcon FolderOpen24}"
                                Style="{StaticResource AfSettingsButtonStyle}" />
                        </components:SettingsRow>

                        <components:SettingsRow
                            Description="显示模式、交互、歌词、外观与媒体通知全部恢复默认值"
                            Icon="{ui:SymbolIcon ArrowReset24}"
                            Title="重置全部设置">
                            <ui:Button
                                Click="ResetAllButton_Click"
                                Content="重置全部"
                                Icon="{ui:SymbolIcon ArrowReset24}"
                                Style="{StaticResource AfSettingsButtonStyle}" />
                        </components:SettingsRow>
                    </StackPanel>
                </components:SettingsGroup>

                <components:SettingsGroup Header="项目信息" Icon="{ui:SymbolIcon Info24}">
                    <components:SettingsRow
                        Description="Windows 任务栏媒体体验 · 版本 1.0.0"
                        Icon="{ui:SymbolIcon Info24}"
                        Title="AF Media Bar">
                        <WrapPanel>
                            <ui:Anchor
                                Margin="0,0,10,0"
                                Content="在 GitHub 点 Star"
                                Icon="{ui:SymbolIcon Star24}"
                                NavigateUri="https://github.com/Fervent-Tempo/AF-Media-Bar" />
                            <ui:Anchor
                                Content="问题反馈"
                                Icon="{ui:SymbolIcon Bug24}"
                                NavigateUri="https://github.com/Fervent-Tempo/AF-Media-Bar/issues" />
                        </WrapPanel>
                    </components:SettingsRow>
                </components:SettingsGroup>

                <components:SettingsGroup Header="赞助支持" Icon="{ui:SymbolIcon Heart24}">
                    <components:SettingsRow
                        Description="赞助名单随版本发布，不会联网读取"
                        Icon="{ui:SymbolIcon Heart24}"
                        Title="暂无赞助者">
                        <TextBlock
                            Style="{StaticResource AfSettingsRowValueStyle}"
                            Text="成为第一位支持者" />
                    </components:SettingsRow>
                </components:SettingsGroup>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
