<ui:FluentWindow x:Class="AFMediaBar.Views.Windows.TaskbarCompactFlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="任务栏快捷菜单"
        MinWidth="0"
        SizeToContent="Height"
        MaxHeight="440"
        ShowInTaskbar="False"
        Topmost="True"
        WindowCornerPreference="Round"
        ExtendsContentIntoTitleBar="True"
        FontFamily="{DynamicResource AppTextFontFamily}"
        FontWeight="{DynamicResource AppTextFontWeight}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        Background="Transparent"
        Deactivated="Window_OnDeactivated"
        PreviewKeyDown="Window_OnPreviewKeyDown">
    <Border x:Name="FlyoutRoot" Margin="4" Padding="10" CornerRadius="8"
            Background="Transparent"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            Effect="{DynamicResource AfFlyoutShadowEffect}">
        <Border.RenderTransformOrigin>0.5,1</Border.RenderTransformOrigin>
        <Border.RenderTransform>
            <ScaleTransform x:Name="FlyoutScale" ScaleX="1" ScaleY="1" />
        </Border.RenderTransform>
        <Grid>
            <StackPanel x:Name="QuickLaunchPanel" Visibility="Collapsed">
                <TextBlock Text="快速启动" FontSize="16" FontWeight="{DynamicResource AppTextStrongFontWeight}" Margin="0,0,0,8"/>
                <TextBlock x:Name="QuickLaunchStatusText" FontSize="12" Margin="0,0,0,6"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Visibility="Collapsed"/>
                <TextBlock x:Name="QuickLaunchEmptyText" Text="尚未添加应用" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <ScrollViewer x:Name="QuickLaunchScrollViewer" MaxHeight="280"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="QuickLaunchList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Height="34" Padding="8,4" Margin="0,1" HorizontalContentAlignment="Left"
                                        BorderThickness="0" Background="Transparent" Click="QuickLaunchItem_Click">
                                    <TextBlock Text="{Binding DisplayName}" MaxWidth="270" TextTrimming="CharacterEllipsis"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>

            <StackPanel x:Name="OutputDevicePanel" Visibility="Collapsed">
                <TextBlock Text="输出设备" FontSize="16" FontWeight="{DynamicResource AppTextStrongFontWeight}" Margin="0,0,0,8"/>
                <ComboBox x:Name="OutputDeviceComboBox" MinHeight="32" MaxDropDownHeight="240"
                          DisplayMemberPath="DisplayName" SelectionChanged="OutputDeviceComboBox_SelectionChanged"
                          DropDownOpened="OutputDeviceComboBox_DropDownOpened"
                          DropDownClosed="OutputDeviceComboBox_DropDownClosed"
                          PreviewMouseWheel="OutputDeviceComboBox_PreviewMouseWheel"/>
            </StackPanel>

            <StackPanel x:Name="VolumePanel" Visibility="Collapsed">
                <TextBlock Text="当前媒体音量" FontSize="16" FontWeight="{DynamicResource AppTextStrongFontWeight}" Margin="0,0,0,8"/>
                <Grid Height="38">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="82"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="42"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="VolumeSourceText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" SmallChange="2" LargeChange="10"
                            Margin="4,0,8,0" IsMoveToPointEnabled="True" VerticalAlignment="Center"
                            ValueChanged="VolumeSlider_ValueChanged" PreviewMouseWheel="VolumeSlider_PreviewMouseWheel"/>
                    <TextBlock x:Name="VolumePercentText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</ui:FluentWindow>
