<ui:FluentWindow
    x:Class="AFMediaBar.Views.Windows.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:AFMediaBar.Views.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"

    xmlns:pages="clr-namespace:AFMediaBar.Views.Pages"
    Title="{Binding ViewModel.ApplicationTitle, Mode=OneWay}"
    Width="1100"
    Height="650"
    d:DataContext="{d:DesignInstance local:SettingsWindow,
                                     IsDesignTimeCreatable=True}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ExtendsContentIntoTitleBar="True"
    FontFamily="{DynamicResource AppTextFontFamily}"
    FontWeight="{DynamicResource AppTextFontWeight}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Background="Transparent"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <ui:FluentWindow.InputBindings>
        <KeyBinding
            Key="F"
            Command="{Binding ElementName=AutoSuggestBox, Path=FocusCommand}"
            Modifiers="Control" />
    </ui:FluentWindow.InputBindings>
    <Grid>
        <ui:TitleBar
            x:Name="TitleBar"
            Title="{Binding ViewModel.ApplicationTitle}"
            Grid.Row="0"
            CloseWindowByDoubleClickOnIcon="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/wpfui-icon-256.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>
        <ui:NavigationView
            x:Name="RootNavigation"
            Background="Transparent"
            FrameMargin="0"
            IsBackButtonVisible="Visible"
            IsPaneToggleVisible="true"
            PaneDisplayMode="Left"
            IsFooterSeparatorVisible="false"
            OpenPaneLength="240"
            TransitionDuration="180"
            TitleBar="{Binding ElementName=TitleBar, Mode=OneWay}">
            <!--
                侧栏标识块：以前侧栏只有一串导航项，没有任何应用身份。
                该块位于汉堡按钮与搜索框之间，不占用任何导航项，也不改变导航行为。
                Pane identity block: the pane previously held nothing but navigation items. This sits between the
                hamburger and the search box, consumes no navigation item, and changes no navigation behaviour.
            -->
            <ui:NavigationView.PaneHeader>
                <StackPanel Margin="0,2,0,10">
                    <StackPanel Orientation="Horizontal">
                        <ui:ImageIcon
                            Width="20"
                            Height="20"
                            Source="pack://application:,,,/Assets/wpfui-icon-256.png" />
                        <TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            FontWeight="{DynamicResource AppTextStrongFontWeight}"
                            Text="{Binding ViewModel.ApplicationTitle}" />
                    </StackPanel>
                    <TextBlock
                        Margin="30,3,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="设置" />
                </StackPanel>
            </ui:NavigationView.PaneHeader>
            <ui:NavigationView.AutoSuggestBox>
                <ui:AutoSuggestBox x:Name="AutoSuggestBox" PlaceholderText="搜索设置项">
                    <ui:AutoSuggestBox.Icon>
                        <ui:IconSourceElement>
                            <ui:SymbolIconSource Symbol="Search24" />
                        </ui:IconSourceElement>
                    </ui:AutoSuggestBox.Icon>
                </ui:AutoSuggestBox>
            </ui:NavigationView.AutoSuggestBox>

            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="常规" Icon="{ui:SymbolIcon Home24}"
                                       TargetPageType="{x:Type pages:GeneralPage}" />
                <ui:NavigationViewItem Content="显示模式" Icon="{ui:SymbolIcon Desktop24}"
                                       TargetPageType="{x:Type pages:DisplayModesPage}" />
                <!-- 额外功能和关于以前共用 Info24，全局外观的 Color16 又是唯一 16px 图标，光学尺寸与其余 24px 图标不一致。 -->
                <!-- Extra features and About shared Info24, and Color16 was the only 16px glyph among 24px icons. -->
                <ui:NavigationViewItem Content="额外功能" Icon="{ui:SymbolIcon PuzzlePiece24}"
                                       TargetPageType="{x:Type pages:ExtraFeaturesPage}" />
                <ui:NavigationViewItem Content="交互" Icon="{ui:SymbolIcon HandDraw24}"
                                       TargetPageType="{x:Type pages:InteractionPage}" />
                <ui:NavigationViewItem Content="歌词" Icon="{ui:SymbolIcon TextQuote24}"
                                       TargetPageType="{x:Type pages:LyricsPage}" />
                <ui:NavigationViewItem Content="全局外观"
                                       Icon="{ui:SymbolIcon PaintBrush24}"
                                       TargetPageType="{x:Type pages:AppearancePage}" />
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="关于" Icon="{ui:SymbolIcon QuestionCircle24}"
                                       TargetPageType="{x:Type pages:AboutPage}" />
            </ui:NavigationView.FooterMenuItems>

            <ui:NavigationView.ContentOverlay>
                <Grid>
                    <ui:SnackbarPresenter x:Name="SnackbarPresenter" />
                </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>
        <ui:ContentDialogHost x:Name="RootContentDialog" Grid.Row="0" />
    </Grid>
</ui:FluentWindow>
